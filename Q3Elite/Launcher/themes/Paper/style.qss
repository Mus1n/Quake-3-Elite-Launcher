QPushButton#serverCarouselButton {
    background: #FFFFFF;
    color: #090909;
    border: 1px solid rgba(0,0,0,70);
    border-radius: {{radius.md}}px;
}
QPushButton#serverCarouselButton:hover {
    background: #EEEDE8;
    color: #090909;
    border-color: rgba(0,0,0,110);
}

/* Fixed/floating action bars use normal paper, never inherit the cyan content insert. */
QWidget#settingsFooterWrap,
QWidget#matchmakingIntroWrap {
    background: transparent;
}


/* =====================================================================
   V21 FINAL AUTHORITY — WHITE PAPER CHANGELOG
   Restore the original cyan rounded Telegram insert.  The collapsible body
   itself stays transparent/paper; only the Telegram/Q3News insert is cyan.
   ===================================================================== */

QWidget#changelogCardBody {
    background: transparent;
    border: none;
}

QFrame#changelogWebBackdrop {
    background: {{changelog.web_bg}};
    color: {{changelog.web_text}};
    border: 1px solid #C4EAF2;
    border-radius: {{radius.lg}}px;
}

QWebEngineView#telegramTextView {
    background: {{changelog.web_bg}};
    color: {{changelog.web_text}};
    border: none;
    border-radius: {{radius.lg}}px;
}

QTextBrowser#changelogSelectableText {
    background: {{changelog.web_bg}};
    color: {{changelog.web_text}};
    border: 1px solid #C4EAF2;
    border-radius: {{radius.lg}}px;
    padding: 8px;
}

QPushButton#changelogLinkButton {
    background: #FFFFFF;
    color: #090909;
    border: 1px solid rgba(0,0,0,75);
}
QPushButton#changelogLinkButton:hover {
    background: #EEEDE8;
    color: #090909;
    border-color: rgba(0,0,0,105);
}


/* V22.3 compatibility: dark-only material backdrops remain neutral in paper. */
QFrame#changelogWebBackdrop {
    border-radius: {{radius.lg}}px;
}
