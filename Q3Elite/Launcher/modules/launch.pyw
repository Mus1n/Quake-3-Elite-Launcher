            # 100-130 ms even when the player had not changed a single setting.
            # Track real editor changes and rebuild only when there are staged edits
            # to discard, preserving the existing SAVE RULE behavior.
            self._matchmaking_edit_dirty = False

            # Controls are connected as they are created (including dynamic
            # map/player rows and server MaterialCheckBoxes). No recursive
            # QWidget.findChildren scan is needed after the build.
            _mm_dirty_bound_count = len(getattr(self, "_matchmaking_dirty_bound_ids", ()))
            _mm_profile_mark(
                "dirty_signal_binding", widgets=_mm_dirty_bound_count,
                scan_ms=0.0, registration="incremental",
            )

            self._update_matchmaking_status_ui()
            if _mm_profile_enabled:
                self._q3_write_section_profile(
                    "matchmaking_rebuild", "matchmaking",
                    rebuild_ms=(time.perf_counter() - _matchmaking_rebuild_started) * 1000.0,
                    rules=len(self.matchmakingRules),
                )

        if not _mm_profile_enabled:
            for _index, _rule in enumerate(self.matchmakingRules):
                for _step in _build_rule_steps(_index, _rule):
                    pass
            _finish_matchmaking_build()
            return

        def _build_rule_at(index):
            if _build_generation != getattr(self, "_matchmaking_build_generation", -1):
                return
            if index >= len(self.matchmakingRules):
                _finish_matchmaking_build()
                return
            rule = self.matchmakingRules[index]
            stepper = _build_rule_steps(index, rule)

            def _advance_rule_step():
                if _build_generation != getattr(self, "_matchmaking_build_generation", -1):
                    return
                # The old scheduler queued one Qt timer for every generator
                # yield (roughly 12-14 turns per rule). That kept each turn
                # short, but added substantial event-loop/scheduling overhead.
                # Process several small steps per turn and yield near 8 ms.
                # A single expensive step can still exceed the budget, exactly
                # as it could before; no individual step is made more blocking.
                _turn_started = time.perf_counter()
                while True:
                    if _build_generation != getattr(self, "_matchmaking_build_generation", -1):
                        return
                    _step_started = time.perf_counter()
                    try:
                        step_name = next(stepper)
                    except StopIteration:
                        QtCore.QTimer.singleShot(0, lambda _next=index + 1: _build_rule_at(_next))
                        return
                    _chunk_ms = (time.perf_counter() - _step_started) * 1000.0
                    if _mm_profile_enabled:
                        self._q3_write_section_profile(
                            "matchmaking_build_chunk", "matchmaking",
                            rule=index + 1, step=step_name, chunk_ms=_chunk_ms,
                        )
                    if (time.perf_counter() - _turn_started) * 1000.0 >= 8.0:
                        QtCore.QTimer.singleShot(0, _advance_rule_step)
                        return

            _advance_rule_step()

        QtCore.QTimer.singleShot(0, lambda: _build_rule_at(0))

    def add_matchmaking_rule(self):
        number = len(self.matchmakingRules) + 1
        self.matchmakingRules.append({"id":uuid.uuid4().hex,"alias":f"Rule #{number}","active":False,"servers":[],"server_mode":"or","min_enabled":True,"min_players":3,"max_enabled":True,"max_players":6,"map_enabled":False,"map_operator":"eq","map_name":"","player_conditions":[],"color":"#3b82f6","sound":True})
        self._save_matchmaking_rules(); self._rebuild_matchmaking_rules()

    def delete_matchmaking_rule(self, index):
        if 0 <= index < len(self.matchmakingRules):
            self.matchmakingRules.pop(index); self._save_matchmaking_rules(); self._rebuild_matchmaking_rules(); self.refresh_matchmaking()

    def save_matchmaking_rule(self, index):
        if not (0 <= index < len(self.matchmakingRules)):
            return
        e = self.matchmakingEditors[index]
        old = self.matchmakingRules[index]
        checks = e["checks"]
        if isinstance(checks, QtWidgets.QListWidget):
            selected_servers = [
                int(checks.item(i).data(QtCore.Qt.ItemDataRole.UserRole))
                for i in range(checks.count())
                if checks.item(i).checkState() == QtCore.Qt.CheckState.Checked
                and checks.item(i).data(QtCore.Qt.ItemDataRole.UserRole) is not None
            ]
        else:
            # Preserve the original Paper Theme checkbox representation.
            selected_servers = [
                int(box.property("serverNumber"))
                for box in checks if box.isChecked()
            ]
        self.matchmakingRules[index] = {
            "id": old.get("id") or uuid.uuid4().hex,
            "alias": e["alias"].text().strip() or f"Rule #{index+1}",
            "active": e["active"].isChecked(),
            "servers": selected_servers,
            "server_mode": e["server_mode"].currentData(),
            "min_enabled": e["min_on"].isChecked(),
            "min_players": e["min"].value(),
            "max_enabled": e["max_on"].isChecked(),
            "max_players": e["max"].value(),
            "map_conditions": [
                {"enabled": r["enabled"].isChecked(),
                 "operator": r["op"].currentData(),
                 "name": r["text"].text().strip()}
                for r in e["map_rows"]
            ],
            "player_conditions": [
                {"enabled": r["enabled"].isChecked(),
                 "operator": r["op"].currentData(),
                 "name": r["text"].text().strip()}
                for r in e["player_rows"]
            ],
            "color": e["color"].currentData(),
            "sound": e["sound"].isChecked(),
        }
        self._save_matchmaking_rules()
        self.matchmakingRuleStates[self.matchmakingRules[index]["id"]] = False
        self._update_matchmaking_status_ui()
        self.refresh_matchmaking()

    def refresh_matchmaking(self):
        if self._matchmaking_paused_for_game():
            if not getattr(self, "_matchmakingPauseLogged", False):
                print("[matchmaking] Search paused while Quake is running (Settings option is enabled).")
                self._matchmakingPauseLogged = True
            self._update_matchmaking_status_ui()
            return
        self._matchmakingPauseLogged = False
        active = [r for r in self.matchmakingRules if r.get("active") and r.get("servers")]
        if not active or (self.matchmakingWorker is not None and self.matchmakingWorker.isRunning()):
            if not active: self._update_matchmaking_status_ui()
            return
        servers = self._matchmaking_servers()
        needed = sorted({int(n) for r in active for n in r.get("servers", []) if 1 <= int(n) <= len(servers)})
        selected = []
        self._matchmakingWorkerNumbers = needed
        for n in needed: selected.append(dict(servers[n-1]))
        if not selected: return
        self.matchmakingWorker = ServerQueryWorker(selected, self)
        self.matchmakingWorker.serverReady.connect(self._matchmaking_result_ready)
        self.matchmakingWorker.batchFinished.connect(self._matchmaking_refresh_finished)
        self.matchmakingWorker.start()

    def _matchmaking_result_ready(self, index, result):
        if 0 <= index < len(getattr(self, "_matchmakingWorkerNumbers", [])):
            self.matchmakingResults[self._matchmakingWorkerNumbers[index]] = result

    def _matchmaking_refresh_finished(self):
        self._evaluate_matchmaking_rules()

    def _rule_matches(self, rule):
        selected = [int(n) for n in rule.get("servers", [])]
        if not selected:
            return False

        def server_matches(number):
            result = self.matchmakingResults.get(number)
            if not result or not result.get("online"):
                return False
            conditions = []
            count = int(result.get("clients", 0) or 0)
            if rule.get("min_enabled", True):
                conditions.append(count > int(rule.get("min_players", 3)))
            if rule.get("max_enabled", True):
                conditions.append(count < int(rule.get("max_players", 6)))

            actual_map = str(result.get("mapname", "")).casefold().strip()
            map_conditions = rule.get("map_conditions", [])
            # Compatibility with v3 single-map rules.
            if not map_conditions and rule.get("map_enabled", False):
                map_conditions = [{"enabled": True, "operator": rule.get("map_operator", "eq"), "name": rule.get("map_name", "")}]
            for mc in map_conditions:
                if not isinstance(mc, dict) or not mc.get("enabled", True):
                    continue
                wanted = str(mc.get("name", "")).casefold().strip()
                if not wanted:
                    conditions.append(False)
                    continue
                equal = actual_map == wanted
                conditions.append(equal if mc.get("operator", "eq") == "eq" else not equal)

            players = [_q3_plain_ascii(p.get("name", "")).casefold().strip() for p in (result.get("players", []) or [])]
            player_conditions = rule.get("player_conditions", [])
            # Compatibility with v1 text rules.
            if not player_conditions and rule.get("type") == "text" and rule.get("text"):
                player_conditions = [{"enabled": True, "operator": "eq", "name": rule.get("text", "")}]
            for pc in player_conditions:
                if not isinstance(pc, dict) or not pc.get("enabled", True):
                    continue
                wanted = _q3_plain_ascii(pc.get("name", "")).casefold().strip()
                if not wanted:
                    conditions.append(False)
                    continue
                present = any(name == wanted for name in players)
                conditions.append(present if pc.get("operator", "eq") == "eq" else not present)

            # All enabled arguments inside a single rule/server are ANDed.
            return bool(conditions) and all(conditions)

        states = [server_matches(number) for number in selected]
        if str(rule.get("server_mode", "or")).lower() == "and":
            return bool(states) and all(states)
        return any(states)

    def _evaluate_matchmaking_rules(self):
        for rule in self.matchmakingRules:
            rid = rule.get("id") or str(id(rule))
            matched = bool(rule.get("active")) and self._rule_matches(rule)
            previous = self.matchmakingRuleStates.get(rid, False)
            self.matchmakingRuleStates[rid] = matched
            if matched and not previous:
                alias = rule.get("alias") or f"Rule #{i + 1}"
                print(f"[matchmaking] Rule matched: {alias}")
                if not launcher_settings.get("disable_matchmaking_popup", False):
                    self._show_matchmaking_notification(rule)
                if rule.get("sound", True):
                    suppress = launcher_settings.get("suppress_startup_notification_sound", True) and (time.monotonic() - self.matchmakingStartedAt < 60)
                    if not suppress:
                        self._play_matchmaking_sound()
        self._update_matchmaking_status_ui()

    def _show_matchmaking_notification(self, rule):
        """Show a high-contrast in-app alert that remains visible in dark mode."""
        try:
            accent = QtGui.QColor(str(rule.get("color", "#55b8ff")))
            if not accent.isValid():
                accent = QtGui.QColor("#55b8ff")
            toast = getattr(self, "_matchmakingToast", None)
            if toast is None:
                toast = QtWidgets.QFrame(self)
                toast.setObjectName("matchmakingAlertToast")
                toast.setAttribute(QtCore.Qt.WidgetAttribute.WA_StyledBackground, True)
                toast.setFixedWidth(350)
                layout = QtWidgets.QVBoxLayout(toast)
                layout.setContentsMargins(15, 11, 15, 12)
                layout.setSpacing(3)
                toast.title = QtWidgets.QLabel("MATCH FOUND")
                toast.title.setStyleSheet("color: #cbd5df; font-size: 10px; font-weight: 700; letter-spacing: 1px;")
                layout.addWidget(toast.title)
                toast.name = QtWidgets.QLabel()
                toast.name.setWordWrap(True)
                toast.name.setStyleSheet("color: #f1f4f7; font-size: 15px; font-weight: 700;")
                layout.addWidget(toast.name)
                toast.detail = QtWidgets.QLabel("Open Matchmaking to view the matching rule.")
                toast.detail.setStyleSheet("color: #b4bec8; font-size: 11px;")
                layout.addWidget(toast.detail)
                self._matchmakingToast = toast
                self._matchmakingToastTimer = QtCore.QTimer(self)
                self._matchmakingToastTimer.setSingleShot(True)
                self._matchmakingToastTimer.timeout.connect(toast.hide)
            toast.name.setText(str(rule.get("alias") or "A matchmaking rule matched"))
            toast.setStyleSheet(
                "QFrame#matchmakingAlertToast { background-color: rgba(20, 24, 30, 248);"
                f"border: 1px solid {accent.name()}; border-radius: 10px; }}"
            )
            toast.adjustSize()
            toast.move(max(16, self.width() - toast.width() - 24), max(16, self.height() - toast.height() - 30))
            toast.raise_()
            toast.show()
            self._matchmakingToastTimer.start(7000)
        except Exception as error:
            print(f"[matchmaking] Could not show alert: {error}")

    def _badge_icon(self, colors):
        """Render up to three simultaneous rule badges in the sidebar icon."""
        colors = list(colors)[:3]
        pix = QtGui.QPixmap(24, 18)
        pix.fill(QtCore.Qt.GlobalColor.transparent)
        painter = QtGui.QPainter(pix)
        painter.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing)
        positions = {1: [12], 2: [8, 16], 3: [5, 12, 19]}.get(len(colors), [])
        for x, color in zip(positions, colors):
            painter.setBrush(QtGui.QColor(color))
            painter.setPen(QtGui.QPen(QtGui.QColor("#e8edf2"), 1.1))
            painter.drawEllipse(QtCore.QPointF(x, 9), 4.0, 4.0)
        painter.end()
        return QtGui.QIcon(pix)

    def _update_matchmaking_status_ui(self):
        matches = []
        paused = self._matchmaking_paused_for_game()
        for i, rule in enumerate(self.matchmakingRules):
            rid = rule.get("id") or str(id(rule))
            if self.matchmakingRuleStates.get(rid, False):
                matches.append((i, rule))
        badges_hidden = time.monotonic() < getattr(self, "matchmakingBadgesHiddenUntil", 0.0)
        if matches and not badges_hidden:
            visible = matches[:3]
            dots = getattr(self, "matchmakingAlertDots", [])
            dot_size, dot_gap = 8, 3
            visible_count = min(len(dots), len(visible))
            # Center the *visible* group, not the three-dot maximum slot.
            # This keeps one, two, and three alerts centered in the round nav.
            total_w = visible_count * dot_size + max(0, visible_count - 1) * dot_gap
            start_x = max(0, (self.matchmakingNav.width() - total_w) // 2)
            y = max(0, self.matchmakingNav.height() - dot_size - 5)
            visible_index = 0
            for index, dot in enumerate(dots):
                if index < visible_count:
                    dot.move(start_x + visible_index * (dot_size + dot_gap), y)
                    accent = QtGui.QColor(str(visible[index][1].get("color", "#3b82f6")))
                    if not accent.isValid():
                        accent = QtGui.QColor("#3b82f6")
                    dot.setStyleSheet(f"background-color: {accent.name()}; border: none; border-radius: 4px;")
                    dot.show()
                    dot.raise_()
                    visible_index += 1
                else:
                    dot.hide()
            aliases = [r.get("alias") or f"Rule #{i+1}" for i, r in matches]
            extra = len(matches) - len(visible)
            tip = "Matched: " + ", ".join(aliases[:3])
            if extra > 0:
                tip += f" (+{extra} more)"
            self.matchmakingNav.setToolTip(tip)
        else:
            for dot in getattr(self, "matchmakingAlertDots", []):
                dot.hide()
            self.matchmakingNav.setToolTip("")
        for i, e in enumerate(getattr(self, "matchmakingEditors", [])):
            rule = self.matchmakingRules[i]
            rid = rule.get("id") or str(id(rule))
            matched = self.matchmakingRuleStates.get(rid, False)
            e["status"].setText("PAUSED • GAME RUNNING" if paused else "MATCHED" if matched else "NOT MATCHED")
            e["status"].setProperty("matched", bool(matched))
            if matched:
                accent = QtGui.QColor(str(rule.get("color", "#55b8ff")))
                e["status"].setStyleSheet(f"color: {accent.name() if accent.isValid() else '#55b8ff'}; font-weight: 700;")
            else:
                e["status"].setStyleSheet("color: #aab3bd; font-weight: 600;")
            e["status"].style().unpolish(e["status"])
            e["status"].style().polish(e["status"])

