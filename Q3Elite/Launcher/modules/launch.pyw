    @staticmethod
    def _account_provider_text(snapshot):
        provider_names = {
            "discord": "Discord",
            "google": "Google",
            "telegram": "Telegram",
            "custom:telegram": "Telegram",
            "email": "Email / Password",
        }
        active = str(snapshot.get("provider") or "").strip().lower()
        providers = [str(x or "").strip().lower() for x in (snapshot.get("providers") or []) if str(x or "").strip()]
        ordered = []
        if active:
            ordered.append(active)
        for provider in providers:
            if provider not in ordered:
                ordered.append(provider)
        if not ordered:
            return "Q3Elite Cloud"
        return " + ".join(provider_names.get(x, x.title()) for x in ordered)

    @staticmethod
    def _account_date_text(value):
        raw = str(value or "").strip()
        if not raw:
            return "—"
        # Use Qt's local-time conversion because this is the same timezone source
        # used by the Windows GUI process. It avoids showing UTC timestamps when
        # Python inherits an unexpected process timezone.
        for fmt in (QtCore.Qt.DateFormat.ISODateWithMs, QtCore.Qt.DateFormat.ISODate):
            dt = QtCore.QDateTime.fromString(raw, fmt)
            if dt.isValid():
                return dt.toLocalTime().toString("yyyy-MM-dd HH:mm")
        try:
            dt = datetime.datetime.fromisoformat(raw.replace("Z", "+00:00"))
            return dt.astimezone().strftime("%Y-%m-%d %H:%M")
        except Exception:
            return raw[:19].replace("T", " ")

    @staticmethod
    def _cloud_portable_setting_keys():
        # Privacy consent and Windows startup behavior deliberately remain local
        # to each PC. Everything else here is a user-facing portable preference.
        return (
            "auto_update_q3elite", "auto_update_launcher", "auto_update_osp",
            "minimize_to_tray", "starting_section", "last_section", "game_launch_behavior",
            "server_region_en", "server_region_ru", "server_region_initialized", "server_preset_ids",
            "show_changelog_media", "pause_server_refresh_unfocused",
            "pause_matchmaking_when_game_launched",
            "suppress_startup_notification_sound", "screenshot_source",
            "matchmaking_sound_volume", "disable_matchmaking_popup",
            "launcher_sounds_enabled", "launcher_sound_volume",
            "cleanup_screenshots_days", "cleanup_demos_days",
            "statistics_profile_url", "statistics_period",
        )

    def _account_local_cloud_state(self):
        portable_keys = self._cloud_portable_setting_keys()
        preferences = {key: launcher_settings.get(key) for key in portable_keys if key in launcher_settings}

        servers = []
        try:
            servers = server_monitor.load_servers(USER_SERVERS_FILE)
        except Exception as error:
            print(f"[account] Could not read server settings for cloud sync: {error}")

        matchmaking = {"rules": []}
        try:
            if MATCHMAKING_FILE.is_file():
                raw = json.loads(MATCHMAKING_FILE.read_text(encoding="utf-8"))
                if isinstance(raw, dict):
                    matchmaking = raw
                elif isinstance(raw, list):
                    matchmaking = {"rules": raw}
        except Exception as error:
            print(f"[account] Could not read matchmaking settings for cloud sync: {error}")

        user_config_b64 = ""
        user_config_sha256 = ""
        user_config_size = 0
        user_config_path = GAME_ROOT / "baseq3" / "mods" / "osp" / "UserConfig.cfg"
        try:
            if user_config_path.is_file():
                raw_cfg = user_config_path.read_bytes()
                # A real UserConfig.cfg is normally only a few KB. Keep a hard
                # ceiling so an accidentally selected/generated giant file cannot
                # turn the account row into general-purpose cloud storage.
                if len(raw_cfg) <= 768 * 1024:
                    user_config_size = len(raw_cfg)
                    user_config_sha256 = hashlib.sha256(raw_cfg).hexdigest()
                    user_config_b64 = base64.b64encode(raw_cfg).decode("ascii")
                else:
                    print("[account] UserConfig.cfg is larger than 768 KiB; skipping it in cloud sync.")
        except Exception as error:
            print(f"[account] Could not read UserConfig.cfg for cloud sync: {error}")

        return {
            "preferences": preferences,
            "servers": servers,
            "matchmaking": matchmaking,
            "user_config_b64": user_config_b64,
            "user_config_sha256": user_config_sha256,
            "user_config_size": user_config_size,
            "theme_id": str(getattr(ui_theme, "theme_name", "") or ""),
        }

    def _backup_before_cloud_restore(self):
        """Create a local safety copy immediately before overwriting cloud state."""
        root = LAUNCHER_DATA_DIR / "cloud_restore_backup"
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        folder = root / stamp
        folder.mkdir(parents=True, exist_ok=True)
        copies = (
            (SETTINGS_FILE, "settings.json"),
            (USER_SERVERS_FILE, "servers.json"),
            (MATCHMAKING_FILE, "matchmaking.json"),
            (GAME_ROOT / "baseq3" / "mods" / "osp" / "UserConfig.cfg", "UserConfig.cfg"),
        )
        copied = []
        for src, name in copies:
            try:
                if Path(src).is_file():
                    shutil.copy2(src, folder / name)
                    copied.append(name)
            except Exception as error:
                print(f"[account] Could not safety-backup {src}: {error}")
        try:
            (folder / "restore-info.json").write_text(
                json.dumps({
                    "created_at": datetime.datetime.now().astimezone().isoformat(),
                    "theme_id": str(getattr(ui_theme, "theme_name", "") or ""),
                    "files": copied,
                }, indent=2, ensure_ascii=False) + "\n",
                encoding="utf-8",
            )
        except Exception:
            pass
        self._last_cloud_restore_backup = folder
        return folder

    def _decode_cloud_user_config(self, payload):
        payload = dict(payload or {})
        # V23.9 slot objects use short keys; V23.8 cloud payloads keep the
        # legacy user_config_* keys. Accept both for safe upgrades.
        cfg_b64 = str(payload.get("b64") or payload.get("user_config_b64") or "").strip()
        if not cfg_b64:
            return None
        raw_cfg = base64.b64decode(cfg_b64.encode("ascii"), validate=True)
        expected_size = max(0, int(payload.get("size") or payload.get("user_config_size") or 0))
        expected_hash = str(payload.get("sha256") or payload.get("user_config_sha256") or "").strip().lower()
        if expected_size and len(raw_cfg) != expected_size:
            raise ValueError("UserConfig.cfg size does not match the cloud snapshot")
        actual_hash = hashlib.sha256(raw_cfg).hexdigest()
        if expected_hash and actual_hash != expected_hash:
            raise ValueError("UserConfig.cfg checksum does not match the cloud snapshot")
        return raw_cfg

    def _restore_cloud_user_config_only(self, payload, *, create_backup=True):
        raw_cfg = self._decode_cloud_user_config(payload)
        if raw_cfg is None:
            return None

        cfg_path = GAME_ROOT / "baseq3" / "mods" / "osp" / "UserConfig.cfg"
        backup_path = None
        if create_backup:
            root = LAUNCHER_DATA_DIR / "cloud_restore_backup"
            stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
            folder = root / f"{stamp}-userconfig"
            folder.mkdir(parents=True, exist_ok=True)
            if cfg_path.is_file():
                backup_path = folder / "UserConfig.cfg"
                shutil.copy2(cfg_path, backup_path)
            try:
                (folder / "restore-info.json").write_text(
                    json.dumps({
                        "created_at": datetime.datetime.now().astimezone().isoformat(),
                        "scope": "UserConfig.cfg only",
                        "cloud_updated_at": str(payload.get("saved_at") or payload.get("updated_at") or ""),
                        "backup_created": bool(backup_path),
                    }, indent=2, ensure_ascii=False) + "\n",
                    encoding="utf-8",
                )
            except Exception:
                pass

        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        temp_cfg = cfg_path.with_suffix(cfg_path.suffix + ".tmp")
        temp_cfg.write_bytes(raw_cfg)
        os.replace(temp_cfg, cfg_path)
        return {
            "path": str(cfg_path),
            "size": len(raw_cfg),
            "backup": str(backup_path) if backup_path else "",
        }

    def _apply_account_cloud_state(self, payload):
        global launcher_settings
        payload = dict(payload or {})
        self._backup_before_cloud_restore()

        preferences = payload.get("preferences") or {}
        if isinstance(preferences, dict):
            allowed = set(self._cloud_portable_setting_keys())
            for key, value in preferences.items():
                if key in allowed:
                    launcher_settings[key] = value
            save_launcher_settings(launcher_settings)
            self.load_settings_ui()

        servers = payload.get("servers")
        if isinstance(servers, list):
            try:
                server_monitor.save_custom_servers(USER_SERVERS_FILE, [x for x in servers if isinstance(x, dict)])
                if "servers" in getattr(self, "_built_pages", set()):
                    self._reload_server_cards()
            except Exception as error:
                print(f"[account] Could not restore server list: {error}")

        matchmaking = payload.get("matchmaking")
        if isinstance(matchmaking, dict):
            try:
                MATCHMAKING_FILE.parent.mkdir(parents=True, exist_ok=True)
                temp = MATCHMAKING_FILE.with_suffix(MATCHMAKING_FILE.suffix + ".tmp")
                temp.write_text(json.dumps(matchmaking, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
                os.replace(temp, MATCHMAKING_FILE)
                if "matchmaking" in getattr(self, "_built_pages", set()):
                    self.matchmakingRules = self._load_matchmaking_rules()
                    self.matchmakingRuleStates = {str(r.get("id") or ""): False for r in self.matchmakingRules}
                    self._rebuild_matchmaking_rules()
                    self.refresh_matchmaking()
            except Exception as error:
                print(f"[account] Could not restore matchmaking settings: {error}")

        if str(payload.get("user_config_b64") or "").strip():
            try:
                # Full restore already created one safety folder containing the
                # previous UserConfig.cfg, so do not create a second backup here.
                self._restore_cloud_user_config_only(payload, create_backup=False)
            except Exception as error:
                print(f"[account] Could not restore UserConfig.cfg: {error}")

        theme_id = str(payload.get("theme_id") or "").strip()
        if theme_id and ui_theme is not None and theme_id != getattr(ui_theme, "theme_name", ""):
            try:
                available = {str(x.get("id")) for x in ui_theme.available_themes()}
                if theme_id in available:
                    ui_theme.set_theme(theme_id, persist=True)
            except Exception as error:
                print(f"[account] Could not restore theme {theme_id}: {error}")

    def _set_account_avatar_pixmap(self, pixmap):
        if pixmap is None or pixmap.isNull():
            return
        size = 88
        canvas = QtGui.QPixmap(size, size)
        canvas.fill(QtCore.Qt.GlobalColor.transparent)
        painter = QtGui.QPainter(canvas)
        painter.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing, True)
        painter.setRenderHint(QtGui.QPainter.RenderHint.SmoothPixmapTransform, True)
        path = QtGui.QPainterPath()
        path.addEllipse(QtCore.QRectF(0, 0, size, size))
        painter.setClipPath(path)
        # A real circular backing surface makes transparent PNG avatars blend
        # cleanly with both Paper and Steel instead of exposing undefined RGB
        # data or a square QLabel background.
        painter.fillPath(path, theme_color("colors.surface.raised", "#121214"))
        scaled = pixmap.scaled(size, size, QtCore.Qt.AspectRatioMode.KeepAspectRatioByExpanding, QtCore.Qt.TransformationMode.SmoothTransformation)
        x = (scaled.width() - size) // 2
        y = (scaled.height() - size) // 2
        painter.drawPixmap(0, 0, scaled, x, y, size, size)
        painter.end()
        if hasattr(self, "accountAvatar"):
            self.accountAvatar.setPixmap(canvas)
        if hasattr(self, "accountNav") and self.accountManager.session is not None:
            self._account_avatar_icon = QtGui.QIcon(canvas)
            self.accountNav.setIcon(self._account_avatar_icon)
            self.accountNav.setIconSize(QtCore.QSize(theme_int("icons.size_navigation", 22), theme_int("icons.size_navigation", 22)))

    def _load_account_avatar(self, url):
        url = str(url or "").strip()
        if not hasattr(self, "accountAvatar"):
            return
        if not url:
            self.accountAvatar.setPixmap(QtGui.QPixmap())
            self.accountAvatar.setText("Q3E")
            self._account_avatar_icon = None
            self._refresh_nav_icons()
            return
        if getattr(self, "_account_avatar_url", "") == url and self.accountAvatar.pixmap() is not None and not self.accountAvatar.pixmap().isNull():
            return
        self._account_avatar_url = url
        request = QtNetwork.QNetworkRequest(QtCore.QUrl(url))
        reply = self._mapNetwork.get(request)
        reply.finished.connect(lambda r=reply, expected=url: self._account_avatar_finished(r, expected))

    def _account_avatar_finished(self, reply, expected_url):
        try:
            if expected_url != getattr(self, "_account_avatar_url", ""):
                return
            data = bytes(reply.readAll())
            pix = QtGui.QPixmap()
            if data and pix.loadFromData(data):
                self.accountAvatar.setText("")
                self._set_account_avatar_pixmap(pix)
        finally:
            reply.deleteLater()

    def _set_account_cloud_snapshot_display(self, backup):
        backup = dict(backup or {}) if isinstance(backup, dict) else {}
        updated = str(backup.get("updated_at") or "")
        if hasattr(self, "accountCloudBackupStatus"):
            self.accountCloudBackupStatus.setText(
                f"Last settings sync: {self._account_date_text(updated)}" if updated
                else "No cloud settings synchronized yet."
            )
        if not hasattr(self, "accountCloudContents"):
            return
        if not updated:
            self.accountCloudContents.setText("")
            return
        server_count = len(backup.get("servers") or [])
        mm = backup.get("matchmaking") or {}
        rule_count = len(mm.get("rules") or []) if isinstance(mm, dict) else 0
        slots = [x for x in (backup.get("user_config_slots") or []) if isinstance(x, dict)]
        if slots:
            cfg_text = f"UserConfig history {len(slots)}/3"
        else:
            cfg_size = max(0, int(backup.get("user_config_size") or 0))
            cfg_text = f"UserConfig.cfg {cfg_size / 1024:.1f} KiB" if cfg_size else "UserConfig.cfg not present"
        self.accountCloudContents.setText(
            f"Cloud snapshot: {server_count} server(s) • {rule_count} matchmaking rule(s) • {cfg_text}."
        )

    def _populate_account_page(self, overview=None):
        if not hasattr(self, "accountPageNickname"):
            return
        snapshot = self.accountManager.account_snapshot()
        authenticated = bool(snapshot.get("authenticated"))
        email = str(snapshot.get("email") or "")
        shown_email = email if self._account_email_revealed else self._masked_account_email(email)
        self.accountPageEmail.setText(shown_email if authenticated else "Sign in to use Q3Elite Cloud.")
        self.accountPageEmailButton.setVisible(authenticated and bool(email))
        self.accountPageEmailButton.setText("HIDE" if self._account_email_revealed else "SHOW")
        self.accountPageNickname.setText(str(snapshot.get("nickname") or "Player") if authenticated else "NOT SIGNED IN")
        self.accountPageProvider.setText(f"AUTH  •  {self._account_provider_text(snapshot)}" if authenticated else "")
        created = str(snapshot.get("created_at") or "")
        self.accountPageCreated.setText(f"MEMBER SINCE  •  {self._account_date_text(created)}" if authenticated and created else "")
        self.accountPageEmailStatus.setText("ACCOUNT  •  AUTHENTICATED" if authenticated else "")
        self.accountPageSignIn.setVisible(not authenticated)
        self.accountEditProfileButton.setVisible(authenticated)
        self.accountChangeAvatarButton.setVisible(authenticated)
        identities = snapshot.get("identities") or []
        provider_set = {str(item.get("provider") or "").strip().lower() for item in identities if isinstance(item, dict)}
        if not provider_set:
            provider_set = {str(x or "").strip().lower() for x in (snapshot.get("providers") or [])}
            active_provider = str(snapshot.get("provider") or "").strip().lower()
            if active_provider:
                provider_set.add(active_provider)
        identities_count = len(snapshot.get("identities") or [])
        self.accountConnectedAccountsCard.setVisible(authenticated)
        busy = self.accountWorker is not None and self.accountWorker.isRunning()
        for provider, (status, button) in self.accountIdentityRows.items():
            linked = provider in provider_set or (provider == "telegram" and "custom:telegram" in provider_set)
            status.setText("CONNECTED" if linked else "NOT CONNECTED")
            can_unlink = linked and identities_count >= 2
            button.setProperty("linked", linked)
            button.setText("UNLINK" if can_unlink else "CONNECTED" if linked else "LINK")
            button.setToolTip(
                f"Unlink {provider.title()} from this account" if can_unlink else
                ("At least one other sign-in method must remain connected." if linked else f"Connect {provider.title()} to this account")
            )
            button.setEnabled(authenticated and not busy and (not linked or can_unlink))
        self.accountPageSignOut.setVisible(authenticated)

        pending_email = str(snapshot.get("pending_confirmation_email") or "")
        verification_pending = bool(pending_email) and not authenticated
        self.accountVerificationCard.setVisible(verification_pending)
        if verification_pending:
            self.accountVerificationText.setText(
                f"We sent a confirmation link to {self._masked_account_email(pending_email)}. "
                "Open the email, confirm the address, then return here and sign in."
            )
        for button in (self.accountPageSync, self.accountBackupButton, self.accountRestoreButton, self.accountRefreshButton):
            button.setEnabled(authenticated)
        self.accountResendVerificationButton.setEnabled(verification_pending)
        self.accountVerificationSignInButton.setEnabled(verification_pending)
        self.accountRemoveDeviceButton.setEnabled(False)
        self._load_account_avatar(snapshot.get("avatar_url") if authenticated else "")

        pending = int(snapshot.get("pending") or 0)
        self.accountPendingSessions.setText(str(pending))
        if not authenticated:
            self.accountCloudPlaytime.setText("—")
            self.accountCloudSessions.setText("—")
            self.accountLastPlayed.setText("—")
            self.accountCloudBackupStatus.setText("Sign in to use cloud settings.")
            if hasattr(self, "accountCloudContents"):
                self.accountCloudContents.setText("")
            self.accountDevices.clear()
            return

        if isinstance(overview, dict):
            total = max(0, int(overview.get("total_playtime_seconds") or 0))
            sessions = max(0, int(overview.get("session_count") or 0))
            self.accountCloudPlaytime.setText(format_playtime(total))
            self.accountCloudSessions.setText(str(sessions))
            self.accountLastPlayed.setText(self._account_date_text(overview.get("last_played")))
            backup = overview.get("cloud_state") or {}
            self._set_account_cloud_snapshot_display(backup)
            self.accountDevices.clear()
            for device in overview.get("devices") or []:
                if not isinstance(device, dict):
                    continue
                device_id = str(device.get("device_id") or "")
                current = device_id == self.accountManager.device_id
                name = str(device.get("device_name") or device_id[:8] or "PC")
                os_name = str(device.get("os_name") or "—")
                last_seen = self._account_date_text(device.get("last_seen"))
                item = QtWidgets.QTreeWidgetItem([name, os_name, last_seen, "CURRENT" if current else ""])
                item.setData(0, QtCore.Qt.ItemDataRole.UserRole, device_id)
                item.setData(3, QtCore.Qt.ItemDataRole.UserRole, current)
                self.accountDevices.addTopLevelItem(item)
            self._update_account_device_actions()

    def _update_account_device_actions(self):
        if not hasattr(self, "accountDevices"):
            return
        item = self.accountDevices.currentItem()
        removable = False
        if item is not None:
            current = bool(item.data(3, QtCore.Qt.ItemDataRole.UserRole))
            removable = bool(item.data(0, QtCore.Qt.ItemDataRole.UserRole)) and not current
        self.accountRemoveDeviceButton.setEnabled(removable and self.accountManager.session is not None)

    def refresh_account_overview(self):
        if self.accountManager.session is None:
            self._populate_account_page()
            return
        self._start_account_worker(
            "overview",
            self.accountManager.account_overview,
            "Refreshing account...",
        )

    def edit_account_profile(self):
        if self.accountManager.session is None:
            self.open_account_dialog()
            return
        snapshot = self.accountManager.account_snapshot()
        dialog = ProfileEditDialog(snapshot.get("nickname"), self)
        if dialog.exec() != QtWidgets.QDialog.DialogCode.Accepted:
            return
        nickname = dialog.nickname()
        self._start_account_worker(
            "profile_update",
            lambda n=nickname: self.accountManager.update_profile(n),
            "Saving profile...",
        )

    def remove_selected_account_device(self):
        item = self.accountDevices.currentItem() if hasattr(self, "accountDevices") else None
        if item is None:
            return
        device_id = str(item.data(0, QtCore.Qt.ItemDataRole.UserRole) or "")
        current = bool(item.data(3, QtCore.Qt.ItemDataRole.UserRole))
        if not device_id or current:
            return
        name = item.text(0) or "device"
        answer = QtWidgets.QMessageBox.question(
            self,
            "Remove device",
            f"Remove {name} from this Q3Elite account?\n\nThis does not delete its historical playtime.",
            QtWidgets.QMessageBox.StandardButton.Yes | QtWidgets.QMessageBox.StandardButton.No,
            QtWidgets.QMessageBox.StandardButton.No,
        )
        if answer != QtWidgets.QMessageBox.StandardButton.Yes:
            return
        self._start_account_worker(
            "remove_device",
            lambda d=device_id: self.accountManager.remove_device(d),
            "Removing device...",
        )

    def backup_account_cloud_state(self):
        if self.accountManager.session is None:
            return
        state = self._account_local_cloud_state()
        self._start_account_worker(
            "cloud_backup",
            lambda st=state: self.accountManager.save_cloud_state(st),
            "Synchronizing settings to Q3Elite Cloud...",
        )

    def restore_account_cloud_state(self):
        if self.accountManager.session is None:
            return
        answer = QtWidgets.QMessageBox.question(
            self,
            "Restore cloud settings",
            "Replace this PC's portable launcher settings, server list, matchmaking rules, "
            "UserConfig.cfg and active theme with the latest Q3Elite Cloud snapshot?\n\n"
            "Q3Elite will create a local safety backup immediately before restoring.",
            QtWidgets.QMessageBox.StandardButton.Yes | QtWidgets.QMessageBox.StandardButton.No,
            QtWidgets.QMessageBox.StandardButton.No,
        )
        if answer != QtWidgets.QMessageBox.StandardButton.Yes:
            return
        self._start_account_worker(
            "cloud_restore",
            self.accountManager.load_cloud_state,
            "Downloading cloud settings...",
        )

    def auto_sync_userconfig_after_editor_save(self, dialog=None):
        """Pin a USER SAVED cloud snapshot after Config Editor saves locally.

        The method name is kept for compatibility with ConfigEditorDialog, but
        editor SAVE is intentionally a user action now: it rotates USER SAVED /
        OLDER USER SAVED.  The AUTO SYNC slot is updated only by the Profile
        SYNC SETTINGS operation.
        """
        if self.accountManager.session is None:
            if dialog is not None:
                try:
                    dialog.message.setText("UserConfig.cfg saved locally. Sign in to PROFILE to save a cloud copy.")
                except RuntimeError:
                    pass
            return
        state = self._account_local_cloud_state()
        if not str(state.get("user_config_b64") or "").strip():
            return
        self._pending_userconfig_manual_dialog = dialog
        if not self._start_account_worker(
            "cloud_userconfig_save",
            lambda st=state: self.accountManager.save_user_config_snapshot(st),
            "Saving UserConfig.cfg to Q3Elite Cloud history...",
        ):
            self._pending_userconfig_manual_dialog = None
            if dialog is not None:
                try:
                    dialog.message.setText("UserConfig.cfg saved locally. Another Cloud operation is already running.")
                except RuntimeError:
                    pass

    def restore_userconfig_from_cloud_editor(self, dialog=None):
        if self.accountManager.session is None:
            if dialog is not None:
                dialog.message.setText("Sign in to PROFILE before restoring UserConfig.cfg from Cloud.")
            elif hasattr(self, "addonMessage"):
                self.addonMessage.setText("Sign in to PROFILE before restoring UserConfig.cfg from Cloud.")
            return

        self._pending_userconfig_restore_dialog = dialog
        if dialog is not None and hasattr(dialog, "cloudRestoreButton"):
            dialog.cloudRestoreButton.setEnabled(False)
            dialog.message.setText("Loading UserConfig.cfg cloud history...")
        elif hasattr(self, "addonMessage"):
            self.addonMessage.setText("Loading UserConfig.cfg cloud history...")

        if not self._start_account_worker(
            "cloud_userconfig_load",
            self.accountManager.load_cloud_state,
            "Loading UserConfig.cfg cloud history...",
        ):
            if dialog is not None:
                try:
                    dialog.cloudRestoreButton.setEnabled(True)
                    dialog.message.setText("Another Q3Elite Cloud operation is already running.")
                except RuntimeError:
                    pass
            elif hasattr(self, "addonMessage"):
                self.addonMessage.setText("Another Q3Elite Cloud operation is already running.")
            self._pending_userconfig_restore_dialog = None

    def open_cache_folder(self):
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(str(CACHE_DIR)))

    def _remove_cache_path(self, path):
        path = Path(path)
        if path.is_dir():
            shutil.rmtree(path, ignore_errors=False)
        elif path.exists():
            path.unlink()

    def clear_launcher_cache(self):
        try:
            # UI/media cache and disposable temporary launcher state.
            self._remove_cache_path(CACHE_DIR / "Changelog")
            self._remove_cache_path(TEMP_DIR)
            TEMP_DIR.mkdir(parents=True, exist_ok=True)
            # Also release in-memory raster caches so this button genuinely
            # returns RAM during a long launcher session. Hot surfaces rebuild
            # lazily on the next paint.
            _PIXMAP_FILE_CACHE.clear()
            _clear_obsidian_render_cache()
            try:
                OBSIDIAN_MATERIAL.reset_caches()
            except Exception:
                pass
            self.settingsMessage.setText("Launcher cache cleared (disk + memory).")
        except Exception as error:
            self.settingsMessage.setText(f"Could not clear launcher cache: {error}")

    def clear_download_cache(self):
        try:
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
            for path in list(CACHE_DIR.iterdir()):
                if path.name.casefold() == "changelog":
                    continue
                self._remove_cache_path(path)
            self.settingsMessage.setText("Download cache cleared.")
        except Exception as error:
            self.settingsMessage.setText(f"Could not clear download cache: {error}")

    def repair_launcher(self):
        if getattr(self, "_repair_running", False):
            return
        self._repair_running = True
        self.repairLauncherButton.setEnabled(False)
        self.settingsMessage.setText("Checking Launcher files...")
        QtWidgets.QApplication.processEvents()
        try:
            repair_info = check_launcher_repair()
            if not repair_info:
                self.settingsMessage.setText("Launcher files are OK. No repair needed.")
                return
            self.settingsMessage.setText("Repairing Launcher files...")
            QtWidgets.QApplication.processEvents()
            stage_launcher_update(
                repair_info,
                control=download_control,
                progress_callback=download_progress_callback,
            )
            launch_apply_helper(os.getpid())
            self.settingsMessage.setText("Repair staged. Restarting Launcher...")
            QtCore.QTimer.singleShot(100, QtWidgets.QApplication.instance().quit)
        except Exception as error:
            self.settingsMessage.setText(f"Launcher repair failed: {error}")
        finally:
            self._repair_running = False
            self.repairLauncherButton.setEnabled(True)

    def open_config_editor(self):
        if not config_editor_available():
            return
        dialog = ConfigEditorDialog(self)
        dialog.exec()

    def minimize_launcher(self):
        if launcher_settings.get("minimize_to_tray", False) and QtWidgets.QSystemTrayIcon.isSystemTrayAvailable():
            self.trayIcon.show()
            self.hide()
        else:
            self.showMinimized()

    def _restore_saved_window_geometry(self):
        """Restore normal geometry only when the saved rectangle is on a connected screen."""
        if not launcher_settings.get("keep_window_position", True):
            return
        try:
            x = int(launcher_settings.get("window_x", -1))
            y = int(launcher_settings.get("window_y", -1))
            width = max(640, int(launcher_settings.get("window_width", 1366)))
            height = max(480, int(launcher_settings.get("window_height", 768)))
            app_instance = QtWidgets.QApplication.instance()
            screens = list(app_instance.screens()) if app_instance is not None else []
            if not screens:
                return
            saved = QtCore.QRect(x, y, width, height)
            matching = None
            if (x, y) != (-1, -1):
                for screen in screens:
                    available = screen.availableGeometry()
                    intersection = saved.intersected(available)
                    if intersection.width() >= 160 and intersection.height() >= 120:
                        matching = screen
                        break
            if matching is not None:
                available = matching.availableGeometry()
                width = min(width, available.width())
                height = min(height, available.height())
                x = max(available.left(), min(x, available.right() - width + 1))
                y = max(available.top(), min(y, available.bottom() - height + 1))
            else:
                primary = app_instance.primaryScreen()
                if primary is None:
                    return
                available = primary.availableGeometry()
                width = min(width, available.width())
                height = min(height, available.height())
                x = available.left() + max(0, (available.width() - width) // 2)
                y = available.top() + max(0, (available.height() - height) // 2)
            self.setGeometry(x, y, width, height)
        except Exception as error:
            print(f"[window] Could not restore saved geometry: {error}")

    def _save_window_geometry(self):
        if not launcher_settings.get("keep_window_position", True):
            return
        try:
            rect = self.normalGeometry()
            if not rect.isValid() or rect.width() < 640 or rect.height() < 480:
                rect = self.geometry()
            launcher_settings["window_x"] = int(rect.x())
            launcher_settings["window_y"] = int(rect.y())
            launcher_settings["window_width"] = int(rect.width())
            launcher_settings["window_height"] = int(rect.height())
        except Exception as error:
            print(f"[window] Could not save geometry: {error}")

    def restore_from_tray(self):
        """Restore and explicitly request Windows foreground ownership."""
        try:
            was_fullscreen = (
                self.isFullScreen()
                or bool(self.windowState() & QtCore.Qt.WindowState.WindowFullScreen)
            )
            state = self.windowState()
            state &= ~QtCore.Qt.WindowState.WindowMinimized
            self.setWindowState(state)
            if was_fullscreen:
                self.showFullScreen()
            else:
                self.showNormal()
            self.show()
            self.raise_()
            self.activateWindow()
            QtWidgets.QApplication.processEvents()

            if sys.platform == "win32":
                import ctypes
                from ctypes import wintypes

                user32 = ctypes.windll.user32
                kernel32 = ctypes.windll.kernel32
                hwnd = wintypes.HWND(int(self.winId()))

                # Declare pointer-sized HWND signatures explicitly; without
                # prototypes ctypes may truncate 64-bit window handles.
                user32.GetForegroundWindow.restype = wintypes.HWND
                user32.GetWindowThreadProcessId.argtypes = (
                    wintypes.HWND, ctypes.POINTER(wintypes.DWORD)
                )
                user32.GetWindowThreadProcessId.restype = wintypes.DWORD
                user32.AttachThreadInput.argtypes = (
                    wintypes.DWORD, wintypes.DWORD, wintypes.BOOL
                )
                user32.AttachThreadInput.restype = wintypes.BOOL
                user32.ShowWindow.argtypes = (wintypes.HWND, ctypes.c_int)
                user32.BringWindowToTop.argtypes = (wintypes.HWND,)
                user32.SetForegroundWindow.argtypes = (wintypes.HWND,)
                user32.SetActiveWindow.argtypes = (wintypes.HWND,)
                user32.SetFocus.argtypes = (wintypes.HWND,)

                foreground = user32.GetForegroundWindow()
                current_tid = kernel32.GetCurrentThreadId()
                foreground_pid = wintypes.DWORD()
                foreground_tid = (
                    user32.GetWindowThreadProcessId(
                        foreground, ctypes.byref(foreground_pid)
                    ) if foreground else 0
                )
                target_pid = wintypes.DWORD()
                target_tid = user32.GetWindowThreadProcessId(
                    hwnd, ctypes.byref(target_pid)
                )

                # Windows may reject SetForegroundWindow when the launcher
                # was activated by a second process. Temporarily share input
                # queues with the current foreground thread, then detach.
                attached = []
                try:
                    for thread_id in {foreground_tid, target_tid}:
                        if thread_id and thread_id != current_tid:
                            if user32.AttachThreadInput(current_tid, thread_id, True):
                                attached.append(thread_id)
                    user32.ShowWindow(hwnd, 9)  # SW_RESTORE
                    user32.BringWindowToTop(hwnd)
                    user32.SetForegroundWindow(hwnd)
                    user32.SetActiveWindow(hwnd)
                    user32.SetFocus(hwnd)
                finally:
                    for thread_id in reversed(attached):
                        user32.AttachThreadInput(current_tid, thread_id, False)

                foreground_after = user32.GetForegroundWindow()
                if int(foreground_after or 0) != int(hwnd or 0):
                    class FLASHWINFO(ctypes.Structure):
                        _fields_ = [
                            ("cbSize", wintypes.UINT),
                            ("hwnd", wintypes.HWND),
                            ("dwFlags", wintypes.DWORD),
                            ("uCount", wintypes.UINT),
                            ("dwTimeout", wintypes.DWORD),
                        ]
                    flash = FLASHWINFO(
                        ctypes.sizeof(FLASHWINFO), hwnd, 3, 3, 0
                    )
                    user32.FlashWindowEx(ctypes.byref(flash))
        except Exception as error:
            print(f"[instance] Could not fully activate launcher window: {error}")
            try:
                self.showNormal()
                self.raise_()
                self.activateWindow()
            except Exception:
                pass

    def exit_from_tray(self):
        self._allow_close = True
        self.trayIcon.hide()
        self.close()

    def _tray_activated(self, reason):
        if reason in (
            QtWidgets.QSystemTrayIcon.ActivationReason.Trigger,
            QtWidgets.QSystemTrayIcon.ActivationReason.DoubleClick,
        ):
            self.restore_from_tray()

    def closeEvent(self, event):
        if (
            not self._allow_close
            and launcher_settings.get("minimize_to_tray", False)
            and QtWidgets.QSystemTrayIcon.isSystemTrayAvailable()
        ):
            self.trayIcon.show()
            self.hide()
            event.ignore()
            return
        executor = getattr(self, "_preload_executor", None)
        if executor is not None:
            try:
                executor.shutdown(wait=False, cancel_futures=True)
            except Exception:
                pass
            self._preload_executor = None
        for renderer in list(getattr(self, "_telegramDetachedRenderers", []) or []):
            try:
                renderer.close()
                renderer.deleteLater()
            except RuntimeError:
                pass
        self._telegramDetachedRenderers = []
        try:
            _close_payload = self._diagnostics_context()
            _close_payload["session"] = self._diagnostics_session_summary()
            self._diag_event("launcher_closed", _close_payload)
            if hasattr(self, "diagnosticsManager"):
                self.diagnosticsManager.flush_async()
            if self._game_session_id is not None:
                self._heartbeat_game_session()
            self._save_window_geometry()
            save_launcher_settings(launcher_settings)
        except Exception:
            pass
        event.accept()

    @staticmethod
    def _running_xq3e_processes():
        """Return (pid, image_name) pairs for running XQ3E processes."""
        if os.name != "nt":
            return []
        try:
            creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            result = subprocess.run(
                ["tasklist", "/FO", "CSV", "/NH"],
                capture_output=True,
                text=True,
                timeout=5,
                creationflags=creationflags,
                check=False,
            )
            processes = []
            for row in csv.reader((result.stdout or "").splitlines()):
                if len(row) < 2:
                    continue
                image_name = str(row[0] or "").strip()
                if "xq3e" not in image_name.casefold():
                    continue
                try:
                    pid = int(str(row[1]).replace(",", "").strip())
                except (TypeError, ValueError):
                    continue
                processes.append((pid, image_name))
            return processes
        except Exception as error:
            print(f"[playtime] Process scan failed: {error}")
            return []

    def _refresh_playtime_ui(self):
        # Playtime tracking remains active; its Settings display was removed.
        return

    def _start_detached_game_session_tracker(self, ignored_pids, launched_at):
        helper = Path(__file__).resolve().with_name("game_session_tracker.py")
        if os.name != "nt" or not helper.is_file():
            print(f"[playtime] Detached tracker unavailable: {helper}")
            return False

        ignored = ",".join(str(int(pid)) for pid in sorted(set(ignored_pids or [])))

        # Prefer the windowless Python interpreter from the same venv.  Using
        # python.exe for a long-running helper can create a useless blank console
        # window on Windows.  Do not combine DETACHED_PROCESS with CREATE_NO_WINDOW:
        # Windows explicitly ignores CREATE_NO_WINDOW in that combination.
        tracker_python = Path(sys.executable)
        if tracker_python.name.casefold() == "python.exe":
            pythonw = tracker_python.with_name("pythonw.exe")
            if pythonw.is_file():
                tracker_python = pythonw

        command = [
            str(tracker_python),
            str(helper),
            "--db", str(PLAYTIME_DB),
            "--ignore-pids", ignored,
            "--started-at", str(launched_at or ""),
            "--wait-seconds", "35",
            "--heartbeat-seconds", "60",
        ]
        try:
            creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            startupinfo = None
            if os.name == "nt":
                try:
                    startupinfo = subprocess.STARTUPINFO()
                    startupinfo.dwFlags |= getattr(subprocess, "STARTF_USESHOWWINDOW", 0)
                    startupinfo.wShowWindow = getattr(subprocess, "SW_HIDE", 0)
                except Exception:
                    startupinfo = None

            tracker_env = os.environ.copy()
            tracker_env["Q3ELITE_TRACKER_HIDDEN"] = "1"
            tracker_env["Q3ELITE_TRACKER_LABEL"] = "Q3Elite Gametime Tracker"

            subprocess.Popen(
                command,
                cwd=str(LAUNCHER_DIR),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                close_fds=True,
                creationflags=creationflags,
                startupinfo=startupinfo,
                env=tracker_env,
            )
            print(f"[playtime] Hidden session tracker started via {tracker_python.name}.")
            return True
        except Exception as error:
            print(f"[playtime] Could not start detached tracker: {error}")
            return False

    def _begin_game_session(self, process_info):
        if self._game_session_id is not None:
            return
        try:
            process_id, process_name = process_info
        except Exception:
            process_id, process_name = 0, str(process_info or "")
        now = datetime.datetime.now(datetime.timezone.utc).isoformat()
        tracker_token = f"launcher-fallback-{uuid.uuid4().hex}"
        try:
            with contextlib.closing(_playtime_connection()) as connection:
                cursor = connection.execute(
                    """
                    INSERT INTO game_sessions
                        (started_at, ended_at, last_heartbeat, duration_seconds,
                         engine_process, process_id, tracker_token, uploaded)
                    VALUES (?, NULL, ?, 0, ?, ?, ?, 0)
                    """,
                    (now, now, str(process_name or ""), int(process_id or 0), tracker_token),
                )
                connection.commit()
                self._game_session_id = int(cursor.lastrowid)
            self._game_session_started_monotonic = time.monotonic()
            self._game_process_name = str(process_name or "")
            print(f"[playtime] Fallback session #{self._game_session_id} started ({self._game_process_name}).")
        except Exception as error:
            print(f"[playtime] Could not start fallback session: {error}")

    def _heartbeat_game_session(self):
        if self._game_session_id is None or self._game_session_started_monotonic is None:
            return
        duration = max(0, round(time.monotonic() - self._game_session_started_monotonic))
        now = datetime.datetime.now(datetime.timezone.utc).isoformat()
        try:
            with contextlib.closing(_playtime_connection()) as connection:
                connection.execute(
                    "UPDATE game_sessions SET last_heartbeat = ?, duration_seconds = ? WHERE id = ?",
                    (now, duration, self._game_session_id),
                )
                connection.commit()
        except Exception as error:
            print(f"[playtime] Heartbeat failed: {error}")

    def _finish_game_session(self):
        if self._game_session_id is None:
            return
        self._heartbeat_game_session()
        now = datetime.datetime.now(datetime.timezone.utc).isoformat()
        session_id = self._game_session_id
        try:
            with contextlib.closing(_playtime_connection()) as connection:
                connection.execute(
                    "UPDATE game_sessions SET ended_at = ?, last_heartbeat = ?, uploaded = 0 WHERE id = ?",
                    (now, now, session_id),
                )
                connection.commit()
            print(f"[playtime] Fallback session #{session_id} finished.")
        except Exception as error:
            print(f"[playtime] Could not finish session: {error}")
        self._game_session_id = None
        self._game_session_started_monotonic = None
        self._game_process_name = ""
        self._refresh_playtime_ui()

    def _start_game_session_watch(self, ignored_pids=None):
        """Fallback in-GUI tracker used only when detached helper startup fails."""
        self._game_ignored_pids = {int(pid) for pid in (ignored_pids or [])}
        self._game_process_seen = False
        self._game_launch_wait_deadline = time.monotonic() + 30.0
        if not self.gameSessionTimer.isActive():
            self.gameSessionTimer.start()
        QtCore.QTimer.singleShot(700, self._poll_game_session)

    def _poll_game_session(self):
        processes = [
            process for process in self._running_xq3e_processes()
            if int(process[0]) not in getattr(self, "_game_ignored_pids", set())
        ]
        if processes:
            if not self._game_process_seen:
                self._game_process_seen = True
                self._begin_game_session(processes[0])
            else:
                self._heartbeat_game_session()
            return

        if self._game_process_seen:
            self._finish_game_session()
            self._game_process_seen = False
            self.gameSessionTimer.stop()
            return

        if time.monotonic() >= self._game_launch_wait_deadline:
            self.gameSessionTimer.stop()

    def _saved_game_launch_behavior(self):
        """Return the persisted launch behavior, not a stale UI/runtime copy."""
        try:
            behavior = str(load_launcher_settings().get("game_launch_behavior", "keep") or "keep").lower()
        except Exception:
            behavior = str(launcher_settings.get("game_launch_behavior", "keep") or "keep").lower()
        return behavior if behavior in {"keep", "minimize", "tray", "quit"} else "keep"

    def _apply_game_launch_behavior(self, detached_tracker_started=True):
        behavior = self._saved_game_launch_behavior()
        print(f"[launcher] Applying Quake launch behavior: {behavior}")
        if behavior == "minimize":
            self.showMinimized()
        elif behavior == "tray" and QtWidgets.QSystemTrayIcon.isSystemTrayAvailable():
            self.trayIcon.show()
            self.hide()
        elif behavior == "quit":
            if not detached_tracker_started:
                detail = (
                    "Q3Elite started, but Quit Launcher was cancelled because the detached "
                    "playtime tracker could not be started. Check that Modules/game_session_tracker.py "
                    "is installed next to launch.pyw."
                )
                print(f"[playtime] {detail}")
                self.statusDetail.setText(detail)
                try:
                    QtWidgets.QMessageBox.warning(self, "Q3Elite playtime tracker", detail)
                except Exception:
                    pass
                return
            self._allow_close = True
            try:
                self.trayIcon.hide()
            except Exception:
                pass
            # The helper is already a detached process, so there is no reason to
            # keep the GUI alive after the game has successfully launched.
            # QMediaPlayer playback is asynchronous. Closing too quickly cuts the PLAY/START sound off; allow a short finish window.
            # This delay applies only to the explicit Quit-after-launch path.
            QtCore.QTimer.singleShot(800, self.close)

    def launch(self):
        """Start Q3Elite and hand playtime tracking to a detached watcher."""
        if not q3elite_is_installed():
            prepare_first_install()
            return

        self._play_launcher_sound("start_button")
        ignored_pids = {pid for pid, _name in self._running_xq3e_processes()}
        launched_at = datetime.datetime.now(datetime.timezone.utc).isoformat()

        try:
            if not launch():
                self._diag_event("game_launch_failed", {"source": "play_button", "reason": "launcher_not_found_or_failed"})
                self.qerror(
                    "Could not start Q3Elite.\n"
                    "The Vulkan/OpenGL game launcher was not found or failed to start."
                )
                return

            self.statusDetail.setText("Q3Elite started.")
            self._diag_event("game_started", {"source": "play_button"})
            detached_started = self._start_detached_game_session_tracker(
                ignored_pids,
                launched_at,
            )
            if not detached_started:
                self._start_game_session_watch(ignored_pids)
            self._apply_game_launch_behavior(detached_started)
        except Exception as error:
            self._diag_event("game_launch_failed", {"source": "play_button", "error": str(error)})
            self.qerror(f"Could not start Q3Elite:\n{error}")

    def change_hero_image(self, delta, *, automatic=False):
        if not self._hero_urls:
            return
        self._hero_index = (self._hero_index + delta) % (len(self._hero_local) if getattr(self, "_hero_local", None) else len(self._hero_urls))
        self.load_hero_image()
        if not automatic:
            # A manual navigation starts a fresh interval; don't auto-advance
            # immediately after the user has just selected an image.
            self.heroAutoTimer.stop()
            if self.pages.currentWidget() is self.homePage and self.isVisible():
                self.heroAutoTimer.start()

    def _hero_cache_path(self, url):
        name = Path(urllib.parse.urlparse(str(url)).path).name or "image"
        return self._hero_cache_dir / name

    def _sync_home_hero_timer(self):
        timer = getattr(self, "heroAutoTimer", None)
        pages = getattr(self, "pages", None)
        home = getattr(self, "homePage", None)
        if timer is None or pages is None:
            return
        if pages.currentWidget() is home and self.isVisible():
            if not timer.isActive():
                timer.start()
        elif timer.isActive():
            timer.stop()

    def _request_hero_image(self, url):
        if url in self._hero_download_inflight:
            return
        self._hero_download_inflight.add(url)
        request = QtNetwork.QNetworkRequest(QtCore.QUrl(url))
        request.setRawHeader(
            b"User-Agent",
            f"Q3Elite-Launcher/{read_launcher_metadata().get('version', 'unknown')}".encode("ascii", "ignore"),
        )
        reply = self._network.get(request)
        reply.finished.connect(lambda r=reply, u=url: self._hero_download_finished(r, u))

    def _prefetch_home_hero_images(self):
        if not self._hero_urls:
            return
        try:
            self._hero_cache_dir.mkdir(parents=True, exist_ok=True)
        except OSError as error:
            print(f"[home] Could not create image cache: {error}")
        queued = set(self._hero_prefetch_queue) | set(self._hero_download_inflight)
        for url in self._hero_urls:
            if url in queued or url in self._hero_pixmaps:
                continue
            if self._hero_cache_path(url).is_file():
                continue
            self._hero_prefetch_queue.append(url)
        self._start_next_hero_prefetch()

    def _start_next_hero_prefetch(self):
        if self._hero_download_inflight or not self._hero_prefetch_queue:
            return
        url = self._hero_prefetch_queue.popleft()
        cache_path = self._hero_cache_path(url)
        if cache_path.is_file():
            pixmap = QtGui.QPixmap(str(cache_path))
            if not pixmap.isNull():
                self._hero_pixmaps[url] = pixmap
                if url == self._hero_urls[self._hero_index]:
                    self._set_hero_pixmap(pixmap)
                self._start_next_hero_prefetch()
                return
        self._request_hero_image(url)

    def _refresh_initial_hero_geometry(self):
        """Render the first Home screenshot against the settled hero geometry."""
        if not hasattr(self, "heroImage") or not self._hero_urls:
            return
        key = (str(self._hero_local[self._hero_index % len(self._hero_local)])
               if getattr(self, "_hero_local", None)
               else self._hero_urls[self._hero_index])
        pixmap = self._hero_pixmaps.get(key)
        if pixmap is not None and not pixmap.isNull():
            self._set_hero_pixmap(pixmap)
        else:
            self.load_hero_image()

    def load_hero_image(self):
        if not self._hero_urls:
            return
        self.heroCounter.setText(f"{self._hero_index + 1:02d} / {len(self._hero_urls):02d}")
        if getattr(self, "_hero_local", None):
            path = self._hero_local[self._hero_index % len(self._hero_local)]
            key = str(path)
            cached = self._hero_pixmaps.get(key)
            if cached is None:
                cached = _load_pixmap_file(key)
                if not cached.isNull(): self._hero_pixmaps[key] = cached
            if cached is not None and not cached.isNull():
                self.heroCounter.setText(f"{(self._hero_index % len(self._hero_local)) + 1:02d} / {len(self._hero_local):02d}")
                self._set_hero_pixmap(cached)
                return
        url = self._hero_urls[self._hero_index]
        cached = self._hero_pixmaps.get(url)
        if cached is not None:
            self._set_hero_pixmap(cached)
            return
        cache_path = self._hero_cache_path(url)
        if cache_path.is_file():
            pixmap = QtGui.QPixmap(str(cache_path))
            if not pixmap.isNull():
                self._hero_pixmaps[url] = pixmap
                self._set_hero_pixmap(pixmap)
                return
        self._request_hero_image(url)

    def _hero_download_finished(self, reply, url):
        try:
            if reply.error() != QtNetwork.QNetworkReply.NetworkError.NoError:
                if url == self._hero_urls[self._hero_index]:
                    self.heroImage.setText("Q3ELITE  •  VULKAN  •  OSP2-BE")
                print(f"[home] Image download failed ({url}): {reply.errorString()}")
                return
            data = bytes(reply.readAll())
            pixmap = QtGui.QPixmap()
            if pixmap.loadFromData(data):
                self._hero_pixmaps[url] = pixmap
                try:
                    self._hero_cache_dir.mkdir(parents=True, exist_ok=True)
                    self._hero_cache_path(url).write_bytes(data)
                except OSError as error:
                    print(f"[home] Could not cache image {url}: {error}")
                if url == self._hero_urls[self._hero_index]:
                    self._set_hero_pixmap(pixmap)
        finally:
            self._hero_download_inflight.discard(url)
            reply.deleteLater()
            self._start_next_hero_prefetch()

    def _refresh_hero_image_for_size(self):
        """Re-crop the current cached source image after Home layout resizing."""
        if not hasattr(self, "heroImage"):
            return
        target = self.heroImage.size()
        if target.width() < 10 or target.height() < 10:
            return
        source = None
        if getattr(self, "_hero_local", None):
            local_path = self._hero_local[self._hero_index % len(self._hero_local)]
            source = self._hero_pixmaps.get(str(local_path))
            if source is None:
                source = _load_pixmap_file(str(local_path))
                if source is not None and not source.isNull():
                    self._hero_pixmaps[str(local_path)] = source
        elif getattr(self, "_hero_urls", None):
            url = self._hero_urls[self._hero_index % len(self._hero_urls)]
            source = self._hero_pixmaps.get(url)
            if source is None:
                cache_path = self._hero_cache_path(url)
                if cache_path.is_file():
                    candidate = QtGui.QPixmap(str(cache_path))
                    source = candidate if not candidate.isNull() else None
                    if source is not None:
                        self._hero_pixmaps[url] = source
        if source is None or source.isNull():
            return
        scaled = source.scaled(
            target,
            QtCore.Qt.AspectRatioMode.KeepAspectRatioByExpanding,
            QtCore.Qt.TransformationMode.SmoothTransformation,
        )
        x = max(0, (scaled.width() - target.width()) // 2)
        y = max(0, (scaled.height() - target.height()) // 2)
        cropped = scaled.copy(x, y, target.width(), target.height())
        rendered = _rounded_pixmap(cropped, theme_float("home.hero_image_radius", 12.0))
        if self._hero_fade_animation is not None:
            self._hero_fade_animation.stop()
            self._hero_fade_animation = None
        if self._hero_opacity_effect is not None:
            self.heroImage.setGraphicsEffect(None)
            self._hero_opacity_effect = None
        self.heroImage.setPixmap(rendered)

    def _set_hero_pixmap(self, pixmap):
        target = self.heroImage.size()
        if target.width() < 10 or target.height() < 10:
            # The first cached/downloaded image can arrive before Qt has laid
            # out the Home hero. Keep it and retry after the first real frame;
            # otherwise the hero stays blank/small until the next carousel tick.
            self._hero_pending_pixmap = pixmap
            if not getattr(self, "_hero_pending_retry_queued", False):
                self._hero_pending_retry_queued = True
                def retry_pending_hero():
                    self._hero_pending_retry_queued = False
                    pending = getattr(self, "_hero_pending_pixmap", None)
                    if pending is not None and not pending.isNull():
                        if self.heroImage.width() >= 10 and self.heroImage.height() >= 10:
                            self._hero_pending_pixmap = None
                            self._set_hero_pixmap(pending)
                        else:
                            QtCore.QTimer.singleShot(180, retry_pending_hero)
                QtCore.QTimer.singleShot(180, retry_pending_hero)
            return
        self._hero_pending_pixmap = None
        scaled = pixmap.scaled(
            target,
            QtCore.Qt.AspectRatioMode.KeepAspectRatioByExpanding,
            QtCore.Qt.TransformationMode.SmoothTransformation,
        )
        x = max(0, (scaled.width() - target.width()) // 2)
        y = max(0, (scaled.height() - target.height()) // 2)
        cropped = scaled.copy(x, y, target.width(), target.height())
        rendered = _rounded_pixmap(cropped, theme_float("home.hero_image_radius", 12.0))
        if (str(getattr(ui_theme, "theme_name", "Steel")).casefold() == "paper"
                or self.heroImage.pixmap() is None
                or self.heroImage.pixmap().isNull()):
            if self._hero_fade_animation is not None:
                self._hero_fade_animation.stop()
                self._hero_fade_animation = None
            if self._hero_opacity_effect is not None:
                self.heroImage.setGraphicsEffect(None)
                self._hero_opacity_effect = None
            self.heroImage.setPixmap(rendered)
        elif self.heroImage.pixmap() is not None and not self.heroImage.pixmap().isNull():
            if self._hero_fade_animation is not None:
                self._hero_fade_animation.stop()
            if self._hero_opacity_effect is None:
                self._hero_opacity_effect = QtWidgets.QGraphicsOpacityEffect(self.heroImage)
                self.heroImage.setGraphicsEffect(self._hero_opacity_effect)
            self._hero_opacity_effect.setOpacity(0.0)
            self.heroImage.setPixmap(rendered)
            animation = QtCore.QPropertyAnimation(self._hero_opacity_effect, b"opacity", self)
            animation.setDuration(650)
            animation.setStartValue(0.0)
            animation.setEndValue(1.0)
            animation.finished.connect(
                lambda a=animation: setattr(self, "_hero_fade_animation", None)
                if self._hero_fade_animation is a else None
            )
            animation.start(QtCore.QAbstractAnimation.DeletionPolicy.DeleteWhenStopped)
            self._hero_fade_animation = animation
        else:
            self.heroImage.setPixmap(rendered)

    def _apply_native_backdrop(self):
        """Best-effort Windows Acrylic/Mica. Theme remains correct without it."""
        if os.name != "nt" or pywinstyles is None or not theme_bool("effects.native_backdrop", True):
            return
        style = str(theme_value("effects.native_backdrop_style", "acrylic") or "acrylic")
        try:
            pywinstyles.apply_style(self, style)
        except Exception as error:
            print(f"[ui] Native backdrop unavailable ({style}): {error}")

    def _sync_window_controls(self):
        if hasattr(self, "maxButton"):
            maximized = self.isMaximized() or self.isFullScreen()
            self.maxButton.setToolTip(
                "Restore  •  F11 exits fullscreen" if maximized
                else "Maximize / Restore  •  F11 Fullscreen"
            )
            if qta is not None:
                try:
                    icon_name = "ph.corners-in" if maximized else "ph.square"
                    self.maxButton.setIcon(qta.icon(icon_name, color=theme_value("colors.text.muted", "#868A90")))
                    icon_px = theme_int("window_controls.restore_icon_size", 22) if maximized else theme_int("window_controls.icon_size", 18)
                    self.maxButton.setIconSize(QtCore.QSize(icon_px, icon_px))
                    self.maxButton.setText("")
                except Exception:
                    self.maxButton.setText("❐" if maximized else "□")
            else:
                self.maxButton.setText("❐" if maximized else "□")
        if hasattr(self, "sizeGrip"):
            self.sizeGrip.setVisible(not self.isMaximized() and not self.isFullScreen())

    def _refresh_shell_geometry_state(self):
        """Re-evaluate shell/rail corner clipping after maximize/fullscreen changes."""
        expanded = bool(self.isMaximized() or self.isFullScreen())
        outer = 0 if expanded else theme_int("layout.window.outer_margin", 13)
        if hasattr(self, "shell"):
            self.shell.setGeometry(
                outer, outer,
                max(1, self.width() - outer * 2),
                max(1, self.height() - outer * 2),
            )
            self.shell.update()
        if hasattr(self, "sidebar"):
            self.sidebar.update()
        self.update()

    def changeEvent(self, event):
        super().changeEvent(event)
        if event.type() == QtCore.QEvent.Type.WindowStateChange:
            QtCore.QTimer.singleShot(0, self._sync_window_controls)
            QtCore.QTimer.singleShot(0, self._refresh_shell_geometry_state)
            if not self.isMinimized():
                QtCore.QTimer.singleShot(80, self._apply_native_backdrop)

    def toggle_maximize(self):
        if self.isFullScreen() or self.isMaximized():
            self.showNormal()
        else:
            self.showMaximized()
        QtCore.QTimer.singleShot(0, self._sync_window_controls)
        QtCore.QTimer.singleShot(80, self._apply_native_backdrop)

    def toggle_fullscreen(self):
        if self.isFullScreen():
            self.showNormal()
            if self._fullscreen_was_maximized:
                self.showMaximized()
        else:
            self._fullscreen_was_maximized = self.isMaximized()
            self.showFullScreen()
        QtCore.QTimer.singleShot(0, self._sync_window_controls)
        QtCore.QTimer.singleShot(80, self._apply_native_backdrop)

    def mouseDoubleClickEvent(self, event):
        if event.button() == QtCore.Qt.MouseButton.LeftButton and event.position().y() < 70:
            self.toggle_maximize()
            event.accept()
            return
        super().mouseDoubleClickEvent(event)

    def _apply_window_mask(self):
        """Keep smooth anti-aliased corners; never use a 1-bit QRegion mask.

        QRegion masks caused the staircase visible in V3. The shell and left
        rail now clip their own painting with QPainterPath. On Windows 11 we
        additionally request native DWM rounded corners when available.
        """
        self.clearMask()
        if os.name != "nt" or not theme_bool("layout.window.native_rounding", False):
            return
        try:
            import ctypes
            from ctypes import wintypes
            hwnd = wintypes.HWND(int(self.winId()))
            DWMWA_WINDOW_CORNER_PREFERENCE = 33
            DWMWCP_ROUND = ctypes.c_int(2)
            ctypes.windll.dwmapi.DwmSetWindowAttribute(
                hwnd,
                DWMWA_WINDOW_CORNER_PREFERENCE,
                ctypes.byref(DWMWCP_ROUND),
                ctypes.sizeof(DWMWCP_ROUND),
            )
        except Exception:
            # Windows 10 / old DWM: custom anti-aliased painting remains valid.
            pass

    def paintEvent(self, event):
        super().paintEvent(event)
        if self.isMaximized() or self.isFullScreen() or not theme_bool("effects.window_shadow", True):
            return
        outer = theme_int("layout.window.outer_margin", 13)
        if outer <= 1:
            return
        painter = QtGui.QPainter(self)
        painter.setRenderHint(QtGui.QPainter.RenderHint.Antialiasing, True)
        radius = float(theme_value("radius.window", 18))
        layers = max(3, theme_int("effects.window_shadow_layers", 10))
        strength = max(0.0, min(1.0, theme_float("effects.window_shadow_strength", 0.42)))
        base = QtCore.QRectF(outer, outer, max(1, self.width()-outer*2), max(1, self.height()-outer*2))
        for i in range(layers, 0, -1):
            spread = (i / layers) * max(2.0, outer - 1.0)
            alpha = int(58 * strength * (1.0 - (i-1)/layers) ** 1.65)
            rect = base.adjusted(-spread, -spread, spread, spread)
            painter.setPen(QtGui.QPen(QtGui.QColor(0,0,0,alpha), 1.35))
            painter.setBrush(QtCore.Qt.BrushStyle.NoBrush)
            painter.drawRoundedRect(rect, radius + spread * 0.55, radius + spread * 0.55)
        painter.end()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        compact_home = int(self.height()) < 820
        updates_card = getattr(self, "homeUpdatesCard", None)
        if updates_card is not None and updates_card.layout() is not None:
            updates_card.layout().setContentsMargins(
                7 if compact_home else 10,
                4 if compact_home else 7,
                7 if compact_home else 10,
                4 if compact_home else 7,
            )
            updates_card.layout().setSpacing(3 if compact_home else 5)
        for button_name in ("homeUpdateButton", "homeChangelogButton"):
            button = getattr(self, button_name, None)
            if button is not None:
                button.setFixedHeight(36 if compact_home else 40)
        panel_layout = getattr(self, "homePanelLayout", None)
        if panel_layout is not None:
            panel_layout.setSpacing(6 if compact_home else 10)
        updates_value = getattr(self, "homeUpdatesValue", None)
        if updates_value is not None:
            font = updates_value.font()
            font.setPointSizeF(9.0 if compact_home else 9.6)
            updates_value.setFont(font)
            updates_value.setMaximumHeight(52 if compact_home else 62)
        self._apply_window_mask()
        self._sync_window_controls()
        if hasattr(self, "serversScroll"):
            QtCore.QTimer.singleShot(0, self._resize_servers_content)
        if hasattr(self, "settingsScroll") or hasattr(self, "matchmakingScroll"):
            QtCore.QTimer.singleShot(0, self._sync_scroll_clearance)
        if hasattr(self, "demoKeys") and self.demoKeys.isVisible():
            self._position_demo_keys_overlay()
        if hasattr(self, "shell"):
            outer = 0 if (self.isMaximized() or self.isFullScreen()) else theme_int("layout.window.outer_margin", 13)
            self.shell.setGeometry(outer, outer, max(1, self.width() - outer * 2), max(1, self.height() - outer * 2))
        if hasattr(self, "windowControls"):
            self.windowControls.adjustSize()
            self.windowControls.move(max(0, self.shell.width() - self.windowControls.width()), 0)
            self.windowControls.raise_()
        if hasattr(self, "sizeGrip"):
            outer = 0 if (self.isMaximized() or self.isFullScreen()) else theme_int("layout.window.outer_margin", 13)
            self.sizeGrip.move(self.width() - outer - self.sizeGrip.width() - 5,
                               self.height() - outer - self.sizeGrip.height() - 5)
            self.sizeGrip.raise_()
        if hasattr(self, "_hero_urls") and self._hero_urls:
            if getattr(self, "_hero_local", None):
                key = str(self._hero_local[self._hero_index % len(self._hero_local)])
            else:
                key = self._hero_urls[self._hero_index]
            pixmap = self._hero_pixmaps.get(key)
            if pixmap is not None: self._set_hero_pixmap(pixmap)
            elif hasattr(self, "heroImage"):
                QtCore.QTimer.singleShot(0, self._refresh_initial_hero_geometry)

    def _sync_scroll_clearance(self):
        """Align fixed/floating cards with the scroll viewport content edge."""
        def extent(scroll):
            try:
                bar = scroll.verticalScrollBar()
                return max(bar.sizeHint().width(), self.style().pixelMetric(QtWidgets.QStyle.PixelMetric.PM_ScrollBarExtent))
            except Exception:
                return 0
        if hasattr(self, "settingsFooterWrapLayout") and hasattr(self, "settingsScroll"):
            self.settingsFooterWrapLayout.setContentsMargins(4, 0, 20 + extent(self.settingsScroll), 4)
        if hasattr(self, "matchmakingIntroWrapLayout") and hasattr(self, "matchmakingScroll"):
            self.matchmakingIntroWrapLayout.setContentsMargins(0, 0, 18 + extent(self.matchmakingScroll), 0)

    def qerror(self, text):
        QtWidgets.QMessageBox.critical(self, "Q3Elite Launcher", str(text))

    def mousePressEvent(self, event):
        if event.button() == QtCore.Qt.MouseButton.LeftButton and event.position().y() < 70:
            self._drag_pos = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self._drag_pos is not None and event.buttons() & QtCore.Qt.MouseButton.LeftButton:
            if self.isMaximized() or self.isFullScreen():
                self._drag_pos = None
                return
            self.move(event.globalPosition().toPoint() - self._drag_pos)
            event.accept()
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        self._drag_pos = None
        super().mouseReleaseEvent(event)


# ============================================================================
# MAIN
# ============================================================================

install_state = {
    "base_done": False,
    "base_ok": False,

    "q3elite_done": False,
    "q3elite_ok": False,

    "q3elite_update_done": False,
    "q3elite_update_ok": False,

    "post_update_started": False,
    "offline": False,
}


def q3elite_update_offline(reason):
    install_state["offline"] = True
    print(f"[offline] {reason}")


def q3elite_update_result(success, result=None):
    try:
        window._diag_event("q3elite_update_result", {"success": bool(success)})
    except Exception:
        pass
    install_state["q3elite_update_done"] = True
    install_state["q3elite_update_ok"] = success
    update_home_updates("q3elite", result if isinstance(result, dict) else {"status": "error", "update_available": None})

    if not success:
        print()
        print("========================================")
        print(" Q3Elite update FAILED")
        print("========================================")
        print()

        set_gui_error("RETRY")
        window.qerror(
            "Q3Elite update failed.\n"
            "The previous Version.json was kept, so the update can be retried."
        )
        return

    # The Q3Elite manifest/version check is complete; PAK verification follows.
    _activity_set("Q3Elite files checked", "ok", "stage")
    # Existing installation is now accepted for this startup.
    install_state["q3elite_done"] = True
    install_state["q3elite_ok"] = True

    # Continue serially with official PAK verification.
    set_gui_checking("Checking PAKs...")
    fdownload.start()


def base_install_result(success):
    try:
        window._diag_event("pak_verification_result", {"success": bool(success)})
    except Exception:
        pass
    install_state["base_done"] = True
    install_state["base_ok"] = success

    check_install_finished()


def q3elite_install_result(success):
    try:
        window._diag_event("q3elite_install_result", {"success": bool(success)})
    except Exception:
        pass
    install_state["q3elite_done"] = True
    install_state["q3elite_ok"] = success
    install_state["q3elite_update_done"] = True
    install_state["q3elite_update_ok"] = success

    if not success:
        # Q3Elite is the first serial installation stage. If it fails, PAK
        # verification has not started yet, so waiting for base_done here leaves
        # the GUI permanently on INSTALLING. Fail immediately instead.
        if hasattr(window, "firstInstallCard"):
            window.firstInstallCard.setEnabled(True)
        hide_download_controls()
        set_gui_error("RETRY")
        window.qerror(
            "Q3Elite Basic installation failed.\n"
            "Check the launcher log for the exact file/error."
        )
        return

    # FirstLaunch.bat logic is now owned by the launcher.
    try:
        configure_reshade_vulkan(True, install_files=True)
        window.vulkanLayerBox.setChecked(True)
    except Exception as error:
        print(f"[warning] ReShade Vulkan layer setup failed: {error}")
        # ReShade is optional; do not invalidate the game installation.

    # On first install PAK verification starts only AFTER Basic has finished.
    if not install_state["base_done"] and not fdownload.isRunning():
        set_gui_checking("Checking PAKs...")
        fdownload.start()
        return

    check_install_finished()


def check_install_finished():

    # Wait for PAK verification AND Q3Elite extraction.
    if not (
        install_state["base_done"]
        and install_state["q3elite_done"]
    ):
        return

    # One of the two installation stages failed.
    if not (
        install_state["base_ok"]
        and install_state["q3elite_ok"]
    ):

        print()
        print("========================================")
        print(" Q3Elite installation FAILED")
        print("========================================")
        print()

        set_gui_error("RETRY")
        window.qerror(
            "Q3Elite installation failed.\n"
            "Check the installation log."
        )

        return

    # Prevent starting the post-update thread twice.
    if install_state["post_update_started"]:
        return

    install_state["post_update_started"] = True

    print()
    print("========================================")
    print(" Base installation complete")
    print(" Starting post-install updates...")
    print("========================================")
    print()

    post_update.start()


def post_update_offline(reason):
    install_state["offline"] = True
    print(f"[offline] {reason}")


def post_update_result(success):
    try:
        window._diag_event("post_install_update_result", {"success": bool(success)})
    except Exception:
        pass

    if not success:

        print()
        print("========================================")
        print(" Post-install update FAILED")
        print("========================================")
        print()

        window.qerror(
            "Q3Elite update failed.\n"
            "Check the installation log."
        )

        return

    print()
    print("========================================")
    print(" Q3Elite installation complete")
    print("========================================")
    print()

    # Keep the merged launcher alive. This is now the persistent launcher.
    _activity_set("Installation ready", "ok", "final")
    set_gui_ready(offline=install_state["offline"])
    if getattr(window, "_home_update_sequence_waiting", False):
        window._home_update_sequence_waiting = False
        QtCore.QTimer.singleShot(150, window._run_home_update_sequence_step)


def _activate_existing_launcher():
    """Send an activation request to the already-running launcher process."""
    server_name = "Q3EliteLauncher-" + hashlib.sha1(str(LAUNCHER_DATA_DIR).casefold().encode("utf-8")).hexdigest()[:16]
    for _attempt in range(12):
        socket = QtNetwork.QLocalSocket()
        socket.connectToServer(server_name, QtCore.QIODevice.OpenModeFlag.WriteOnly)
        if socket.waitForConnected(120):
            socket.write(b"ACTIVATE")
            socket.waitForBytesWritten(300)
            socket.disconnectFromServer()
            return True
        socket.abort()
        time.sleep(0.08)
    return False


def _start_instance_activation_server():
    """Listen for activation requests from later launcher invocations."""
    server_name = "Q3EliteLauncher-" + hashlib.sha1(str(LAUNCHER_DATA_DIR).casefold().encode("utf-8")).hexdigest()[:16]
    server = QtNetwork.QLocalServer()
    QtNetwork.QLocalServer.removeServer(server_name)
    if not server.listen(server_name):
        print(f"[instance] Could not start activation server: {server.errorString()}")
        return None

    def accept_connections():
        while server.hasPendingConnections():
            client = server.nextPendingConnection()
            if client is None:
                continue
            def receive_request(sock=client):
                payload = bytes(sock.readAll()).decode("utf-8", errors="ignore")
                if "ACTIVATE" in payload:
                    target = globals().get("window")
                    if target is not None:
                        target.restore_from_tray()
                    else:
                        globals()["_instance_activation_pending"] = True
                sock.disconnectFromServer()
            client.readyRead.connect(receive_request)
            client.disconnected.connect(client.deleteLater)
    server.newConnection.connect(accept_connections)
    return server


def main():
    global app, window, download_timer, ui_theme, instance_server
    global launcher_self_update, q3elite_update, fdownload, q3elite_download, post_update

    # Fine-grained startup timings. Existing cumulative fields are retained for
    # compatibility with older logs; these values measure individual stages.
    _q3_main_t0 = time.perf_counter()
    _q3_startup_profile = {
        "import_ms": (_q3_main_t0 - _Q3_IMPORT_T0) * 1000.0,
        "qapp_create_ms": 0.0,
        "theme_create_ms": 0.0,
        "theme_apply_ms": 0.0,
        "window_construct_ms": 0.0,
        "pre_show_ms": 0.0,
        "show_call_ms": 0.0,
        "first_paint_ms": None,
        "event_loop_ready_ms": None,
    }

    try:
        # Qt 6 renders text/widgets at the monitor's native device-pixel ratio.
        # PassThrough avoids extra rounding at fractional Windows scaling (125/150%).
        try:
            QtGui.QGuiApplication.setHighDpiScaleFactorRoundingPolicy(
                QtCore.Qt.HighDpiScaleFactorRoundingPolicy.PassThrough
            )
        except Exception:
            pass
        _q3_stage_t0 = time.perf_counter()
        app = QApplication(sys.argv)
        _q3_startup_profile["qapp_create_ms"] = (time.perf_counter() - _q3_stage_t0) * 1000.0
        _q3_qapp_ms = (time.perf_counter() - _Q3_IMPORT_T0) * 1000.0
        icon_path = APP_ICON_ICO if APP_ICON_ICO.is_file() else APP_ICON_PNG
        if icon_path.is_file():
            app.setWindowIcon(QtGui.QIcon(str(icon_path)))

        # Prevent a second launcher process from starting.
        instance_dir = LAUNCHER_DATA_DIR
        instance_dir.mkdir(parents=True, exist_ok=True)
        instance_lock = QLockFile(str(instance_dir / "Q3EliteLauncher.lock"))
        instance_lock.setStaleLockTime(0)
        if not instance_lock.tryLock(100):
            if _activate_existing_launcher():
                return 0
            print("Q3Elite Launcher is already running, but the active window could not be reached.")
            return 0

        instance_server = _start_instance_activation_server()

        # Identity layer -----------------------------------------------------
        # `Themes/active.json` chooses the current theme. Use --ui-dev for
        # Ctrl+S hot reload while tuning tokens/QSS.
        _q3_stage_t0 = time.perf_counter()
        ui_theme = ThemeManager(
            app,
            launcher_dir=LAUNCHER_DIR,
            assets_dir=ASSETS_DIR,
            dev_mode=("--ui-dev" in sys.argv),
        )
        _q3_startup_profile["theme_create_ms"] = (time.perf_counter() - _q3_stage_t0) * 1000.0

        _q3_stage_t0 = time.perf_counter()
        ui_theme.apply()
        _q3_startup_profile["theme_apply_ms"] = (time.perf_counter() - _q3_stage_t0) * 1000.0

        _q3_theme_ms = (time.perf_counter() - _Q3_IMPORT_T0) * 1000.0
        _q3_stage_t0 = time.perf_counter()
        window = ModernLauncherWindow()
        window._restore_saved_window_geometry()
        if globals().pop("_instance_activation_pending", False):
            QtCore.QTimer.singleShot(0, window.restore_from_tray)
        _q3_startup_profile["window_construct_ms"] = (time.perf_counter() - _q3_stage_t0) * 1000.0
        _q3_window_ms = (time.perf_counter() - _Q3_IMPORT_T0) * 1000.0
        # Stop diagnostics immediately after construction; no event-filter
        # overhead remains during show(), first paint or normal interaction.
        try:
            app.removeEventFilter(window._startup_qt_event_probe)
        except Exception:
            pass

        # Full-tree font polish is an O(number of widgets) GUI-thread walk.
        # It changes rendering hints only, not font sizes or weights. Defer it
        # until after the first visible frame so it cannot delay first paint.
        _q3_polish_state = {"ms": 0.0, "widgets": 0}
        _q3_pre_show_t0 = time.perf_counter()
        _q3_mask_start = time.perf_counter()
        window._apply_window_mask()
        _q3_mask_ms = (time.perf_counter() - _q3_mask_start) * 1000.0
        ui_theme.themeReloaded.connect(window.apply_runtime_theme)

        # Capture uncaught Qt/Python callback exceptions into the local crash
        # store. The normal Python exception hook still runs afterwards.
        _original_excepthook = sys.excepthook
        def _q3elite_excepthook(exc_type, exc_value, exc_tb):
            try:
                window.diagnosticsManager.capture_exception(
                    exc_type, exc_value, exc_tb, context=window._diagnostics_context()
                )
            except Exception:
                pass
            try:
                _original_excepthook(exc_type, exc_value, exc_tb)
            except Exception:
                pass
        sys.excepthook = _q3elite_excepthook

        window._diag_event(
            "launcher_started",
            {
                "autostart": "--autostart" in sys.argv,
                "theme": str(getattr(ui_theme, "theme_name", "unknown")),
                "python": platform.python_version(),
                "os": platform.platform(),
            },
        )
        QtCore.QTimer.singleShot(5000, window._flush_diagnostics_background)

        # Observe the first top-level paint without changing widget behavior.
        # This separates "show() returned" from the first frame actually painted.
        class _Q3StartupPaintProbe(QtCore.QObject):
            def eventFilter(self, watched, event):
                if (event.type() == QtCore.QEvent.Type.Paint
                        and _q3_startup_profile["first_paint_ms"] is None):
                    _q3_startup_profile["first_paint_ms"] = (
                        time.perf_counter() - _Q3_IMPORT_T0
                    ) * 1000.0
                return False

        _q3_startup_paint_probe = _Q3StartupPaintProbe(app)
        if _Q3_PROFILE_ENABLED:
            window.installEventFilter(_q3_startup_paint_probe)

        autostart_mode = "--autostart" in sys.argv
        start_minimized = launcher_settings.get("start_minimized", False)
        if autostart_mode and start_minimized and QtWidgets.QSystemTrayIcon.isSystemTrayAvailable():
            window.trayIcon.show()
            window.hide()
        else:
            _q3_startup_profile["pre_show_ms"] = (time.perf_counter() - _q3_pre_show_t0) * 1000.0
            _q3_show_t0 = time.perf_counter()
            if launcher_settings.get("fullscreen_mode", False):
                window.showFullScreen()
            else:
                window.show()
            _q3_startup_profile["show_call_ms"] = (time.perf_counter() - _q3_show_t0) * 1000.0
            _q3_shown_ms = (time.perf_counter() - _Q3_IMPORT_T0) * 1000.0
            # Record import/theme/window construction milestones asynchronously.
            # This helps distinguish Python import cost from UI construction cost.
            def _write_startup_profile():
                try:
                    profile_dir = LAUNCHER_DATA_DIR / "logs"
                    profile_dir.mkdir(parents=True, exist_ok=True)
                    profile_file = profile_dir / "startup_profile.log"
                    with profile_file.open("a", encoding="utf-8") as _log:
                        _log.write(
                            f"{datetime.datetime.now().isoformat(timespec='seconds')} "
                            f"theme={getattr(ui_theme, 'theme_name', 'unknown')} "
                            f"imports={_q3_startup_profile['import_ms']:.0f}ms "
                            f"qapp_create={_q3_startup_profile['qapp_create_ms']:.0f}ms "
                            f"theme_create={_q3_startup_profile['theme_create_ms']:.0f}ms "
                            f"theme_apply={_q3_startup_profile['theme_apply_ms']:.0f}ms "
                            f"window_construct={_q3_startup_profile['window_construct_ms']:.0f}ms "
                            f"pre_show={_q3_startup_profile['pre_show_ms']:.0f}ms "
                            f"show_call={_q3_startup_profile['show_call_ms']:.0f}ms "
                            f"first_paint={_q3_startup_profile['first_paint_ms'] if _q3_startup_profile['first_paint_ms'] is not None else -1:.0f}ms "
                            f"event_loop_ready={_q3_startup_profile['event_loop_ready_ms'] if _q3_startup_profile['event_loop_ready_ms'] is not None else -1:.0f}ms "
                            f"qapp_cumulative={_q3_qapp_ms:.0f}ms theme_cumulative={_q3_theme_ms:.0f}ms "
                            f"window_cumulative={_q3_window_ms:.0f}ms shown_cumulative={_q3_shown_ms:.0f}ms "
                            f"mask={_q3_mask_ms:.0f}ms "
                            f"deferred_font_polish={_q3_polish_state['ms']:.0f}ms "
                            f"widgets={_q3_polish_state['widgets']} "
                            f"qt_event_counts={';'.join(f'{event_name}:{getattr(window, '_startup_qt_event_counts', {}).get(int(event_type), 0)}' for event_type, event_name in ((QtCore.QEvent.Type.Polish, 'Polish'), (QtCore.QEvent.Type.PolishRequest, 'PolishRequest'), (QtCore.QEvent.Type.LayoutRequest, 'LayoutRequest'), (QtCore.QEvent.Type.ChildAdded, 'ChildAdded'), (QtCore.QEvent.Type.StyleChange, 'StyleChange'), (QtCore.QEvent.Type.FontChange, 'FontChange'), (QtCore.QEvent.Type.Resize, 'Resize'), (QtCore.QEvent.Type.Show, 'Show'))) } "
                            f"components={';'.join(f'{name}:{duration:.0f}ms' for name, duration in getattr(window, '_startup_component_timings', []))} "
                            f"event_ops={';'.join(f'{name}[{delta}]' for name, delta in getattr(window, '_startup_qt_event_deltas', []))}\n"
                        )
                except Exception:
                    pass
            def _mark_event_loop_ready():
                _q3_startup_profile["event_loop_ready_ms"] = (time.perf_counter() - _q3_main_t0) * 1000.0

            if _Q3_PROFILE_ENABLED:
                QtCore.QTimer.singleShot(0, _mark_event_loop_ready)
                QtCore.QTimer.singleShot(2500, _write_startup_profile)
            QtCore.QTimer.singleShot(1200, window.prepare_launcher_sounds)
            if (launcher_settings.get("launcher_sounds_enabled", False)
                    and launcher_settings.get("launcher_startup_sound_enabled", False)):
                QtCore.QTimer.singleShot(1600, lambda: window._play_launcher_sound("startup"))
            # ThemeManager.apply() already established the application font and
            # stylesheet. A second full apply_runtime_theme() here used to clear all
            # Obsidian caches and walk/repaint the complete widget tree immediately
            # after the first frame, producing the visible freeze/restart effect.
            # Only the HWND-dependent native backdrop needs a post-show pass.
            QtCore.QTimer.singleShot(0, window._apply_native_backdrop)

        # QApplication's default font already carries the configured rendering
        # hints. Avoid a second O(widget-count) setFont walk after first paint.

        download_timer = QtCore.QTimer(window)
        download_timer.timeout.connect(update_download_overlay)
        download_timer.start(200)

        # Low-priority Telegram warm-up: detached top-level WebEngine renderers
        # load the newest three posts sequentially after the launcher has been
        # idle for a few seconds. The launcher itself never embeds Chromium; it
        # receives ordinary Qt pixmap snapshots, avoiding DWM's translucent-HWND
        # restart/redraw effect while preserving real animated custom emoji.
        if TELEGRAM_WEBENGINE_AVAILABLE and theme_bool("performance.telegram_webengine_prewarm", True):
            QtCore.QTimer.singleShot(
                max(1500, theme_int("performance.telegram_webengine_prewarm_delay_ms", 3500)),
                window._prewarm_latest_telegram_posts,
            )

        # Check the newest public Q3News post independently from the versioned
        # Changelog feed. This is a lightweight one-page request in the background.
        if not launcher_settings.get("disable_q3news_notifications", False):
            q3news_notification_worker = Q3NewsWorker(before=None, limit=1, parent=window)
            window._q3news_notification_worker = q3news_notification_worker
            q3news_notification_worker.result_ready.connect(
                lambda ok, rows: window._refresh_q3news_notification(rows, success=ok)
            )
            q3news_notification_worker.finished.connect(q3news_notification_worker.deleteLater)
            q3news_notification_worker.start()

        # Create every worker BEFORE starting the first one.
        # A very fast self-update check can emit "continue" immediately, and
        # start_game_checks() expects q3elite_download/q3elite_update/fdownload
        # to already exist.
        q3elite_update = Q3EliteUpdate()
        fdownload = FDownload()
        q3elite_download = Q3EliteDownload()
        post_update = PostInstallUpdate()
        launcher_self_update = LauncherSelfUpdate()

        launcher_self_update.result_ready.connect(launcher_self_update_result)
        q3elite_update.result_ready.connect(q3elite_update_result)
        q3elite_update.offline.connect(q3elite_update_offline)
        fdownload.result_ready.connect(base_install_result)
        q3elite_download.result_ready.connect(q3elite_install_result)
        post_update.result_ready.connect(post_update_result)
        post_update.offline.connect(post_update_offline)
        post_update.update_checked.connect(lambda data: update_home_updates("osp2be", data if isinstance(data, dict) else None))

        set_gui_checking("Checking Launcher...")

        # Start only after QApplication enters its event loop. This removes the
        # initialization race between the self-update signal and main().
        QtCore.QTimer.singleShot(0, launcher_self_update.start)

        sys.exit(app.exec())

    except Exception as error:
        try:
            if "window" in globals() and window is not None and hasattr(window, "diagnosticsManager"):
                window.diagnosticsManager.capture_exception(
                    type(error), error, error.__traceback__, context=window._diagnostics_context()
                )
        except Exception:
            pass
        message = (
            f"{type(error).__name__}: {error}\n"
            "If the problem remains after restart, check the launcher log."
        )
        try:
            if "app" in globals() and app is not None:
                QtWidgets.QMessageBox.critical(None, "Q3Elite Launcher", message)
            else:
                print(message)
        except Exception:
            print(message)
        raise


# Explicit entry point for the standalone .pyw launcher.
if __name__ == "__main__":
    main()
