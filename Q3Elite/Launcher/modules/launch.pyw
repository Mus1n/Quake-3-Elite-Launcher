        if qta is not None: self.serverPrevButton.setIconSize(QtCore.QSize(20,20))
        else: self.serverPrevButton.setText("‹")
        self.serverPrevButton.clicked.connect(lambda: self.scroll_server_monitors(-1))
        nav.addWidget(self.serverPrevButton)
        self.serverPositionLabel = QtWidgets.QLabel("")
        self.serverPositionLabel.setObjectName("serverCarouselPosition")
        self.serverPositionLabel.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        self.serverPositionLabel.setMinimumWidth(88)
        nav.addWidget(self.serverPositionLabel)
        self.serverNextButton = ThemedIconButton("ph.caret-right", "servers.carousel_icon", "servers.carousel_icon_hover")
        self.serverNextButton.setObjectName("serverCarouselButton")
        self.serverNextButton.setFixedSize(carousel_size, carousel_size)
        self.serverNextButton.setToolTip("Next server  •  Right Arrow")
        if qta is not None: self.serverNextButton.setIconSize(QtCore.QSize(20,20))
        else: self.serverNextButton.setText("›")
        self.serverNextButton.clicked.connect(lambda: self.scroll_server_monitors(1))
        nav.addWidget(self.serverNextButton)
        nav.addStretch(1)
        root.addLayout(nav)

        self.serverConfigPath = USER_SERVERS_FILE
        if not self.serverConfigPath.is_file():
            self.serverConfigPath.parent.mkdir(parents=True, exist_ok=True)
            if launcher_settings.get("server_region_initialized", False):
                initial = _server_route_entries(
                    launcher_settings.get("server_region_en", True),
                    launcher_settings.get("server_region_ru", False),
                    launcher_settings.get("server_preset_ids", SERVER_DEFAULT_PRESET_IDS),
                )
                server_monitor.save_custom_servers(self.serverConfigPath, initial)
            else:
                # First visit intentionally starts with no managed routes; the
                # compact LOAD SERVERS dialog is the only preset editor.
                server_monitor.save_custom_servers(self.serverConfigPath, [])
        self.serverLevelshotsDir = MAP_LEVELSHOTS_DIR
        self.serverCards = []
        self.serverQueryWorker = None
        self._server_details_queue = []
        self._server_details_timer = QtCore.QTimer(self)
        self._server_details_timer.setSingleShot(True)
        self._server_details_timer.timeout.connect(self._process_next_server_detail)
        self._serverScrollAccum = 0
        self._serverCarouselIndex = 0
        self._serverCardStep = 1
        self._serverVisibleCount = 5
        self.serverRefreshTimer = QtCore.QTimer(self)
        self.serverRefreshTimer.setInterval(30000)
        self.serverRefreshTimer.timeout.connect(self._auto_refresh_servers)
        # Construct server cards in small GUI-thread batches. This keeps the
        # first Servers visit responsive instead of creating every card at once.
        self._reload_server_cards(deferred=True)
        if not launcher_settings.get("server_region_initialized", False):
            self.serverRefreshLabel.setText("No official preset loaded • click LOAD SERVERS.")
        return page

    def _add_server_card(self, server):
        _card_started = time.perf_counter()
        card = ServerCard(
            server, self.serverLevelshotsDir, self.serversContent,
            profile_callback=self._q3_write_section_profile,
        )
        _card_construct_ms = (time.perf_counter() - _card_started) * 1000.0
        _bind_started = time.perf_counter()
        card.connectRequested.connect(self.connect_to_server)
        card.copyRequested.connect(self.copy_server_address)
        card.removeRequested.connect(self.remove_custom_server)
        card.moveRequested.connect(self.move_server)
        card.aliasRequested.connect(self.alias_server)
        card.wheelRequested.connect(self.scroll_server_monitors)
        _card_bind_ms = (time.perf_counter() - _bind_started) * 1000.0
        self.serverCards.append(card)
        self.serversRow.addWidget(card)
        _filter_started = time.perf_counter()
        card.installEventFilter(self)
        _card_child_count = 0
        for child in card.findChildren(QtWidgets.QWidget):
            _card_child_count += 1
            child.installEventFilter(self)
        self._q3_write_section_profile(
            "server_card_build", "servers",
            construct_ms=_card_construct_ms, bind_ms=_card_bind_ms,
            event_filter_ms=(time.perf_counter() - _filter_started) * 1000.0,
            child_widgets=_card_child_count,
            total_ms=(time.perf_counter() - _card_started) * 1000.0,
        )

    def _finish_server_cards_build(self):
        if not self.serverCards:
            empty = QtWidgets.QLabel("No servers configured.\nUse LOAD SERVERS or + ADD SERVER.")
            empty.setObjectName("serverEmpty")
            empty.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
            empty.setWordWrap(True)
            empty.setSizePolicy(
                QtWidgets.QSizePolicy.Policy.Expanding,
                QtWidgets.QSizePolicy.Policy.Expanding,
            )
            self.serversRow.setAlignment(QtCore.Qt.AlignmentFlag(0))
            self.serversRow.addWidget(empty, 1)
        else:
            self.serversRow.setAlignment(
                QtCore.Qt.AlignmentFlag.AlignLeft | QtCore.Qt.AlignmentFlag.AlignTop
            )
        self._resize_servers_content()
        if hasattr(self, "editServersButton"):
            self.set_server_edit_mode(self.editServersButton.isChecked())
        self._update_server_position_label()
        if getattr(self, "_server_refresh_pending", False):
            self._server_refresh_pending = False
            self.refresh_servers()

    def _build_server_cards_batch(self, generation):
        if generation != getattr(self, "_server_card_build_generation", -1):
            return
        _batch_started = time.perf_counter()
        queue = getattr(self, "_server_card_build_queue", [])
        # One card per event-loop turn bounds synchronous widget construction.
        # Levelshot decode/blur is cached, so repeated refreshes do not pay that
        # cost again and the UI can process input between cards.
        _batch_count = min(1, len(queue))
        for _ in range(_batch_count):
            self._add_server_card(queue.pop(0))
        self._q3_write_section_profile(
            "server_cards_batch", "servers",
            batch_ms=(time.perf_counter() - _batch_started) * 1000.0,
            cards=_batch_count, remaining=len(queue),
        )
        if queue:
            QtCore.QTimer.singleShot(8, lambda g=generation: self._build_server_cards_batch(g))
            return
        self._server_cards_building = False
        self._server_card_build_queue = []
        _started = getattr(self, "_server_card_build_started", None)
        if _started is not None:
            self._q3_write_section_profile(
                "server_cards_complete", "servers",
                total_ms=(time.perf_counter() - _started) * 1000.0,
                cards=len(self.serverCards),
            )
            self._server_card_build_started = None
        self._finish_server_cards_build()

    def _reload_server_cards(self, *, deferred=False):
        generation = int(getattr(self, "_server_card_build_generation", 0)) + 1
        self._server_card_build_generation = generation
        self._server_cards_building = False
        self._server_refresh_pending = False
        if hasattr(self, "_server_details_timer"):
            self._server_details_timer.stop()
        if hasattr(self, "_server_details_queue"):
            self._server_details_queue.clear()
        self._server_card_build_started = None
        self._server_card_build_queue = []
        while self.serversRow.count():
            item = self.serversRow.takeAt(0)
            widget = item.widget()
            if widget is not None:
                try:
                    timer = getattr(widget, "_bg_timer", None)
                    if timer is not None:
                        timer.stop()
                    for view in widget.findChildren(QtWidgets.QAbstractItemView):
                        delegate = view.itemDelegate()
                        if delegate is not None:
                            try:
                                view.viewport().removeEventFilter(delegate)
                            except RuntimeError:
                                pass
                    widget.removeEventFilter(self)
                    for child in widget.findChildren(QtWidgets.QWidget):
                        child.removeEventFilter(self)
                except RuntimeError:
                    pass
                widget.setParent(None)
                widget.deleteLater()
        self.serverCards = []
        self._serverCarouselIndex = 0
        self.configuredServers = server_monitor.load_servers(self.serverConfigPath)
        # Server monitor refreshes/reloads can happen without changing the
        # configured route catalogue. Keep Matchmaking's editor tree intact
        # unless addresses/order/aliases actually changed.
        editor_servers = getattr(self, "_matchmaking_editor_servers", None)
        if editor_servers is not None:
            old_signature = self._server_catalog_signature(editor_servers)
            new_signature = self._server_catalog_signature(self.configuredServers)
            if old_signature != new_signature:
                self._matchmaking_editor_servers = None
                self._matchmaking_editor_server_signature = new_signature

        if deferred and self.configuredServers:
            self._server_card_build_started = time.perf_counter()
            self._server_card_build_queue = list(self.configuredServers)
            self._server_cards_building = True
            self._build_server_cards_batch(generation)
            return

        for server in self.configuredServers:
            self._add_server_card(server)
        self._finish_server_cards_build()

    def _resize_servers_content(self):
        count = max(1, len(self.serverCards))
        spacing = self.serversRow.spacing()
        viewport_w = max(1, self.serversScroll.viewport().width())
        preferred_card_w = max(220, min(280, theme_int("servers.card_width", 250)))
        # Decide how many whole cards fit, then calculate their width so the
        # next card starts exactly outside the viewport (never show half a card).
        visible = max(4, (viewport_w + spacing) // (preferred_card_w + spacing))
        card_w = max(120, (viewport_w - max(0, visible - 1) * spacing) // visible)
        self._serverVisibleCount = min(max(1, len(self.serverCards)), visible)
        viewport_h = self.serversScroll.viewport().height()
        height = max(430, viewport_h - 2)
        for card in self.serverCards:
            card.setFixedWidth(card_w)
            card.setFixedHeight(height - 6)
        width = count * card_w + max(0, count - 1) * spacing
        self.serversContent.setFixedSize(max(viewport_w, width), height)
        self._serverCardStep = max(1, card_w + spacing)
        max_index = max(0, len(self.serverCards) - self._serverVisibleCount)
        self._serverCarouselIndex = max(0, min(int(getattr(self, "_serverCarouselIndex", 0)), max_index))
        if hasattr(self, "serversScroll"):
            target = min(
                self.serversScroll.horizontalScrollBar().maximum(),
                self._serverCarouselIndex * self._serverCardStep,
            )
            self.serversScroll.horizontalScrollBar().setValue(target)
        self._update_server_position_label()

    def set_server_edit_mode(self, enabled):
        for card in self.serverCards:
            card.set_edit_mode(enabled)
        if hasattr(self, "editServersButton"):
            self.editServersButton.setText("DONE" if enabled else "EDIT")

    def scroll_server_monitors(self, direction):
        """Move exactly one complete server card left/right and snap to it."""
        cards = getattr(self, "serverCards", [])
        visible = max(1, int(getattr(self, "_serverVisibleCount", 3)))
        max_index = max(0, len(cards) - visible)
        if max_index <= 0:
            return
        step = 1 if int(direction) > 0 else -1
        current = int(getattr(self, "_serverCarouselIndex", 0))
        target_index = max(0, min(max_index, current + step))
        if target_index == current:
            return
        self._serverCarouselIndex = target_index
        pixel_step = max(1, int(getattr(self, "_serverCardStep", 1)))
        target_value = min(
            self.serversScroll.horizontalScrollBar().maximum(),
            target_index * pixel_step,
        )
        self.serversScroll.horizontalScrollBar().setValue(target_value)
        self._update_server_position_label()

    def _update_server_position_label(self):
        cards = getattr(self, "serverCards", [])
        visible = max(1, int(getattr(self, "_serverVisibleCount", 3)))
        max_index = max(0, len(cards) - visible)
        index = max(0, min(int(getattr(self, "_serverCarouselIndex", 0)), max_index))
        enabled = max_index > 0
        if hasattr(self, "serverPrevButton"):
            self.serverPrevButton.setEnabled(enabled and index > 0)
            self.serverNextButton.setEnabled(enabled and index < max_index)
        if hasattr(self, "serverPositionLabel"):
            if not cards:
                text = "0 SERVERS"
            elif enabled:
                first = index + 1
                last = min(len(cards), index + visible)
                text = f"{first}–{last} / {len(cards)}"
            else:
                text = f"{len(cards)} SERVER{'S' if len(cards) != 1 else ''}"
            self.serverPositionLabel.setText(text)

    def refresh_servers(self):
        if getattr(self, "_server_cards_building", False):
            self._server_refresh_pending = True
            return
        for card in getattr(self, "serverCards", []):
            card.update_install_state()
        if not launcher_settings.get("server_region_initialized", False):
            self.serverRefreshLabel.setText("No official preset loaded • click LOAD SERVERS.")
            return
        if self.serverQueryWorker is not None and self.serverQueryWorker.isRunning():
            return
        if not self.configuredServers:
            self.serverRefreshLabel.setText("No servers in servers.json")
            return
        self.serverRefreshLabel.setText("Refreshing servers…")
        self.refreshServersButton.setEnabled(False)
        visual_servers = [dict(card.server) for card in self.serverCards]
        self.serverQueryWorker = ServerQueryWorker(visual_servers, self)
        self.serverQueryWorker.serverReady.connect(self._server_result_ready)
        self.serverQueryWorker.batchFinished.connect(self._server_refresh_finished)
        self.serverQueryWorker.start()

    def _server_result_ready(self, index, result):
        if 0 <= index < len(self.serverCards):
            card = self.serverCards[index]
            # Apply status/telemetry immediately, but queue player-table creation
            # and first-time levelshot blur so the initial navigation paint can run.
            card.apply_result(result, defer_ms=None)
            if card not in self._server_details_queue:
                self._server_details_queue.append(card)
            if not self._server_details_timer.isActive():
                self._server_details_timer.start(35)

    def _process_next_server_detail(self):
        if not self._server_details_queue:
            return
        card = self._server_details_queue.pop(0)
        try:
            card._apply_pending_server_details()
        except RuntimeError:
            pass
        if self._server_details_queue:
            # One card per event-loop turn; leave a small gap for painting/input.
            self._server_details_timer.start(35)

    def _server_refresh_finished(self):
        self.serverRefreshLabel.setText("Auto refresh every 30 seconds")
        self.refreshServersButton.setEnabled(True)

    def _auto_refresh_servers(self):
        if self.pages.currentWidget() is not self.serversPage:
            return
        if launcher_settings.get("pause_server_refresh_unfocused", False) and not self.isActiveWindow():
            self.serverRefreshLabel.setText("Auto refresh paused — Launcher out of focus")
            return
        self.refresh_servers()

    def add_custom_server(self):
        address, ok = QtWidgets.QInputDialog.getText(
            self, "Add Quake 3 server", "Server address (host:port):",
            QtWidgets.QLineEdit.EchoMode.Normal, ""
        )
        if not ok or not address.strip():
            return
        try:
            host, port = server_monitor.split_address(address.strip())
            normalized = f"{host}:{port}"
        except Exception:
            self.qerror("Invalid server address.\nUse host:port, for example q3msk.net:27977")
            return
        name, ok_name = QtWidgets.QInputDialog.getText(
            self, "Server name", "Display name (optional):",
            QtWidgets.QLineEdit.EchoMode.Normal, normalized
        )
        if not ok_name:
            return
        current = server_monitor.load_servers(self.serverConfigPath)
        if any(str(x.get("address","")).lower() == normalized.lower() for x in current):
            self.qerror("This server is already in the monitor.")
            return
        current.append({"name": name.strip() or normalized, "address": normalized})
        server_monitor.save_custom_servers(self.serverConfigPath, current)
        self._reload_server_cards()
        self.refresh_servers()

    def remove_custom_server(self, address):
        # The REMOVE button is muted in the generic QApplication/widget event
        # filters (the same event can reach both filters). Emit one deliberate
        # click sound here, then suppress hover sounds while replacement cards
        # are rebuilt beneath the stationary pointer.
        self._play_launcher_sound("click")
        self._launcherSfxSuppressHoverUntil = time.monotonic() + 3.0
        current = server_monitor.load_servers(self.serverConfigPath)
        current = [x for x in current if str(x.get("address","")).lower() != str(address).lower()]
        server_monitor.save_custom_servers(self.serverConfigPath, current)
        self._reload_server_cards()
        self.refresh_servers()

    def alias_server(self, address):
        current = server_monitor.load_servers(self.serverConfigPath)
        index = next((i for i, x in enumerate(current)
                      if str(x.get("address","")).lower() == str(address).lower()), -1)
        if index < 0:
            return
        old = str(current[index].get("name", "") or "")
        alias, ok = QtWidgets.QInputDialog.getText(
            self, "Server alias", "Custom server name:",
            QtWidgets.QLineEdit.EchoMode.Normal, old
        )
        if not ok:
            return
        alias = _q3_plain_ascii(alias)
        current[index]["name"] = alias
        server_monitor.save_custom_servers(self.serverConfigPath, current)
        self._reload_server_cards()
        self.refresh_servers()

    def move_server(self, address, direction):
        current = server_monitor.load_servers(self.serverConfigPath)
        index = next((i for i, x in enumerate(current)
                      if str(x.get("address","")).lower() == str(address).lower()), -1)
        if index < 0 or len(current) < 2:
            return
        target = (index + int(direction)) % len(current)
        item = current.pop(index)
        current.insert(target, item)
        server_monitor.save_custom_servers(self.serverConfigPath, current)
        self._reload_server_cards()

    def copy_server_address(self, address):
        QApplication.clipboard().setText(str(address))
        self.serverRefreshLabel.setText(f"Copied: {address}")

    def connect_to_server(self, address):
        address = str(address or "").strip()
        if not address:
            return
        if not q3elite_is_installed():
            self.qerror("Install Quake 3 Elite before connecting to a server.")
            return

        launcher_bat = GAME_ROOT / "Q3Elite" / "Engines" / "Q3Elite (Vulkan) - Cinematic.bat"
        if not launcher_bat.is_file():
            self.qerror(f"Q3Elite Vulkan launcher was not found:\n{launcher_bat}")
            return

        self._play_launcher_sound("start_button")
        ignored_pids = {pid for pid, _name in self._running_xq3e_processes()}
        launched_at = datetime.datetime.now(datetime.timezone.utc).isoformat()

        try:
            import subprocess
            # Pass exactly two extra BAT arguments:
            #   +connect "ip:port"
            # The BAT's trailing %* appends them to XQ3E_Vulkan.x64.exe.
            subprocess.Popen(
                [str(launcher_bat), "+connect", address],
                cwd=str(launcher_bat.parent),
                shell=True,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
            self.serverRefreshLabel.setText(f"Connecting to {address}…")
            managed = next((x for x in SERVER_ROUTE_PRESETS if str(x.get("address") or "").casefold() == address.casefold()), None)
            self._diag_event(
                "server_connect",
                {
                    "official": bool(managed),
                    "preset": str((managed or {}).get("preset_id") or "custom"),
                    "route": str((managed or {}).get("route_label") or ""),
                },
            )
            self._diag_event("game_started", {"source": "server_connect"})
            detached_started = self._start_detached_game_session_tracker(
                ignored_pids,
                launched_at,
            )
            if not detached_started:
                self._start_game_session_watch(ignored_pids)
            self._apply_game_launch_behavior(detached_started)
        except Exception as error:
            self._diag_event("game_launch_failed", {"source": "server_connect", "error": str(error)})
            self.qerror(f"Could not connect to server:\n{error}")


    def _latest_telegram_sources(self, limit=None):
        limit = max(1, min(6, int(limit or theme_int("performance.changelog_latest_posts", 3))))
        entries = read_changelog_entries()
        from datetime import datetime
        def _key(item):
            value = str(item.get("date", item.get("release_date", "")))
            for fmt in ("%Y-%m-%d", "%Y/%m/%d", "%d.%m.%Y"):
                try:
                    return datetime.strptime(value[:10], fmt)
                except ValueError:
                    pass
            return datetime.min
        urls = []
        for release in sorted(entries, key=_key, reverse=True):
            source = str(release.get("telegram", release.get("text_source", "")) or "").strip()
            if source and source not in urls:
                urls.append(source)
                if len(urls) >= limit:
                    break
        return urls

    def _configure_detached_telegram_renderer(self, renderer):
        """Make a TelegramTextView a real top-level off-screen render target."""
        if renderer is None:
            return None
        try:
            renderer.setParent(None)
            renderer.setWindowFlags(
                QtCore.Qt.WindowType.Tool
                | QtCore.Qt.WindowType.FramelessWindowHint
                | QtCore.Qt.WindowType.WindowDoesNotAcceptFocus
            )
            renderer.setAttribute(QtCore.Qt.WidgetAttribute.WA_ShowWithoutActivating, True)
            renderer.setAttribute(QtCore.Qt.WidgetAttribute.WA_QuitOnClose, False)
            renderer.setFixedWidth(max(720, theme_int("performance.telegram_render_width", 900)))
            renderer.move(-30000, -30000)
            renderer.setWindowTitle("Q3Elite Telegram Renderer")
            renderer._q3_detached_renderer = True
            renderers = getattr(self, "_telegramDetachedRenderers", None)
            if renderers is None:
                self._telegramDetachedRenderers = []
                renderers = self._telegramDetachedRenderers
            if renderer not in renderers:
                renderers.append(renderer)
        except RuntimeError:
            return None
        return renderer

    def _create_detached_telegram_renderer(self, source):
        if not TELEGRAM_WEBENGINE_AVAILABLE or QWebEngineView is None:
            return None
        try:
            renderer = TelegramTextView(str(source or ""), None)
            return self._configure_detached_telegram_renderer(renderer)
        except Exception as error:
            print(f"[changelog] Could not create detached Telegram renderer: {error}")
            return None

    def _prewarm_latest_telegram_posts(self):
        """Render the newest Telegram posts off-screen, one at a time.

        These are top-level Tool windows parked far outside the desktop rather
        than children of the launcher. Their Chromium surfaces therefore never
        enter/leave the launcher's translucent HWND when CHANGELOG is selected.
        """
        if (not TELEGRAM_WEBENGINE_AVAILABLE or QWebEngineView is None
                or not theme_bool("performance.telegram_webengine_prewarm", True)):
            return
        if getattr(self, "_telegramPrewarmActive", False):
            return
        urls = self._latest_telegram_sources()
        if not urls:
            return
        self._telegramPrewarmActive = True
        self._telegramPrewarmQueue = list(urls)
        self._telegramPreloadedRenderers = getattr(self, "_telegramPreloadedRenderers", {})
        self._telegramPrewarmCurrent = None
        self._telegram_prewarm_next()

    def _telegram_prewarm_next(self):
        queue = getattr(self, "_telegramPrewarmQueue", None) or []
        if not queue:
            self._telegramPrewarmActive = False
            self._telegramPrewarmCurrent = None
            # Attach only cheap QLabel snapshots while Changelog is still hidden.
            # When the user later clicks CHANGELOG there is no widget-tree swap
            # and no new Chromium child surface to make DWM flash the launcher.
            QtCore.QTimer.singleShot(0, lambda: self._activate_changelog_renderers(allow_hidden=True))
            return

        source = queue.pop(0)
        if source in getattr(self, "_telegramPreloadedRenderers", {}):
            QtCore.QTimer.singleShot(0, self._telegram_prewarm_next)
            return

        renderer = self._create_detached_telegram_renderer(source)
        if renderer is None:
            QtCore.QTimer.singleShot(220, self._telegram_prewarm_next)
            return

        state = {"source": source, "renderer": renderer, "claimed": False}
        self._telegramPrewarmCurrent = state

        def ready():
            current = getattr(self, "_telegramPrewarmCurrent", None)
            if current is not state:
                return
            if not state.get("claimed", False):
                self._telegramPreloadedRenderers[source] = renderer
            self._telegramPrewarmCurrent = None
            QtCore.QTimer.singleShot(220, self._telegram_prewarm_next)

        def failed(reason=""):
            current = getattr(self, "_telegramPrewarmCurrent", None)
            if current is not state:
                return
            self._telegramPrewarmCurrent = None
            if not state.get("claimed", False):
                try:
                    renderer.close()
                    renderer.deleteLater()
                except RuntimeError:
                    pass
            print(f"[changelog] Telegram prewarm failed for {source}: {reason}")
            QtCore.QTimer.singleShot(220, self._telegram_prewarm_next)

        renderer.ready.connect(ready)
        renderer.failed.connect(failed)
        # TelegramTextView will show itself after the styled DOM is ready; its
        # top-level geometry is already parked at -30000/-30000.

    def _take_prewarmed_telegram_renderer(self, source_url):
        """Return the retained/in-flight detached renderer without refetching."""
        source = str(source_url or "").strip()
        if not source:
            return None

        renderers = getattr(self, "_telegramPreloadedRenderers", None) or {}
        renderer = renderers.pop(source, None)
        if renderer is not None:
            return renderer

        current = getattr(self, "_telegramPrewarmCurrent", None)
        if current and current.get("source") == source:
            current["claimed"] = True
            return current.get("renderer")

        queue = getattr(self, "_telegramPrewarmQueue", None)
        if isinstance(queue, list):
            self._telegramPrewarmQueue = [u for u in queue if u != source]

        # User opened Changelog before low-priority warm-up reached this post.
        # Start the one and only navigation now, still in a detached top-level.
        return self._create_detached_telegram_renderer(source)

    def _save_launcher_preference(self, key, value):
        """Persist one lightweight UI preference through the existing settings file."""
        launcher_settings[key] = value
        try:
            save_launcher_settings(launcher_settings)
        except Exception as error:
            print(f"[settings] Could not save {key}: {error}")

    def _refresh_q3news_notification(self, rows=None, success=True):
        """Track the newest public Q3News post by its published date."""
        if not hasattr(self, "_q3news_unread"):
            self._q3news_unread = False
        if not hasattr(self, "_q3news_latest_date"):
            self._q3news_latest_date = ""
        if not hasattr(self, "_q3news_latest_id"):
            self._q3news_latest_id = 0
        if rows is not None and success:
            valid = [row for row in rows if isinstance(row, dict) and int(row.get("id") or 0) > 0]
            if valid:
                newest = max(valid, key=lambda row: int(row.get("id") or 0))
                self._q3news_latest_date = str(newest.get("date") or "")[:10]
                self._q3news_latest_id = int(newest.get("id") or 0)
                state = _load_notification_state()
                last_date = str(state.get("q3news_last_read_date", "") or "")[:10]
                last_id = int(state.get("q3news_last_read_id", 0) or 0)
                if not last_date and not last_id:
                    # Establish a first-run baseline; do not notify about old posts.
                    state["q3news_last_read_date"] = self._q3news_latest_date
                    state["q3news_last_read_id"] = self._q3news_latest_id
                    _save_notification_state(state)
                    self._q3news_unread = False
                else:
                    date_newer = bool(self._q3news_latest_date and last_date and self._q3news_latest_date > last_date)
                    id_newer = self._q3news_latest_id > last_id
                    same_or_unknown_date = not last_date or not self._q3news_latest_date or self._q3news_latest_date >= last_date
                    self._q3news_unread = bool(date_newer or (id_newer and same_or_unknown_date))
                # If the user is already viewing Q3News, the fetched latest post
                # is immediately considered read.
                if getattr(self, "_q3news_tab_active", False):
                    self._mark_q3news_read()
        show_q3news_unread = bool(self._q3news_unread) and not launcher_settings.get("disable_q3news_notifications", False)
        page = getattr(self, "changelogPage", None)
        if page is not None and not hasattr(page, "_q3news_tab_alert_dot"):
            page = getattr(page, "_q3_real_page", page)
        dot = getattr(page, "_q3news_tab_alert_dot", None) if page is not None else None
        button = getattr(page, "_q3news_tab_button", None) if page is not None else None
        if dot is not None and button is not None:
            dot.move(max(0, button.width() - dot.width() - 5), 5)
            dot.setVisible(show_q3news_unread)
            if show_q3news_unread:
                dot.raise_()
                button.setToolTip(f"New Q3News post: {self._q3news_latest_date or self._q3news_latest_id}")
            else:
                button.setToolTip("Q3News")
        self._refresh_changelog_notification()
        if hasattr(self, "homeNotificationDot"):
            has_update = any(
                _home_state_has_version_update(home_update_checks.get(key))
                or _home_state_needs_repair(home_update_checks.get(key))
                for key in ("launcher", "q3elite")
            ) or bool(isinstance(home_update_checks.get("osp2be"), dict) and home_update_checks["osp2be"].get("update_available"))
            has_changelog = bool(self._changelog_unread and not launcher_settings.get("disable_changelog_notifications", False))
            has_q3news = bool(self._q3news_unread and not launcher_settings.get("disable_q3news_notifications", False))
            self.homeNotificationDot.setVisible(has_update or has_changelog or has_q3news)
        return self._q3news_unread

    def _mark_q3news_read(self):
        latest_date = str(getattr(self, "_q3news_latest_date", "") or "")[:10]
        latest_id = int(getattr(self, "_q3news_latest_id", 0) or 0)
        if latest_date or latest_id:
            state = _load_notification_state()
            state["q3news_last_read_date"] = latest_date
            state["q3news_last_read_id"] = latest_id
            _save_notification_state(state)
        self._q3news_unread = False
        page = getattr(self, "changelogPage", None)
        if page is not None and not hasattr(page, "_q3news_tab_alert_dot"):
            page = getattr(page, "_q3_real_page", page)
        dot = getattr(page, "_q3news_tab_alert_dot", None) if page is not None else None
        if dot is not None:
            dot.hide()
        self._refresh_changelog_notification()
        if hasattr(self, "homeNotificationDot"):
            has_update = any(
                _home_state_has_version_update(home_update_checks.get(key))
                or _home_state_needs_repair(home_update_checks.get(key))
                for key in ("launcher", "q3elite")
            ) or bool(isinstance(home_update_checks.get("osp2be"), dict) and home_update_checks["osp2be"].get("update_available"))
            has_changelog = bool(getattr(self, "_changelog_unread", False) and not launcher_settings.get("disable_changelog_notifications", False))
            has_q3news = bool(getattr(self, "_q3news_unread", False) and not launcher_settings.get("disable_q3news_notifications", False))
            self.homeNotificationDot.setVisible(has_update or has_changelog or has_q3news)

    def _refresh_home_update_notification(self):
        """Show a Home navigation dot while any component update/repair is available."""
        dot = getattr(self, "homeAlertDot", None)
        button = getattr(self, "homeNav", None)
        if dot is None or button is None:
            return
        has_update = any(
            _home_state_has_version_update(home_update_checks.get(key))
            or _home_state_needs_repair(home_update_checks.get(key))
            for key in ("launcher", "q3elite")
        )
        osp_state = home_update_checks.get("osp2be")
        has_update = has_update or bool(
            isinstance(osp_state, dict) and osp_state.get("update_available")
        )
        dot.move(
            max(0, (button.width() - dot.width()) // 2),
            max(0, button.height() - dot.height() - 5),
        )
        dot.setVisible(has_update)
        if has_update:
            dot.raise_()
            dot.setToolTip("Launcher / Q3Elite / OSP2-BE update available")
        else:
            dot.setToolTip("HOME")

    def _refresh_changelog_notification(self):
        """Track Launcher Changelog and Q3Elite release versions independently."""
        entries = read_changelog_entries()
        state = _load_notification_state()
        read_versions = dict(state.get("last_read_versions", {}) or {})
        osp_state = home_update_checks.get("osp2be")
        latest_osp_version = (
            str(osp_state.get("remote_version") or "").strip()
            if isinstance(osp_state, dict) else ""
        )
        latest_versions = {
            "launcher": _latest_changelog_version(entries, "launcher"),
            "q3elite": _latest_changelog_version(entries, "q3elite"),
            "osp2be": latest_osp_version,
        }
        baselined = False
        for track, latest in latest_versions.items():
            if latest and not read_versions.get(track):
                read_versions[track] = latest
                baselined = True
        if baselined:
            state["last_read_versions"] = read_versions
            _save_notification_state(state)
        unread_tracks = [
            track for track, latest in latest_versions.items()
            if _version_is_unread(latest, read_versions.get(track, ""))
        ]
        unread = bool(unread_tracks) and not launcher_settings.get("disable_changelog_notifications", False)

        dot = getattr(self, "changelogAlertDot", None)
        button = getattr(self, "changelogNav", None)
        if dot is not None and button is not None:
            if unread:
                dot.move(max(0, (button.width() - dot.width()) // 2), max(0, button.height() - dot.height() - 5))
                dot.show(); dot.raise_()
                labels = [
                    "Changelog" if track == "launcher"
                    else "Q3Elite" if track == "q3elite"
                    else "OSP2-BE"
                    for track in unread_tracks
                ]
                button.setToolTip("New " + " + ".join(labels) + " version available")
            else:
                dot.hide(); button.setToolTip("CHANGELOG")
        changelog_page = getattr(self, "changelogPage", None)
        if changelog_page is not None and not hasattr(changelog_page, "_changelog_tab_alert_dot"):
            changelog_page = getattr(changelog_page, "_q3_real_page", changelog_page)
        if changelog_page is not None and hasattr(changelog_page, "_changelog_tab_alert_dot"):
            tab_dot = changelog_page._changelog_tab_alert_dot
            tab_button = getattr(changelog_page, "_changelog_tab_button", None)
            if tab_button is not None:
                tab_dot.move(max(0, tab_button.width() - tab_dot.width() - 5), 5)
                tab_dot.setVisible(bool(unread))
                if unread:
                    tab_dot.raise_(); tab_button.setToolTip(button.toolTip() if button else "New release available")
                else:
                    tab_button.setToolTip("CHANGELOG")
        self._changelog_latest_versions = latest_versions
        self._changelog_unread = unread
        self._refresh_home_update_notification()
        if hasattr(self, "homeNotificationDot"):
            has_update = any(
                _home_state_has_version_update(home_update_checks.get(key))
                or _home_state_needs_repair(home_update_checks.get(key))
                for key in ("launcher", "q3elite")
            ) or bool(isinstance(home_update_checks.get("osp2be"), dict) and home_update_checks["osp2be"].get("update_available"))
            has_q3news = bool(getattr(self, "_q3news_unread", False) and not launcher_settings.get("disable_q3news_notifications", False))
            self.homeNotificationDot.setVisible(has_update or unread or has_q3news)
        # The sidebar dot represents either unread release notes or unread Q3News.
        combined_unread = unread or (getattr(self, "_q3news_unread", False) and not launcher_settings.get("disable_q3news_notifications", False))
        if dot is not None and button is not None and combined_unread:
            dot.show(); dot.raise_()
            if not unread and getattr(self, "_q3news_unread", False):
                button.setToolTip(f"New Q3News post: {getattr(self, '_q3news_latest_date', '') or getattr(self, '_q3news_latest_id', 0)}")
        elif dot is not None:
            dot.hide()
        return unread

    def _mark_changelog_read(self):
        state = _load_notification_state()
        read_versions = dict(state.get("last_read_versions", {}) or {})
        latest_versions = getattr(self, "_changelog_latest_versions", {}) or {}
        if not latest_versions:
            entries = read_changelog_entries()
            latest_versions = {
                "launcher": _latest_changelog_version(entries, "launcher"),
                "q3elite": _latest_changelog_version(entries, "q3elite"),
            }
        for track, latest in latest_versions.items():
            if latest:
                read_versions[track] = latest
        state["last_read_versions"] = read_versions
        _save_notification_state(state)
        self._changelog_unread = False
        self._refresh_changelog_notification()

    def _build_changelog(self):
        page = QtWidgets.QWidget()
        root = QtWidgets.QVBoxLayout(page)
        root.setContentsMargins(4, 4, 4, 4)
        root.setSpacing(10)

        header = QtWidgets.QHBoxLayout()
        title = MetallicLabel("CHANGELOG")
        title.setObjectName("pageTitle")
        header.addWidget(title)
        header.addStretch(1)
        hint = QtWidgets.QLabel("Launcher  •  Quake 3 Elite  •  Q3News")
        hint.setObjectName("muted")
        header.addWidget(hint)
        root.addLayout(header)

        tabs = QtWidgets.QHBoxLayout()
        tabs.setSpacing(8)
        news_tab = MaterialPushButton("Q3News")
        news_tab.setObjectName("secondaryButton")
        changelog_tab = MaterialPushButton("CHANGELOG")
        changelog_tab.setObjectName("secondaryButton")
        changelog_tab_alert_dot = QtWidgets.QLabel(changelog_tab)
        changelog_tab_alert_dot.setFixedSize(8, 8)
        changelog_tab_alert_dot.setAttribute(QtCore.Qt.WidgetAttribute.WA_TransparentForMouseEvents, True)
        changelog_tab_alert_dot.setStyleSheet("background-color: #3b82f6; border: none; border-radius: 4px;")
        changelog_tab_alert_dot.hide()
        page._changelog_tab_button = changelog_tab
        page._changelog_tab_alert_dot = changelog_tab_alert_dot
        page._changelog_set_tab = None
        tabs.addWidget(news_tab)
        tabs.addWidget(changelog_tab)
        tabs.addStretch(1)
        root.addLayout(tabs)

        stack = QtWidgets.QStackedWidget()
        page._changelog_stack = stack
        root.addWidget(stack, 1)

        # -----------------------------------------------------------------
        # Traditional launcher changelog
        # -----------------------------------------------------------------
        scroll = QtWidgets.QScrollArea()
        scroll.setObjectName("changelogScroll")
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QtWidgets.QFrame.Shape.NoFrame)

        content = QtWidgets.QWidget()
        content.setObjectName("changelogContent")
        feed = QtWidgets.QVBoxLayout(content)
        feed.setContentsMargins(0, 0, 8, 0)
        feed.setSpacing(12)

        entries = read_changelog_entries()
        # OSP2-BE full release history comes from assets/changelog_be.txt.
        # The source file is oldest-first; the updater parser returns dated
        # release cards newest-first. Replace stale synthetic OSP2-BE entries
        # only when real history has been fetched (or loaded from cache).
        osp_state = home_update_checks.get("osp2be")
        if isinstance(osp_state, dict):
            osp_history = osp_state.get("changelog_releases") or []
            if isinstance(osp_history, list) and osp_history:
                entries = [
                    item for item in entries
                    if "osp2be" not in re.sub(r"[^a-z0-9]", "", str(item.get("type", "") or "").casefold())
                ]
                entries.extend(item for item in osp_history if isinstance(item, dict))
            elif osp_state.get("changelog") or osp_state.get("changelog_text"):
                # Compatibility fallback for older updater modules/cache files.
                entries = [
                    item for item in entries
                    if "osp2be" not in re.sub(r"[^a-z0-9]", "", str(item.get("type", "") or "").casefold())
                ]
                osp_notes = osp_state.get("changelog") or []
                if isinstance(osp_notes, str):
                    osp_notes = [osp_notes]
                entries.append({
                    "type": "OSP2-BE",
                    "version": str(osp_state.get("remote_version") or "?"),
                    "date": str(osp_state.get("changelog_date") or ""),
                    "text": str(osp_state.get("changelog_summary") or "Latest OSP2-BE update"),
                    "changelog": list(osp_notes),
                    "link": str(osp_state.get("changelog_url") or "https://osp2.q3a.space/en/index.html"),
                    "list": True,
                })
        if entries:
            from datetime import datetime
            def _key(item):
                value = str(item.get("date", item.get("release_date", "")))
                for fmt in ("%Y-%m-%d", "%Y/%m/%d", "%d.%m.%Y"):
                    try:
                        return datetime.strptime(value[:10], fmt)
                    except ValueError:
                        pass
                return datetime.min
            sorted_entries = sorted(entries, key=_key, reverse=True)
            latest_limit = max(1, min(6, theme_int("performance.changelog_latest_posts", 3)))
            auto_telegram_urls = []
            for release in sorted_entries:
                source = str(release.get("telegram", release.get("text_source", "")) or "").strip()
                if source and source not in auto_telegram_urls:
                    auto_telegram_urls.append(source)
                    if len(auto_telegram_urls) >= latest_limit:
                        break
            auto_telegram_urls = set(auto_telegram_urls)
            changelog_cards = []
            page._changelog_cards = changelog_cards
            initial_cards = max(1, theme_int("performance.changelog_initial_cards", 3))
            batch_size = max(1, theme_int("performance.changelog_card_batch", 3))
            step_ms = max(8, theme_int("performance.changelog_card_step_ms", 24))

            def append_card(index):
                release = sorted_entries[index]
                source = str(release.get("telegram", release.get("text_source", "")) or "").strip()
                auto_web = bool(
                    source and source in auto_telegram_urls
                    and TELEGRAM_WEBENGINE_AVAILABLE
                    and theme_bool("performance.changelog_auto_webengine", True)
                )
                auto_fetch = bool(source and source in auto_telegram_urls and not auto_web)
                card = ChangelogCard(
                    release, content, expanded=(index < 3), defer_telegram=True,
                    telegram_fetcher=self._queue_telegram_fetch,
                    auto_fetch_telegram=auto_fetch,
                    telegram_web_only=auto_web,
                    telegram_page_provider=self._take_prewarmed_telegram_renderer,
                )
                card._telegram_auto_web = auto_web
                if auto_fetch:
                    self._queue_telegram_fetch(source)
                changelog_cards.append(card)
                insert_at = max(0, feed.count() - 1) if getattr(page, "_changelog_has_stretch", False) else feed.count()
                feed.insertWidget(insert_at, card)

            for index in range(min(initial_cards, len(sorted_entries))):
                append_card(index)

            page._changelog_pending_entries = sorted_entries
            page._changelog_next_index = min(initial_cards, len(sorted_entries))
            page._changelog_batch_size = batch_size
            page._changelog_step_ms = step_ms
            page._changelog_append_card = append_card
        else:
            page._changelog_cards = []
            empty = QtWidgets.QLabel("No changelog entries found.")
            empty.setObjectName("muted")
            feed.addWidget(empty)

        feed.addStretch(1)
        page._changelog_has_stretch = True

        def append_changelog_batch():
            entries_local = getattr(page, "_changelog_pending_entries", [])
            index = int(getattr(page, "_changelog_next_index", len(entries_local)))
            batch = int(getattr(page, "_changelog_batch_size", 3))
            append_one = getattr(page, "_changelog_append_card", None)
            if append_one is None or index >= len(entries_local):
                return
            stop = min(len(entries_local), index + batch)
            for i in range(index, stop):
                append_one(i)
            page._changelog_next_index = stop
            if stop < len(entries_local):
                QtCore.QTimer.singleShot(int(getattr(page, "_changelog_step_ms", 24)), append_changelog_batch)

        if getattr(page, "_changelog_next_index", 0) < len(getattr(page, "_changelog_pending_entries", [])):
            QtCore.QTimer.singleShot(0, append_changelog_batch)

        scroll.setWidget(content)

        # -----------------------------------------------------------------
        # Live public Q3News feed. Oldest is above, newest is at the bottom;
        # scrolling upward (or LOAD MORE) prepends older posts.
        # -----------------------------------------------------------------
        news_scroll = QtWidgets.QScrollArea()
        news_scroll.setObjectName("changelogScroll")
        news_scroll.setWidgetResizable(True)
        news_scroll.setFrameShape(QtWidgets.QFrame.Shape.NoFrame)
        news_scroll.setHorizontalScrollBarPolicy(QtCore.Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        news_content = QtWidgets.QWidget()
        news_content.setObjectName("changelogContent")
        news_feed = QtWidgets.QVBoxLayout(news_content)
        news_feed.setContentsMargins(0, 0, 8, 0)
        news_feed.setSpacing(12)
        news_load = MaterialPushButton("LOAD MORE")
        news_load.setObjectName("secondaryButton")
        news_load.setFixedWidth(150)
        news_feed.addWidget(news_load, 0, QtCore.Qt.AlignmentFlag.AlignHCenter)
        news_status = QtWidgets.QLabel("Loading latest Q3News…")
        news_status.setObjectName("muted")
        news_status.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        news_feed.addWidget(news_status)
        # Spacer belongs between the toolbar and the timeline. This pins the
        # newest posts to the bottom when only a couple of posts are present.
        news_feed.insertStretch(2, 1)
        news_scroll.setWidget(news_content)
        # Q3News is the default/first tab. Keep the traditional release notes
        # second so opening the section does not mark them as read implicitly.
        stack.addWidget(news_scroll)
        stack.addWidget(scroll)

        page._q3news_scroll = news_scroll
        page._q3news_feed = news_feed
        page._q3news_load_button = news_load
        page._q3news_status = news_status
        page._q3news_ids = []
        page._q3news_cards = []
        page._q3news_loading = False
        page._q3news_exhausted = False
        page._q3news_worker = None
        page._q3news_follow_latest = True
        page._q3news_user_scrolling = False
        if not hasattr(self, "_q3news_latest_date"):
            self._q3news_latest_date = ""
        if not hasattr(self, "_q3news_latest_id"):
            self._q3news_latest_id = 0
        if not hasattr(self, "_q3news_unread"):
            self._q3news_unread = False
        self._q3news_tab_alert_dot = QtWidgets.QLabel(news_tab)
        self._q3news_tab_alert_dot.setFixedSize(8, 8)
        self._q3news_tab_alert_dot.setAttribute(QtCore.Qt.WidgetAttribute.WA_TransparentForMouseEvents, True)
        self._q3news_tab_alert_dot.setStyleSheet("background-color: #3b82f6; border: none; border-radius: 4px;")
        self._q3news_tab_alert_dot.hide()
        page._q3news_tab_alert_dot = self._q3news_tab_alert_dot
        page._q3news_tab_button = news_tab

        def set_tab(index, mark_read=True):
            stack.setCurrentIndex(index)
            page._changelog_set_tab = set_tab
            self._q3news_tab_active = (index == 0 and bool(mark_read))
            news_tab.setProperty("active", index == 0)
            changelog_tab.setProperty("active", index == 1)
            for button in (news_tab, changelog_tab):
                button.style().unpolish(button); button.style().polish(button)
            changelog_tab_alert_dot.move(max(0, changelog_tab.width() - changelog_tab_alert_dot.width() - 5), 5)
            page._q3news_tab_alert_dot.move(max(0, news_tab.width() - page._q3news_tab_alert_dot.width() - 5), 5)
            if index == 0:
                if mark_read:
                    self._mark_q3news_read()
                if not page._q3news_ids and not page._q3news_loading:
                    self._load_q3news_page(page, initial=True)
            elif index == 1:
                self._mark_changelog_read()

        def toggle_tab():
            set_tab(1 if stack.currentIndex() == 0 else 0, mark_read=True)

        page._changelog_toggle_tab = toggle_tab
        if getattr(self, "_changelog_sidebar_toggle_pending", False):
            self._changelog_sidebar_toggle_pending = False
            QtCore.QTimer.singleShot(0, toggle_tab)

        # Switch the stacked page on mouse press rather than waiting for the
        # QPushButton clicked signal (release). This keeps the two feed tabs
        # responsive even when the button is embedded above the scroll areas.
        # set_tab() is idempotent, so repeated presses do not duplicate work.
        changelog_tab.pressed.connect(lambda: set_tab(1))
        news_tab.pressed.connect(lambda: set_tab(0, mark_read=True))
        news_load.clicked.connect(lambda _checked=False: self._load_q3news_page(page, initial=False))

        def news_scroll_changed(value):
            bar = news_scroll.verticalScrollBar()
            if value <= 10 and bar.maximum() > 30 and page._q3news_ids and not page._q3news_loading:
                self._load_q3news_page(page, initial=False)
        news_scroll.verticalScrollBar().valueChanged.connect(news_scroll_changed)

        def follow_q3news_tail():
            if getattr(page, "_q3news_follow_latest", False):
                bar = news_scroll.verticalScrollBar()
                bar.setValue(bar.maximum())

        def q3news_range_changed(_minimum, _maximum):
            if getattr(page, "_q3news_follow_latest", False):
                QtCore.QTimer.singleShot(0, follow_q3news_tail)

        news_scroll.verticalScrollBar().rangeChanged.connect(q3news_range_changed)

        def q3news_user_scroll_action(_action):
            # valueChanged also fires for some scrollbar/layout adjustments.
            # Treat only an actual scrollbar action (wheel, page/line step,
            # or thumb drag) as user intent, then inspect the settled position.
            def update_follow_state():
                bar = news_scroll.verticalScrollBar()
                page._q3news_follow_latest = (
                    bar.value() >= bar.maximum() - 24
                )

            QtCore.QTimer.singleShot(0, update_follow_state)

        news_scroll.verticalScrollBar().actionTriggered.connect(
            q3news_user_scroll_action
        )
        page._q3news_follow_latest_to_bottom = follow_q3news_tail
        set_tab(0, mark_read=False)
        self._refresh_changelog_notification()
        self._refresh_q3news_notification()
        return page

    def _load_q3news_page(self, page, initial=False):
        if page is None or getattr(page, "_q3news_loading", False) or getattr(page, "_q3news_exhausted", False):
            return
        ids = list(getattr(page, "_q3news_ids", []) or [])
        before = min(ids) if ids and not initial else None
        page._q3news_loading = True
        button = getattr(page, "_q3news_load_button", None)
        status = getattr(page, "_q3news_status", None)
        if button is not None:
            button.setEnabled(False); button.setText("LOADING…")
        if status is not None:
            status.setText("Loading latest Q3News…" if initial else "Loading older Q3News…")
        worker = Q3NewsWorker(before=before, limit=(2 if initial else 3), parent=self)
        page._q3news_worker = worker
        worker.result_ready.connect(lambda ok, data, p=page, first=initial: self._q3news_page_ready(p, first, ok, data))
        worker.finished.connect(worker.deleteLater)
        worker.start()

    def _q3news_page_ready(self, page, initial, success, result):
        try:
            page._q3news_loading = False
            button = page._q3news_load_button
            status = page._q3news_status
            button.setEnabled(True); button.setText("LOAD MORE")
            if not success:
                status.setText(f"Q3News unavailable: {result}")
                return
            rows = [dict(x) for x in (result or []) if isinstance(x, dict) and int(x.get("id") or 0) > 0]
            if initial:
                self._refresh_q3news_notification(rows, success=True)
            existing = set(int(x) for x in page._q3news_ids)
            rows = [x for x in rows if int(x["id"]) not in existing]
            rows.sort(key=lambda x: int(x["id"]))
            if not rows:
                page._q3news_exhausted = True
                button.setEnabled(False); button.setText("NO MORE NEWS")
                status.setText("")
                return

            bar = page._q3news_scroll.verticalScrollBar()
            old_max = bar.maximum()
            old_value = bar.value()
            insert_at = 3  # LOAD MORE + status + timeline spacer.
            # Keep a stretch between toolbar and cards so a short feed sits at
            # the bottom like a chat timeline. Older rows are prepended.
            for offset, row in enumerate(rows):
                post_id = int(row["id"])
                url = str(row.get("url") or f"https://t.me/Q3News/{post_id}")
                release = {
                    "header_title": f"Q3NEWS  •  #{post_id}",
                    "telegram": url,
                    "list": False,
                }
                card = ChangelogCard(
                    release, page, expanded=True, defer_telegram=True,
                    telegram_fetcher=self._queue_telegram_fetch,
                    auto_fetch_telegram=True,
                    telegram_web_only=False,
                    telegram_page_provider=self._take_prewarmed_telegram_renderer,
                )
                page._q3news_feed.insertWidget(insert_at + offset, card)
                page._q3news_cards.insert(offset, card)
                self._queue_telegram_fetch(url)
                # Q3News cards are created after the Changelog page's normal
                # renderer prewarm pass. Activate their detached Telegram
                # renderer explicitly, otherwise the native placeholder can
                # remain visible forever even though the post IDs loaded.
                QtCore.QTimer.singleShot(
                    100,
                    lambda c=card, p=page: self._activate_changelog_card(
                        c, p, allow_hidden=True
                    ),
                )
            page._q3news_ids = sorted(existing | {int(x["id"]) for x in rows})
            status.setText("")

            def settle_scroll():
                new_bar = page._q3news_scroll.verticalScrollBar()
                if initial:
                    new_bar.setValue(new_bar.maximum())
                else:
                    # Preserve the exact post under the cursor after prepending.
                    new_bar.setValue(old_value + max(0, new_bar.maximum() - old_max))
            QtCore.QTimer.singleShot(80, settle_scroll)
        except RuntimeError:
            pass

    def _activate_changelog_card(self, card, page, allow_hidden=False):
        try:
            card._telegram_activation_scheduled = False
            if not allow_hidden and self.pages.currentWidget() is not page:
                return
            if not allow_hidden and not card.isVisibleTo(page):
                return
            card.activate_telegram_renderer()
        except RuntimeError:
            pass

    def _activate_changelog_renderers(self, allow_hidden=False):
        """Attach cheap Qt snapshots for the newest Telegram cards.

        Chromium itself stays detached/off-screen. Hidden activation is used
        after prewarm so CHANGELOG navigation performs no renderer creation.
        """
        page = getattr(self, "changelogPage", None)
        if page is None:
            return
        if not allow_hidden and self.pages.currentWidget() is not page:
            return
        real_page = getattr(page, "_q3_real_page", page)
        cards = list(getattr(real_page, "_changelog_cards", []) or [])
        visible = [
            card for card in cards
            if getattr(card, "_expanded", False) and getattr(card, "_telegram_auto_web", False)
        ][:max(1, min(3, theme_int("performance.changelog_latest_posts", 3)))]
        step = 0 if allow_hidden else max(80, theme_int("performance.changelog_webengine_step_ms", 180))
        initial = 0 if allow_hidden else max(20, theme_int("performance.changelog_webengine_delay_ms", 60))
        for index, card in enumerate(visible):
            if card.telegramView is not None or not getattr(card, "_telegram_source_url", ""):
                continue
            if getattr(card, "_telegram_activation_scheduled", False):
                continue
            card._telegram_activation_scheduled = True
            QtCore.QTimer.singleShot(
                initial + index * step,
                lambda c=card, p=page, h=allow_hidden: self._activate_changelog_card(c, p, h),
            )

    def rebuild_changelog_page(self):
        """Rebuild changelog cards without replacing the current stack page."""
        host = self.changelogPage
        mounted = getattr(host, "_q3_real_page", None)
        if mounted is not None and host.layout() is not None:
            layout = host.layout()
            layout.removeWidget(mounted)
            mounted.deleteLater()
            new_page = self._build_changelog()
            new_page.setParent(host)
            layout.addWidget(new_page)
            host._q3_real_page = new_page
            host._changelog_cards = getattr(new_page, "_changelog_cards", [])
            _install_obsidian_scrollbars(new_page)
            host.updateGeometry()
            host.update()
            return

        old_page = host
        old_index = self.pages.indexOf(old_page)
        was_current = self.pages.currentWidget() is old_page
        new_page = self._build_changelog()
        self.pages.insertWidget(old_index, new_page)
        self.pages.removeWidget(old_page)
        old_page.deleteLater()
        self.changelogPage = new_page
        if was_current:
            self.pages.setCurrentWidget(new_page)

    def _set_media_hover_row(self, list_kind, row, *, play=True):
        row_attr = f"_{list_kind}SfxHoverRow"
        if row == getattr(self, row_attr, -1):
            return
        setattr(self, row_attr, row)
        if not play or row < 0:
            return
        now = time.monotonic()
        last_attr = f"_{list_kind}SfxHoverAt"
        if now - float(getattr(self, last_attr, 0.0)) < 0.08:
            return
        setattr(self, last_attr, now)
        self._play_launcher_sound(
            "map_hover" if list_kind.startswith("map") else "list_hover"
        )

    def eventFilter(self, obj, event):
        event_type = event.type()

        if obj is getattr(self, "heroImage", None) and event_type == QtCore.QEvent.Type.Resize:
            if not getattr(self, "_hero_resize_refresh_pending", False):
                self._hero_resize_refresh_pending = True
                def _refresh_after_hero_resize():
                    self._hero_resize_refresh_pending = False
                    self._refresh_hero_image_for_size()
                QtCore.QTimer.singleShot(0, _refresh_after_hero_resize)

        # Media-list feedback is handled independently from button clicks.
        # Use row-change detection and tiny rate limits so rapid list browsing
        # does not enqueue a pile of sounds.
        list_kind = None
        is_media_viewport = False
        if hasattr(self, "demoList") and (obj is self.demoList or obj is self.demoList.viewport()):
            list_kind = "demo"
            media_list = self.demoList
            is_media_viewport = obj is self.demoList.viewport()
        elif hasattr(self, "screenshotList") and (obj is self.screenshotList or obj is self.screenshotList.viewport()):
            list_kind = "screenshot"
            media_list = self.screenshotList
            is_media_viewport = obj is self.screenshotList.viewport()
        elif hasattr(self, "mapsTable") and (obj is self.mapsTable or obj is self.mapsTable.viewport()):
            list_kind = "map_local"
            media_list = self.mapsTable
            is_media_viewport = obj is self.mapsTable.viewport()
        elif hasattr(self, "onlineMapsTable") and (obj is self.onlineMapsTable or obj is self.onlineMapsTable.viewport()):
            list_kind = "map_online"
            media_list = self.onlineMapsTable
            is_media_viewport = obj is self.onlineMapsTable.viewport()
        else:
            media_list = None
        if media_list is not None:
            if is_media_viewport and event_type == QtCore.QEvent.Type.MouseMove:
                row = media_list.indexAt(event.position().toPoint()).row()
                if row >= 0 and row != getattr(self, f"_{list_kind}SfxHoverRow", -1):
                    self._set_media_hover_row(list_kind, row)
            elif is_media_viewport and event_type == QtCore.QEvent.Type.Leave:
                self._set_media_hover_row(list_kind, -1, play=False)
            elif is_media_viewport and event_type == QtCore.QEvent.Type.MouseButtonPress:
                index = media_list.indexAt(event.position().toPoint())
                if index.isValid():
                    self._play_launcher_sound(
                        "map_select" if list_kind.startswith("map") else "list_select"
                    )
            elif event_type == QtCore.QEvent.Type.KeyPress:
                list_keys = {
                    QtCore.Qt.Key.Key_Up, QtCore.Qt.Key.Key_Down,
                    QtCore.Qt.Key.Key_Home, QtCore.Qt.Key.Key_End,
                    QtCore.Qt.Key.Key_PageUp, QtCore.Qt.Key.Key_PageDown,
                }
                if event.key() in list_keys:
                    before = media_list.currentIndex().row()
                    select_sound = "map_select" if list_kind.startswith("map") else "list_select"
                    QtCore.QTimer.singleShot(
                        0,
                        lambda w=media_list, r=before, k=select_sound: self._play_launcher_sound(k)
                        if w.currentIndex().row() != r else None,
                    )

        # Optional UI SFX. The event filter is already installed once on the
        # application for keyboard navigation and capture routing, so button
        # sounds do not need per-widget signal wiring.
        if isinstance(obj, QtWidgets.QAbstractButton) and not bool(obj.property("muteLauncherSfx")):
            is_toggle_control = (
                obj is getattr(self, "launcherSoundsBox", None)
                or isinstance(obj, (QtWidgets.QCheckBox, QtWidgets.QRadioButton, ToggleSwitch))
            )
            if event_type == QtCore.QEvent.Type.Enter and obj.isEnabled():
                now = time.monotonic()
                suppress_until = float(getattr(self, "_launcherSfxSuppressHoverUntil", 0.0))
                last_hover = float(getattr(self, "_launcherSfxLastHoverAt", 0.0))
                if now >= suppress_until and now - last_hover >= 0.5:
                    self._launcherSfxLastHoverAt = now
                    self._play_launcher_sound("hover")
            elif is_toggle_control and event_type in (
                    QtCore.QEvent.Type.MouseButtonPress,
                    QtCore.QEvent.Type.MouseButtonDblClick):
                self._play_launcher_sound(
                    "toggle_off" if obj.isChecked() else "toggle_on", force=True
                )
            elif (is_toggle_control and event_type == QtCore.QEvent.Type.KeyPress
                    and event.key() in (QtCore.Qt.Key.Key_Space, QtCore.Qt.Key.Key_Return, QtCore.Qt.Key.Key_Enter)
                    and not event.isAutoRepeat()):
                self._play_launcher_sound(
                    "toggle_off" if obj.isChecked() else "toggle_on", force=True
                )
            elif event_type == QtCore.QEvent.Type.MouseButtonPress and obj.isEnabled():
                if obj.objectName() == "serverRemoveButton":
                    # Removing a server rebuilds the cards under the stationary
                    # cursor. Qt then emits Enter for the replacement button,
                    # which otherwise sounds like a second action. Keep the
                    # normal click sound, but suppress these synthetic hover
                    # sounds briefly after the remove click.
                    self._launcherSfxSuppressHoverUntil = time.monotonic() + 3.0
                nav_buttons = tuple(
                    getattr(self, name, None) for name in (
                        "homeNav", "addonsNav", "statisticsNav", "serversNav", "mapsNav",
                        "matchmakingNav", "screenshotsNav", "demosNav", "accountNav",
                        "settingsNav", "changelogNav",
                    )
                )
                if any(obj is button for button in nav_buttons):
                    self._play_launcher_sound("nav_forward")
                elif (obj is getattr(self, "demoPlayButton", None)
                        or (obj is getattr(self, "playButton", None) and "PLAY" in obj.text().upper())
                        or obj.objectName() in {"serverConnectButton", "mapPlayButton"}
                        or obj is getattr(self, "launcherSoundTestButton", None)):
                    # The action methods play the configured PLAY/CONNECT/demo sound.
                    pass
                else:
                    self._play_launcher_sound("click")
            elif (event_type == QtCore.QEvent.Type.KeyPress and obj.isEnabled()
                    and event.key() in (QtCore.Qt.Key.Key_Space, QtCore.Qt.Key.Key_Return, QtCore.Qt.Key.Key_Enter)
                    and not event.isAutoRepeat()):
                nav_buttons = tuple(
                    getattr(self, name, None) for name in (
                        "homeNav", "addonsNav", "statisticsNav", "serversNav", "mapsNav",
                        "matchmakingNav", "screenshotsNav", "demosNav", "accountNav",
                        "settingsNav", "changelogNav",
                    )
                )
                if any(obj is button for button in nav_buttons):
                    self._play_launcher_sound("nav_forward")
                elif (obj is getattr(self, "demoPlayButton", None)
                        or (obj is getattr(self, "playButton", None) and "PLAY" in obj.text().upper())
                        or obj.objectName() in {"serverConnectButton", "mapPlayButton"}
                        or obj is getattr(self, "launcherSoundTestButton", None)):
                    # Action handlers provide PLAY/CONNECT/demo feedback.
                    pass
                else:
                    self._play_launcher_sound("click")

        # Global launcher navigation. Text-entry widgets keep ordinary Q/E
        # typing; modal dialogs also retain their own keyboard/mouse semantics.
        # A QApplication event filter can observe a physical key press while
        # focus is being transferred between widgets. Keep a press latch until
        # KeyRelease so one physical Q/E press can never navigate twice.
        if event_type == QtCore.QEvent.Type.KeyRelease:
            if event.key() in (QtCore.Qt.Key.Key_Q, QtCore.Qt.Key.Key_E):
                pressed = getattr(self, "_q3_navigation_keys_down", None)
                if pressed is not None:
                    pressed.discard(event.key())

        if QtWidgets.QApplication.activeModalWidget() is None:
            if event_type == QtCore.QEvent.Type.KeyPress:
                if (
                    not event.isAutoRepeat()
                    and event.modifiers() == QtCore.Qt.KeyboardModifier.NoModifier
                    and not self._navigation_input_blocked()
                ):
                    if event.key() in (QtCore.Qt.Key.Key_Q, QtCore.Qt.Key.Key_E):
                        pressed = getattr(self, "_q3_navigation_keys_down", None)
                        if pressed is None:
                            pressed = self._q3_navigation_keys_down = set()
                        if event.key() in pressed:
                            event.accept()
                            return True
                        pressed.add(event.key())
                    # SERVERS uses Left/Right as the keyboard equivalent of
                    # the visible carousel arrow buttons. Keep text fields and
                    # modal dialogs untouched.
                    if (
                        self._current_page_name() == "servers"
                        and event.key() in (QtCore.Qt.Key.Key_Left, QtCore.Qt.Key.Key_Right)
                    ):
                        self.scroll_server_monitors(
                            -1 if event.key() == QtCore.Qt.Key.Key_Left else 1
                        )
                        event.accept()
                        return True
                    if event.key() == QtCore.Qt.Key.Key_Q:
                        self._play_launcher_sound("nav_forward")
                        self.navigate_section(-1)
                        event.accept()
                        return True
                    if event.key() == QtCore.Qt.Key.Key_E:
                        self._play_launcher_sound("nav_forward")
                        self.navigate_section(1)
                        event.accept()
                        return True
            elif event_type == QtCore.QEvent.Type.MouseButtonPress:
                if event.button() == QtCore.Qt.MouseButton.BackButton:
                    if self.navigate_history(-1):
                        self._play_launcher_sound("nav_back")
                        event.accept()
                        return True
                elif event.button() == QtCore.Qt.MouseButton.ForwardButton:
                    if self.navigate_history(1):
                        self._play_launcher_sound("nav_forward")
                        event.accept()
                        return True

        if event_type == QtCore.QEvent.Type.Wheel and hasattr(self, "serverCards"):
            # Server monitor uses contextual wheel routing: PLAYER list scrolls
            # itself, while every other point inside a server card rotates the
            # server carousel. Guard stale wrappers during theme/card rebuilds.
            try:
                widget = obj if isinstance(obj, QtWidgets.QWidget) else None
                probe = widget
                inside_player_list = False
                card = None
                while probe is not None:
                    if isinstance(probe, ServerPlayerTable):
                        inside_player_list = True
                        break
                    if isinstance(probe, ServerCard):
                        card = probe
                        break
                    probe = probe.parentWidget()
                if inside_player_list:
                    return False
                if card is not None and card in self.serverCards:
                    delta = event.angleDelta().y() or event.angleDelta().x()
                    if delta and len(self.serverCards) > max(1, int(getattr(self, "_serverVisibleCount", 3))):
                        self.scroll_server_monitors(1 if delta < 0 else -1)
                        event.accept()
                        return True
            except RuntimeError:
                pass

        if (getattr(self, "_renameScreenshotActive", False)
                and event.type() == QtCore.QEvent.Type.MouseButtonPress):
            self._commit_screenshot_rename()
            return False
        if (getattr(self, "_renameScreenshotActive", False)
                and obj is getattr(self, "_renameScreenshotEditor", None)
                and event.type() == QtCore.QEvent.Type.KeyPress
                and event.key() == QtCore.Qt.Key.Key_Escape):
            self._renameScreenshotCancelled = True
            self._cancel_screenshot_rename()
            return True
        if (getattr(self, "_renameScreenshotActive", False)
                and obj is getattr(self, "_renameScreenshotEditor", None)
                and event.type() == QtCore.QEvent.Type.KeyPress
                and event.key() in (QtCore.Qt.Key.Key_Return, QtCore.Qt.Key.Key_Enter)):
            self._commit_screenshot_rename()
            return True
        return super().eventFilter(obj, event)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if hasattr(self, "screenshotPreview"):
            QtCore.QTimer.singleShot(0, self._rescale_screenshot_preview)

    def _sync_media_shortcuts(self, page):
        screenshots_active = page == "screenshots"
        demos_active = page == "demos"
        maps_active = page == "maps"
        statistics_active = page == "statistics"
        if hasattr(self, "statisticsFilterShortcut"):
            self.statisticsFilterShortcut.setEnabled(statistics_active)
        if hasattr(self, "statisticsKeysShortcut"):
            self.statisticsKeysShortcut.setEnabled(statistics_active)
        for shortcut in getattr(self, "screenshotShortcuts", []):
            shortcut.setEnabled(screenshots_active)
        for shortcut in getattr(self, "demoShortcuts", []):
            shortcut.setEnabled(demos_active)
        for shortcut in getattr(self, "mapShortcuts", []):
            shortcut.setEnabled(maps_active)

    def _navigation_input_blocked(self):
        focus = QtWidgets.QApplication.focusWidget()
        if focus is None:
            return False
        blocked_types = (
            QtWidgets.QLineEdit,
            QtWidgets.QTextEdit,
            QtWidgets.QPlainTextEdit,
            QtWidgets.QAbstractSpinBox,
            QtWidgets.QComboBox,
        )
        return isinstance(focus, blocked_types)

    def _current_page_name(self):
        # The checked state of sidebar buttons is presentation state, not the
        # source of truth for navigation. Checkable buttons can briefly toggle
        # during repeated clicks (notably Changelogs, which also switches its
        # inner Q3News/CHANGELOG tab). Resolve the active section from the
        # stacked widget so Q/E always move exactly one section from the page
        # that is actually visible.
        pages = getattr(self, "pages", None)
        current_widget = pages.currentWidget() if pages is not None else None
        if current_widget is not None:
            for page in NAV_PAGE_ORDER:
                attr = self._page_attr_names.get(page, f"{page}Page")
                if current_widget is getattr(self, attr, None):
                    return page

        # Fallback for startup states before the stacked page is available.
        for page in NAV_PAGE_ORDER:
            button = getattr(self, {
                "home": "homeNav",
                "addons": "addonsNav",
                "statistics": "statisticsNav",
                "servers": "serversNav",
                "maps": "mapsNav",
                "matchmaking": "matchmakingNav",
                "screenshots": "screenshotsNav",
                "demos": "demosNav",
                "changelog": "changelogNav",
                "account": "accountNav",
                "settings": "settingsNav",
            }[page], None)
            if button is not None and button.isChecked():
                return page
        return "home"

    def navigate_section(self, direction):
        current = self._current_page_name()
        try:
            index = NAV_PAGE_ORDER.index(current)
        except ValueError:
            index = 0
        step = 1 if int(direction) > 0 else -1
        self.show_page(NAV_PAGE_ORDER[(index + step) % len(NAV_PAGE_ORDER)])

    def navigate_history(self, direction):
        if not self._page_history:
            return False
        target = self._page_history_index + (1 if int(direction) > 0 else -1)
        if target < 0 or target >= len(self._page_history):
            return False
        self._page_history_index = target
        self._history_navigation = True
        try:
            self.show_page(self._page_history[target])
        finally:
            self._history_navigation = False
        return True

    def _finish_deferred_page_navigation(self, page):
        # A lazy-page build is allowed to finish in the background, but it must
        # never steal focus/navigation back from a page the user selected in
        # the meantime (for example, pressing Q immediately after opening
        # Changelogs). Keep the host identity stable: V4 mounts the real page
        # inside the original placeholder widget.
        attr = self._page_attr_names.get(page, f"{page}Page")
        host = getattr(self, attr, None)
        was_current_when_scheduled = (
            host is not None and self.pages.currentWidget() is host
        )
        try:
            self._ensure_page_built(page)
        except Exception as error:
            print(f"[ui] Could not build {page} page: {error}")
            traceback.print_exc()
            return

        # Re-check after construction as well. If navigation moved elsewhere,
        # do not call show_page(): that would append/restore the stale section
        # and make the first Q/E press appear to skip an extra section.
        if (was_current_when_scheduled
                and host is not None
                and self.pages.currentWidget() is host):
            self.show_page(page)

    def show_page(self, page):
        _q3_nav_started = time.perf_counter()
        page = str(page)
        current_is_matchmaking = (
            "matchmaking" in getattr(self, "_built_pages", set())
            and self.pages.currentWidget() is getattr(self, "matchmakingPage", None)
        )
        if (current_is_matchmaking and page != "matchmaking"
                and getattr(self, "_matchmaking_edit_dirty", False)):
            # Matchmaking editors are staged. Leaving with unsaved edits discards
            # widget-only changes, but an untouched editor tree is retained.
            self._rebuild_matchmaking_rules()

        nav_mapping = {
            "home": self.homeNav,
            "addons": self.addonsNav,
            "statistics": self.statisticsNav,
            "servers": self.serversNav,
            "maps": self.mapsNav,
            "matchmaking": self.matchmakingNav,
            "screenshots": self.screenshotsNav,
            "demos": self.demosNav,
            "settings": self.settingsNav,
            "account": self.accountNav,
            "changelog": self.changelogNav,
        }
        active = nav_mapping[page]
        if (page == "matchmaking"
                and page in getattr(self, "_built_pages", set())
                and getattr(self, "_matchmaking_editor_servers", None) is None):
            self._rebuild_matchmaking_rules()
        attr = self._page_attr_names.get(page, f"{page}Page")
        widget = getattr(self, attr)
        changed = self.pages.currentWidget() is not widget

        if changed:
            launcher_settings["last_section"] = page
            if not self._history_navigation:
                if self._page_history_index < len(self._page_history) - 1:
                    self._page_history = self._page_history[:self._page_history_index + 1]
                if not self._page_history or self._page_history[-1] != page:
                    self._page_history.append(page)
                self._page_history_index = len(self._page_history) - 1

        if changed:
            self._track_diagnostics_section(page)

        # If the user beats the idle warm-up to a page, switch to its cheap
        # placeholder immediately so navigation itself never waits. Construct
        # the real QWidget tree on the next event-loop turn, then re-enter this
        # method for page-specific refreshes.
        if page in self._page_builders and page not in self._built_pages:
            if self.pages.indexOf(widget) < 0:
                self.pages.addWidget(widget)
            self.pages.setCurrentWidget(widget)
            self._sync_home_hero_timer()
            for b in nav_mapping.values():
                b.setChecked(b is active)
            self._refresh_nav_icons()
            self._move_nav_indicator(active, animate=changed)
            self._sync_media_shortcuts(page)
            self._q3_profile_navigation(page, _q3_nav_started, changed)
            QtCore.QTimer.singleShot(0, lambda p=page: self._finish_deferred_page_navigation(p))
            return

        self._sync_media_shortcuts(page)
        self.pages.setCurrentWidget(widget)
        self._sync_home_hero_timer()

        # Deliberately no QGraphicsOpacityEffect here. Fading a complete page
        # forces Qt to composite the whole widget tree into an offscreen surface
        # every animation frame; that is disproportionately expensive for the
        # textured/supersampled Obsidian material. The small nav indicator keeps
        # motion feedback while content switches at native speed.
        if page == "changelog":
            real_changelog = getattr(widget, "_q3_real_page", widget)
            follow_latest = getattr(real_changelog, "_q3news_follow_latest_to_bottom", None)
            if callable(follow_latest):
                real_changelog._q3news_follow_latest = True
                QtCore.QTimer.singleShot(120, follow_latest)
                QtCore.QTimer.singleShot(450, follow_latest)

        if page == "statistics" and not self._statistics_payload and self.statisticsNickname.text().strip():
            QtCore.QTimer.singleShot(0, self.lookup_statistics)
        if page == "account":
            self._refresh_account_ui()
            if self.accountManager.session is not None:
                QtCore.QTimer.singleShot(0, self.refresh_account_overview)
        if page == "matchmaking":
            # Opening Matchmaking marks current badge notifications as read for one minute.
            self.matchmakingBadgesHiddenUntil = time.monotonic() + 60.0
            self._update_matchmaking_status_ui()
            QtCore.QTimer.singleShot(60000, self._update_matchmaking_status_ui)

        for b in nav_mapping.values():
            b.setChecked(b is active)
        self._refresh_nav_icons()
        self._move_nav_indicator(active, animate=changed)

        if page == "settings":
            QtCore.QTimer.singleShot(0, self.prepare_launcher_sounds)
        if page == "addons":
            refresh_component_gui()
        if page == "screenshots":
            if (not getattr(self, "_screenshots_loaded", False)
                    or getattr(self, "_screenshots_dirty", True)):
                self.refresh_screenshots()
            QtCore.QTimer.singleShot(0, self.screenshotList.setFocus)
        if page == "demos":
            if (not getattr(self, "_demos_loaded", False)
                    or getattr(self, "_demos_dirty", True)):
                self.refresh_demos()
            QtCore.QTimer.singleShot(0, self.demoList.setFocus)
        if page == "maps":
            self.refresh_maps(force=False)
        if page == "changelog":
            self._refresh_changelog_notification()
        if page == "changelog" and theme_bool("performance.changelog_auto_webengine", False):
            # Optional compatibility mode. The default V4 path stays native and
            # creates no Chromium surfaces simply by opening Changelog.
            QtCore.QTimer.singleShot(0, self._activate_changelog_renderers)
        if page == "servers":
            self.serverRefreshTimer.start()
            QtCore.QTimer.singleShot(0, self._resize_servers_content)
            self.refresh_servers()
        elif hasattr(self, "serverRefreshTimer"):
            self.serverRefreshTimer.stop()

        self._q3_profile_navigation(page, _q3_nav_started, changed)

    def refresh_current_section(self):
        """F5 refreshes the active page when that page has a refresh workflow."""
        current = self.pages.currentWidget()
        page_name = next(
            (name for name, attr in self._page_attr_names.items()
             if getattr(self, attr, None) is current),
            "home",
        )
        try:
            if page_name == "home":
                refresh_updates()
            elif page_name == "maps":
                if getattr(self, "mapsMode", "local") == "online":
                    query = self.onlineMapsSearch.text().strip()
                    if query:
                        self._start_online_worker("search", query)
                    else:
                        self.onlineLatestLimit = 12
                        self._start_online_worker("latest", "")
                else:
                    self.refresh_maps(force=True)
            elif page_name == "screenshots":
                self.refresh_screenshots()
            elif page_name == "demos":
                self.refresh_demos()
            elif page_name == "servers":
                self.refresh_servers()
            elif page_name == "statistics":
                if self.statisticsNickname.text().strip():
                    self.lookup_statistics()
            elif page_name == "account":
                self.refresh_account_overview()
            elif page_name == "addons":
                refresh_component_gui()
            elif page_name == "changelog":
                real_page = getattr(self.changelogPage, "_q3_real_page", self.changelogPage)
                if getattr(real_page, "_q3news_loading", False):
                    return
                for card in list(getattr(real_page, "_q3news_cards", []) or []):
                    try:
                        real_page._q3news_feed.removeWidget(card)
                        card.setParent(None)
                        card.deleteLater()
                    except RuntimeError:
                        pass
                real_page._q3news_cards = []
                real_page._q3news_ids = []
                real_page._q3news_exhausted = False
                real_page._q3news_follow_latest = True
                self._load_q3news_page(real_page, initial=True)
            else:
                return
            if hasattr(self, "_play_launcher_sound"):
                self._play_launcher_sound("click")
        except Exception as error:
            print(f"[refresh] F5 failed for {page_name}: {error}")

    def set_navigation_enabled(self, enabled):
        for b in (self.homeNav, self.addonsNav, self.statisticsNav, self.serversNav, self.mapsNav, self.matchmakingNav, self.screenshotsNav, self.demosNav, self.accountNav, self.settingsNav, self.changelogNav, self.refreshButton):
            b.setEnabled(enabled)

    def _load_component_state_initial(self):
        """Load component state during __init__ without touching global `window`."""
        state = q3components.load_state()
        self.mapsBox.setChecked(bool(state.get("external_maps", False)))
        self.musicBox.setChecked(bool(state.get("music_playlist", False)))
        self.vulkanLayerBox.setChecked(reshade_layer_enabled())
        self.vulkanLayerBox.setText("ON" if self.vulkanLayerBox.isChecked() else "OFF")
        self.vulkanLayerBox.setEnabled(q3elite_is_installed())
        self.capture_component_baseline()

    def capture_component_baseline(self):
        self._component_baseline = {
            "maps": self.mapsBox.isChecked(),
            "music": self.musicBox.isChecked(),
            "reshade": self.vulkanLayerBox.isChecked(),
        }

    def prepare_component_actions(self):
        old = self._component_baseline
        new = {
            "maps": self.mapsBox.isChecked(),
            "music": self.musicBox.isChecked(),
            "reshade": self.vulkanLayerBox.isChecked(),
        }
        actions = []
        if old.get("maps") != new["maps"]:
            actions.append("install-maps" if new["maps"] else "remove-maps")
        if old.get("music") != new["music"]:
            actions.append("install-music" if new["music"] else "remove-music")
        if old.get("reshade") != new["reshade"]:
            actions.append("enable-reshade" if new["reshade"] else "disable-reshade")
        self.pending_component_actions = actions

    def take_next_component_action(self):
        if not self.pending_component_actions:
            return None
        return self.pending_component_actions.pop(0)

    def _notify_sound_volume_changed(self, value):
        value = max(0, min(100, int(value)))
        if hasattr(self, "notifySoundPercent"):
            self.notifySoundPercent.setText(f"{value}%")
        self._apply_matchmaking_sound_volume(value)

    def _launcher_sound_volume_changed(self, value):
        value = max(0, min(100, int(value)))
        if hasattr(self, "launcherSoundPercent"):
            self.launcherSoundPercent.setText(f"{value}%")
        self._apply_launcher_sound_volume(value)

    def _apply_launcher_sound_volume(self, value=None):
        launcher_slider = getattr(self, "launcherSoundSlider", None)
        launcher_master = launcher_slider.value() if launcher_slider is not None else launcher_settings.get("launcher_sound_volume", 30)
        notify_slider = getattr(self, "notifySoundSlider", None)
        notify_master = notify_slider.value() if notify_slider is not None else launcher_settings.get("matchmaking_sound_volume", 30)
        for sound_key, voices in getattr(self, "launcherSoundPlayers", {}).items():
            master = notify_master if sound_key == "notify" else launcher_master
            volume = max(0.0, min(1.0, float(master) / 100.0)) * (LAUNCHER_SFX_VOLUMES.get(sound_key, 100) / 100.0)
            for _player, audio in voices:
                try:
                    audio.setVolume(volume)
                except RuntimeError:
                    pass

    def _launcher_sound_master_volume(self, sound_key):
        if sound_key == "notify":
            slider = getattr(self, "notifySoundSlider", None)
            value = slider.value() if slider is not None else launcher_settings.get("matchmaking_sound_volume", 30)
        else:
            slider = getattr(self, "launcherSoundSlider", None)
            value = slider.value() if slider is not None else launcher_settings.get("launcher_sound_volume", 30)
        return max(0.0, min(1.0, float(value) / 100.0))

    def _get_launcher_sound_player(self, sound_key, path, *, new_voice=False):
        players = getattr(self, "launcherSoundPlayers", None)
        if players is None:
            players = {}
            self.launcherSoundPlayers = players
        voices = players.setdefault(sound_key, [])
        if not new_voice:
            for pair in voices:
                player, _audio = pair
                if (player.playbackState() == QtMultimedia.QMediaPlayer.PlaybackState.PlayingState
                        or bool(getattr(player, "_launcherPlayRequested", False))):
                    continue
                if player.source().toLocalFile() != str(path):
                    player.setSource(QtCore.QUrl.fromLocalFile(str(path)))
                return pair

        audio = QtMultimedia.QAudioOutput(self)
        audio.setVolume(
            self._launcher_sound_master_volume(sound_key)
            * (LAUNCHER_SFX_VOLUMES.get(sound_key, 100) / 100.0)
        )
        player = QtMultimedia.QMediaPlayer(self)
        player._launcherPlayRequested = False
        player.setAudioOutput(audio)
        player.playbackStateChanged.connect(
            lambda state, p=player: self._launcher_player_state_changed(p, state)
        )
        player.errorOccurred.connect(
            lambda error, message, p=player, f=path, k=sound_key: self._launcher_player_error(
                p, k, f, error, message
            )
        )
        player.setSource(QtCore.QUrl.fromLocalFile(str(path)))
        pair = (player, audio)
        voices.append(pair)
        return pair

    def _launcher_player_state_changed(self, player, state):
        if state == QtMultimedia.QMediaPlayer.PlaybackState.StoppedState:
            player._launcherPlayRequested = False
        elif state == QtMultimedia.QMediaPlayer.PlaybackState.PlayingState:
            player._launcherPlayRequested = True

    @staticmethod
    def _launcher_player_error(player, sound_key, path, error, message):
        player._launcherPlayRequested = False

    def _launcher_active_sound_count(self, sound_keys=None):
        if QtMultimedia is None:
            return 0
        playing = QtMultimedia.QMediaPlayer.PlaybackState.PlayingState
        players = getattr(self, "launcherSoundPlayers", {})
        keys = sound_keys if sound_keys is not None else players.keys()
        return sum(
            player.playbackState() == playing
            for key in keys
            for voices in (players.get(key, ()),)
            for player, _audio in voices
        )

    def prepare_launcher_sounds(self):
        """Warm local media sources after the first frame to avoid hover stutter."""
        if _ensure_qtmultimedia() is None:
            return
        if launcher_settings.get("launcher_sounds_enabled", False):
            keys = tuple(LAUNCHER_SFX_FILES)
        else:
            # Let the master switch make its ON/OFF feedback audible even when
            # all regular launcher sounds are currently disabled.
            keys = ("toggle_on", "toggle_off", "notify")
        for key in keys:
            filename = LAUNCHER_SFX_FILES.get(key)
            if not filename:
                continue
            path = LAUNCHER_SFX_DIR / filename
            if key == "notify" and not path.is_file():
                path = resolve_notify_sound() or path
            if path.is_file():
                try:
                    if key in {"hover", "list_hover", "map_hover"}:
                        voice_count = 4
                    elif key in {"click", "toggle_on", "toggle_off", "notify"}:
                        voice_count = 2
                    else:
                        voice_count = 1
                    existing_count = len(getattr(self, "launcherSoundPlayers", {}).get(key, []))
                    for voice_index in range(existing_count, voice_count):
                        self._get_launcher_sound_player(key, path, new_voice=voice_index > 0)
                except Exception:
                    pass

    def _play_launcher_sound(self, sound_key, *, force=False):
        if not force and not launcher_settings.get("launcher_sounds_enabled", False):
            return False
        if sound_key == "start_button" and not launcher_settings.get("launcher_start_button_sound_enabled", True):
            return False
        if sound_key == "startup" and not launcher_settings.get("launcher_startup_sound_enabled", False):
            return False
        if _ensure_qtmultimedia() is None:
            return False
        filename = LAUNCHER_SFX_FILES.get(str(sound_key))
        if not filename:
            return False
        path = LAUNCHER_SFX_DIR / filename
        if not path.is_file():
            if sound_key == "notify":
                legacy_path = resolve_notify_sound()
                if legacy_path is not None:
                    path = legacy_path
        if not path.is_file():
            warned = getattr(self, "_launcherSfxMissing", set())
            if sound_key not in warned:
                warned.add(sound_key)
                self._launcherSfxMissing = warned
            return False
        try:
            # Wheel/keyboard list stepping can emit dozens of events per second.
            # Reuse the prepared voice and skip while its short sound is active.
            if sound_key == "list_scroll":
                now = time.monotonic()
                if now - float(getattr(self, "_listScrollSoundLastAt", 0.0)) < 0.07:
                    return False
                voices = getattr(self, "launcherSoundPlayers", {}).get(sound_key, ())
                if any(player.playbackState() == QtMultimedia.QMediaPlayer.PlaybackState.PlayingState
                       or bool(getattr(player, "_launcherPlayRequested", False))
                       for player, _audio in voices):
                    return False
                self._listScrollSoundLastAt = now
            # Only hover effects have an overlap cap. Action sounds (especially
            # a click following a hover) always get their own voice.
            if sound_key in {"hover", "list_hover", "map_hover"} and self._launcher_active_sound_count(
                {"hover", "list_hover", "map_hover"}
            ) >= 4:
                return False
            pair = self._get_launcher_sound_player(sound_key, path)
            player, audio = pair
            player._launcherPlayRequested = True
            audio.setVolume(
                self._launcher_sound_master_volume(sound_key)
                * (LAUNCHER_SFX_VOLUMES.get(sound_key, 100) / 100.0)
            )
            # _get_launcher_sound_player returns an idle voice or creates a new
            # one, so overlapping events never stop or restart an active sound.
            if player.position() > 0:
                player.setPosition(0)
            player.play()
            return True
        except Exception:
            return False

    def test_launcher_sound(self):
        if self._play_launcher_sound("click", force=True):
            self.settingsMessage.setText("Playing launcher click sound.")
        else:
            self.settingsMessage.setText(
                f"Could not play launcher click sound. Add {LAUNCHER_SFX_FILES['click']} to {LAUNCHER_SFX_DIR}."
            )

    def _apply_matchmaking_sound_volume(self, value=None):
        self._apply_launcher_sound_volume()

    def _play_matchmaking_sound(self):
        if _ensure_qtmultimedia() is None:
            return False
        path = resolve_notify_sound()
        if path is None:
            return False
        played = self._play_launcher_sound("notify", force=True)
        return played

    def _set_proxy_fields_enabled(self, enabled):
        enabled = bool(enabled)
        for name in ("proxyUrlEdit", "proxyUsernameEdit", "proxyPasswordEdit"):
            widget = getattr(self, name, None)
            if widget is not None:
                widget.setEnabled(enabled)
        if hasattr(self, "proxyTestButton"):
            self.proxyTestButton.setEnabled(enabled and network_proxy is not None)

    def test_network_proxy(self):
        if network_proxy is None:
            self.proxyStatusLabel.setText("Proxy module is unavailable. Check Launcher/modules/network_proxy.py.")
            return
        self.proxyTestButton.setEnabled(False)
        self.proxyStatusLabel.setText("Testing proxy connection...")
        QtWidgets.QApplication.processEvents()
        try:
            ok, message = network_proxy.test_connection(
                self.proxyUrlEdit.text(),
                self.proxyUsernameEdit.text(),
                self.proxyPasswordEdit.text(),
            )
            self.proxyStatusLabel.setText(message)
            self.proxyStatusLabel.setProperty("error", not bool(ok))
        except Exception as error:
            self.proxyStatusLabel.setText(f"Proxy test failed: {error}")
            self.proxyStatusLabel.setProperty("error", True)
        finally:
            self.proxyTestButton.setEnabled(self.proxyEnabledBox.isChecked())
            self.proxyStatusLabel.style().unpolish(self.proxyStatusLabel)
            self.proxyStatusLabel.style().polish(self.proxyStatusLabel)

    def save_network_proxy(self):
        if network_proxy is None:
            self.proxyStatusLabel.setText("Proxy module is unavailable. Check Launcher/modules/network_proxy.py.")
            return
        try:
            network_proxy.save_settings(
                self.proxyEnabledBox.isChecked(),
                self.proxyUrlEdit.text(),
                self.proxyUsernameEdit.text(),
                self.proxyPasswordEdit.text(),
            )
            state = "enabled" if self.proxyEnabledBox.isChecked() else "disabled"
            self.proxyStatusLabel.setText(f"Proxy settings saved ({state}).")
            print(f"[proxy] Settings saved; proxy {state}.")
        except Exception as error:
            self.proxyStatusLabel.setText(f"Could not save proxy settings: {error}")
            self.proxyStatusLabel.setProperty("error", True)
        self.proxyStatusLabel.style().unpolish(self.proxyStatusLabel)
        self.proxyStatusLabel.style().polish(self.proxyStatusLabel)

