    def play_online_map(self,item):
        installed=_online_installed_files(item)
        if not installed:return
        self._play_launcher_sound("start_button")

        candidates=[]
        for name in installed:
            pk3=DOWNLOADED_MAPS_DIR/Path(name).name
            if not pk3.is_file():continue
            try:
                for entry in _scan_map_pk3(pk3,extract_levelshots=False):
                    bsp=str(entry.get("map") or "").strip()
                    if bsp and bsp not in candidates:candidates.append(bsp)
            except Exception as error:
                print(f"[online maps] BSP scan failed: {pk3.name} -> {type(error).__name__}: {error}")

        if not candidates:
            self.mapsStatus.setText("PLAY failed: downloaded PK3 contains no maps/*.bsp")
            return

        # Prefer the BSP matching the source map/file slug. If the package
        # contains one map, simply use that exact BSP name.
        hints=[
            str(item.get("map") or "").strip().casefold(),
            Path(str(item.get("pak") or "")).stem.casefold(),
        ]
        bsp_name=""
        for candidate in candidates:
            if candidate.casefold() in hints:
                bsp_name=candidate; break
        if not bsp_name:
            bsp_name=candidates[0]

        # Identical launch path/arguments to LOCAL maps.
        self.play_local_map(bsp_name, play_action_sound=False)

    def download_online_map(self,item):
        key=_online_map_key(item)
        current=self.onlineDownloadByKey.get(key)
        if current is not None and current.isRunning():return
        w=OnlineMapDownloadWorker(item,self)
        self.onlineDownloadWorkers.append(w)
        self.onlineDownloadByKey[key]=w
        row=self._online_row_for_item(item)
        w.progress.connect(lambda p,x=dict(item):self._online_download_progress(p,x))
        w.paused.connect(lambda x=dict(item):self._online_download_paused(x))
        w.ready.connect(lambda name,x=dict(item):self._online_download_ready(name,x))
        w.failed.connect(lambda e,x=dict(item):self._online_download_failed(e,x))
        w.finished.connect(lambda x=w,k=key,d=dict(item):self._online_download_done(x,k,d))
        w.start()
        if row>=0:
            self._set_online_row_action(row,item)
            self.onlineMapsTable.selectRow(row)

    def pause_online_map(self,item):
        w=self.onlineDownloadByKey.get(_online_map_key(item))
        if w is not None and w.isRunning():
            self.mapsStatus.setText("Pausing download…")
            w.request_pause()

    def _online_download_progress(self,p,item):
        self.mapsStatus.setText(f"Downloading… {p}%")

    def _online_download_paused(self,item):
        self.mapsStatus.setText("Download paused • partial file kept")

    def delete_online_map(self,item):
        row=self._online_row_for_item(item)
        names=_online_installed_files(item)
        deleted=[]
        for name in names:
            path=DOWNLOADED_MAPS_DIR/Path(name).name
            try:
                if path.is_file():
                    path.unlink(); deleted.append(path.name)
            except OSError as error:
                self.mapsStatus.setText(f"Delete failed: {error}")
                return
        _forget_online_install(item)
        partials=[_online_partial_path(item)]
        rawpak=Path(str(item.get("pak") or "").replace("\\","/")).name
        if rawpak:partials.append(DOWNLOADED_MAPS_DIR/(rawpak+".part"))
        if item.get("source")=="LvLWorld":
            ident=str(item.get("lvl_id") or item.get("map") or "online_map")
            legacy=re.sub(r'[^A-Za-z0-9._-]+',"_",ident).strip("._")+".zip.part"
            partials.append(DOWNLOADED_MAPS_DIR/legacy)
        for partial in partials:
            try:partial.unlink(missing_ok=True)
            except OSError:pass
        # Force the local catalog to forget the deleted PK3 instead of retaining
        # stale manifest state until a later full rebuild.
        try:MAPS_MANIFEST_FILE.unlink(missing_ok=True)
        except OSError:pass
        self.mapsStatus.setText("Deleted "+(", ".join(deleted) if deleted else "downloaded map"))
        self.refresh_maps(force=False)
        # Do not rebuild ONLINE results: preserve selection, scroll, metadata,
        # thumbnails and the user's current place in the list.
        if row >= 0:
            self._set_online_row_action(row,item)
            self.onlineMapsTable.selectRow(row)


    def _online_download_done(self,w,key=None,item=None):
        if w in self.onlineDownloadWorkers:self.onlineDownloadWorkers.remove(w)
        if key and self.onlineDownloadByKey.get(key) is w:
            self.onlineDownloadByKey.pop(key,None)
        if isinstance(item,dict):
            row=self._online_row_for_item(item)
            if row>=0:
                self._set_online_row_action(row,item)
                self.onlineMapsTable.selectRow(row)

    def _online_download_failed(self,error,item):
        self.mapsStatus.setText(f"Download failed: {error}")

    def _online_download_ready(self,name,item=None):
        self.mapsStatus.setText(f"Downloaded {name}")
        self.refresh_maps(force=False)
        # Update only the action cell. Re-running search/latest here used to
        # clear selection, reset row state and make keyboard use frustrating.
        if isinstance(item,dict):
            row=self._online_row_for_item(item)
            if row >= 0:
                self._set_online_row_action(row,item)
                self.onlineMapsTable.selectRow(row)


    def _build_map_levelshot_index(self):
        supported = {".jpg", ".jpeg", ".png", ".webp", ".tga"}
        index = {}
        # Preserve old priority exactly: managed !, local !, managed normal, local normal.
        buckets = [[], [], [], []]
        for directory, base in ((MAP_LEVELSHOTS_DIR, 0), (MAP_DISCOVERED_LEVELSHOTS_DIR, 1)):
            if not directory.is_dir():
                continue
            try:
                paths = sorted(
                    (p for p in directory.iterdir() if p.is_file() and p.suffix.casefold() in supported),
                    key=lambda p: p.name.casefold(),
                )
            except OSError:
                continue
            for path in paths:
                stem = path.stem
                important = stem.startswith("!")
                if important:
                    stem = stem[1:]
                bucket = base if important else base + 2
                for alias in (part.strip().casefold() for part in stem.split("&")):
                    if alias:
                        buckets[bucket].append((alias, path))
        for bucket in buckets:
            for alias, path in bucket:
                index.setdefault(alias, []).append(path)
        return index

    def _map_levelshot_pixmap(self, item):
        """Resolve levelshots from one prebuilt directory index, not N directory scans."""
        bsp = str(item.get("map", "") or "").strip().casefold()
        index = getattr(self, "_map_levelshot_index", None)
        if index is None:
            self._map_levelshot_index = self._build_map_levelshot_index()
            index = self._map_levelshot_index
        candidates = list(index.get(bsp, []))
        levelshot = str(item.get("levelshot", "") or "")
        if levelshot:
            candidates.append(Path(levelshot))
        candidates.extend([
            MAP_UNKNOWN_LEVELSHOT,
            ASSETS_DIR / "servers" / "levelshots" / "unknownmap.png",
            ASSETS_DIR / "servers" / "levelshots" / "unknown.png",
        ])
        for path in candidates:
            if path.is_file():
                pix = _load_map_levelshot_pixmap(path, QtCore.QSize(144, 82))
                if not pix.isNull():
                    return pix
        return QtGui.QPixmap()

    def refresh_maps(self, force=False):
        if getattr(self, "_maps_loaded", False) and not force:
            return
        if self.mapCatalogWorker is not None and self.mapCatalogWorker.isRunning():
            return
        if force:
            # Force a fresh directory/stat pass, but KEEP the manifest.
            # Deleting it here invalidates every PK3 cache entry and forces
            # every archive to be opened and parsed again on each refresh.
            # A forced refresh bypasses startup preload only; the worker still
            # validates every PK3 against its size/mtime_ns signature.
            self._map_catalog_future = None

        preload = getattr(self, "_map_catalog_future", None)
        if not force and preload is not None:
            self.mapsStatus.setText("Loading cached map catalog…" if preload.done() else "Scanning local maps in background…")
            self.mapsRefreshButton.setEnabled(False)
            if preload.done():
                try:
                    maps, changed = preload.result()
                    self._map_catalog_future = None
                    self._maps_catalog_ready(maps, changed)
                    return
                except Exception as error:
                    print(f"[maps] Startup preload failed: {error}")
                    self._map_catalog_future = None
            else:
                QtCore.QTimer.singleShot(45, self._consume_map_catalog_preload)
                return

        self.mapsStatus.setText("Scanning local maps…")
        self.mapsRefreshButton.setEnabled(False)
        self.mapCatalogWorker = MapCatalogWorker(self)
        self.mapCatalogWorker.ready.connect(self._maps_catalog_ready)
        self.mapCatalogWorker.failed.connect(self._maps_catalog_failed)
        self.mapCatalogWorker.start()

    def _consume_map_catalog_preload(self):
        if getattr(self, "_maps_loaded", False) or not hasattr(self, "mapsTable"):
            return
        future = getattr(self, "_map_catalog_future", None)
        if future is None:
            return self.refresh_maps(force=False)
        if not future.done():
            QtCore.QTimer.singleShot(45, self._consume_map_catalog_preload)
            return
        try:
            maps, changed = future.result()
            self._map_catalog_future = None
            self._maps_catalog_ready(maps, changed)
        except Exception as error:
            print(f"[maps] Startup preload failed: {error}")
            self._map_catalog_future = None
            self.refresh_maps(force=False)

    def _maps_catalog_failed(self, message):
        self.mapsRefreshButton.setEnabled(True)
        self.mapsStatus.setText("Map scan failed")
        self.qerror(f"Could not scan local maps:\n{message}")

    def _maps_catalog_ready(self, maps, changed_paks):
        self.localMaps = list(maps or [])
        self._maps_loaded = True
        self.mapsRefreshButton.setEnabled(True)
        suffix = f" • scanned {changed_paks} new/changed PAK(s)" if changed_paks else " • manifest cache"
        self.mapsStatus.setText(f"{len(self.localMaps)} local map(s){suffix}")
        self._populate_maps_table()

    @staticmethod
    def _map_gametype_sort_key(item):
        order = {"FFA": 0, "TDM": 1, "Duel": 2, "CTF": 3, "Unknown": 9}
        gt = str(item.get("gametype", "Unknown") or "Unknown")
        first = gt.split(" / ", 1)[0]
        return (order.get(first, 8), gt.casefold(), str(item.get("name", "")).casefold())

    def _visible_maps(self):
        items = list(self.localMaps)
        if self.mapsLocationFilter != "All":
            items = [x for x in items if x.get("location") == self.mapsLocationFilter]
        if self.mapsGametypeSort == 1:
            items.sort(key=lambda x: (str(x.get("name", "")).casefold(), str(x.get("pak", "")).casefold()), reverse=True)
        elif self.mapsGametypeSort == 2:
            items.sort(key=self._map_gametype_sort_key)
        elif self.mapsGametypeSort == 3:
            items.sort(key=self._map_gametype_sort_key, reverse=True)
        else:
            items.sort(key=lambda x: (str(x.get("name", "")).casefold(), str(x.get("pak", "")).casefold()))
        return items

    def _schedule_map_thumbnail_load(self, *_args):
        """Queue one viewport-aware thumbnail pass; scrolling prioritizes visible rows."""
        if getattr(self, "_map_thumbnail_load_pending", False):
            return
        self._map_thumbnail_load_pending = True
        QtCore.QTimer.singleShot(0, self._load_visible_map_thumbnails)

    def _schedule_map_thumbnail_prefetch(self, delay=25):
        """Load remaining local thumbnails gradually while the Local Maps view is active."""
        if getattr(self, "_map_thumbnail_prefetch_pending", False):
            return
        if not getattr(self, "_map_population_complete", False):
            return
        self._map_thumbnail_prefetch_pending = True
        QtCore.QTimer.singleShot(max(0, int(delay)), self._load_next_map_thumbnail_prefetch_batch)

    def _load_visible_map_thumbnails(self):
        self._map_thumbnail_load_pending = False
        table = getattr(self, "mapsTable", None)
        if (table is None or not table.isVisible()
                or getattr(self, "mapsMode", "local") != "local"
                or not getattr(self, "_map_population_complete", False)):
            return
        row_count = table.rowCount()
        if row_count <= 0:
            return

        viewport = table.viewport()
        first = table.rowAt(0)
        last = table.rowAt(max(0, viewport.height() - 1))
        if first < 0:
            first = 0
        if last < first:
            last = min(row_count - 1, first + 5)

        # Decode visible thumbnails plus a small forward buffer first. The
        # remaining catalog is filled in short background batches.
        stop = min(row_count, last + 1 + 8)
        _load_t0 = time.perf_counter()
        _decode_ms = 0.0
        loaded = 0
        attempted = 0
        table.setUpdatesEnabled(False)
        try:
            for row in range(first, stop):
                if table.isRowHidden(row):
                    continue
                cell = table.item(row, 0)
                if cell is None or bool(cell.data(LocalMapsThumbnailDelegate.ATTEMPTED_ROLE)):
                    continue
                cell.setData(LocalMapsThumbnailDelegate.ATTEMPTED_ROLE, True)
                item = cell.data(QtCore.Qt.ItemDataRole.UserRole) or {}
                if not isinstance(item, dict):
                    continue
                _decode_t0 = time.perf_counter()
                pix = self._map_levelshot_pixmap(item)
                _decode_ms += (time.perf_counter() - _decode_t0) * 1000.0
                attempted += 1
                if pix is not None and not pix.isNull():
                    cell.setData(LocalMapsThumbnailDelegate.THUMBNAIL_ROLE, QtGui.QPixmap(pix))
                    loaded += 1
        finally:
            table.setUpdatesEnabled(True)
        if attempted:
            table.viewport().update()
            _map_profile_log(
                "lazy_thumbnail_batch",
                rows=f"{first}-{stop}",
                attempted=attempted,
                loaded=loaded,
                decode_ms=_decode_ms,
                total=(time.perf_counter() - _load_t0) * 1000.0,
                cache_hits=_MAP_LEVELSHOT_CACHE_STATS["hits"],
                cache_misses=_MAP_LEVELSHOT_CACHE_STATS["misses"],
            )
        self._schedule_map_thumbnail_prefetch(25)

    def _load_next_map_thumbnail_prefetch_batch(self):
        self._map_thumbnail_prefetch_pending = False
        table = getattr(self, "mapsTable", None)
        if (table is None or not table.isVisible()
                or getattr(self, "mapsMode", "local") != "local"
                or not getattr(self, "_map_population_complete", False)):
            return

        row_count = table.rowCount()
        cursor = max(0, int(getattr(self, "_map_thumbnail_prefetch_cursor", 0)))
        if row_count <= 0 or cursor >= row_count:
            return

        # Four images per pass keeps work bounded and gives Qt time to paint/respond.
        batch_limit = max(1, min(6, theme_int("performance.map_thumbnail_prefetch_batch", 4)))
        _load_t0 = time.perf_counter()
        _decode_ms = 0.0
        attempted = 0
        loaded = 0
        first_row = cursor
        last_row = cursor
        table.setUpdatesEnabled(False)
        try:
            while cursor < row_count and attempted < batch_limit:
                row = cursor
                cursor += 1
                last_row = row
                if table.isRowHidden(row):
                    continue
                cell = table.item(row, 0)
                if cell is None or bool(cell.data(LocalMapsThumbnailDelegate.ATTEMPTED_ROLE)):
                    continue
                cell.setData(LocalMapsThumbnailDelegate.ATTEMPTED_ROLE, True)
                item = cell.data(QtCore.Qt.ItemDataRole.UserRole) or {}
                if not isinstance(item, dict):
                    continue
                _decode_t0 = time.perf_counter()
                pix = self._map_levelshot_pixmap(item)
                _decode_ms += (time.perf_counter() - _decode_t0) * 1000.0
                attempted += 1
                if pix is not None and not pix.isNull():
                    cell.setData(LocalMapsThumbnailDelegate.THUMBNAIL_ROLE, QtGui.QPixmap(pix))
                    loaded += 1
        finally:
            table.setUpdatesEnabled(True)

        self._map_thumbnail_prefetch_cursor = cursor
        if attempted:
            table.viewport().update()
            _map_profile_log(
                "lazy_thumbnail_prefetch_batch",
                rows=f"{first_row}-{last_row + 1}",
                attempted=attempted,
                loaded=loaded,
                decode_ms=_decode_ms,
                total=(time.perf_counter() - _load_t0) * 1000.0,
                cache_hits=_MAP_LEVELSHOT_CACHE_STATS["hits"],
                cache_misses=_MAP_LEVELSHOT_CACHE_STATS["misses"],
            )

        if cursor < row_count:
            self._schedule_map_thumbnail_prefetch(25)

    def _populate_maps_table(self):
        table = self.mapsTable
        # V23.1: keep the existing table when navigating away and back. The
        # manifest caches PK3 contents; this avoids rebuilding table items and
        # decoding levelshot thumbnails on every Maps visit.
        if (getattr(self, "_map_table_built_for_catalog", False)
                and getattr(self, "_map_population_complete", False)
                and table.rowCount() == len(self._visible_maps())):
            self._filter_maps_table(self.mapsSearch.text())
            self._sort_maps_table_fast()
            return
        _populate_t0 = time.perf_counter()
        self._map_population_started_at = _populate_t0
        self._map_population_complete = False
        self._map_thumbnail_prefetch_cursor = 0
        self._map_population_serial = int(getattr(self, "_map_population_serial", 0)) + 1
        serial = self._map_population_serial
        _visible_t0 = time.perf_counter()
        items = self._visible_maps()
        _visible_ms = (time.perf_counter() - _visible_t0) * 1000.0
        _index_t0 = time.perf_counter()
        self._map_levelshot_index = self._build_map_levelshot_index()
        _index_ms = (time.perf_counter() - _index_t0) * 1000.0
        self._map_population_items = items
        _reset_t0 = time.perf_counter()
        table.setUpdatesEnabled(False)
        table.clearContents()
        table.setRowCount(len(items))
        table.setUpdatesEnabled(True)
        _reset_ms = (time.perf_counter() - _reset_t0) * 1000.0
        _map_profile_log(
            "table_prepare",
            rows=len(items),
            visible_sort=_visible_ms,
            levelshot_index=_index_ms,
            table_reset=_reset_ms,
            total=(time.perf_counter() - _populate_t0) * 1000.0,
        )
        self.mapsStatus.setText(f"Loading {len(items)} local map(s)…")
        QtCore.QTimer.singleShot(0, lambda s=serial: self._populate_maps_table_batch(s, 0))

    def _populate_maps_table_batch(self, serial, start_row):
        if serial != getattr(self, "_map_population_serial", -1):
            return
        table = self.mapsTable
        items = getattr(self, "_map_population_items", [])
        batch = max(16, theme_int("performance.map_population_batch", 16))
        stop = min(len(items), start_row + batch)
        _batch_t0 = time.perf_counter()
        _pixmap_ms = 0.0
        _thumbnail_widget_ms = 0.0
        _thumbnail_cache_hits_before = _MAP_THUMBNAIL_CACHE_HITS
        _thumbnail_cache_misses_before = _MAP_THUMBNAIL_CACHE_MISSES
        _row_items_ms = 0.0
        _action_widget_ms = 0.0
        _row_height_ms = 0.0
        _thumbnail_cell_ms = 0.0
        _action_container_ms = 0.0
        _action_cell_attach_ms = 0.0
        _widgets_t0 = time.perf_counter()
        # These values are identical for every row in the batch.
        action_gap = theme_int("maps.action_gap", 8)
        primary_w = theme_int("maps.primary_action_width", 116)
        delete_w = theme_int("maps.delete_action_width", 40)
        delete_icon = _map_delete_icon() if qta is not None else QtGui.QIcon()
        table.setUpdatesEnabled(False)
        try:
            for row in range(start_row, stop):
                item = items[row]
                # V19: all Local Maps rows use the same 92px height. Set it once
                # on the vertical header instead of issuing 157 per-row calls.
                shot_item = QtWidgets.QTableWidgetItem()
                _thumb_cell_t0 = time.perf_counter()
                # Keep the complete map payload in the cell, but decode its
                # levelshot only when the row is visible (plus a small buffer).
                shot_item.setData(QtCore.Qt.ItemDataRole.UserRole, item)
                table.setItem(row, 0, shot_item)
                _thumbnail_cell_ms += (time.perf_counter() - _thumb_cell_t0) * 1000.0

                _row_items_t0 = time.perf_counter()
                map_name = str(item.get("name") or item.get("map") or "Unknown")
                map_item = MapTableSortItem(
                    map_name,
                    (map_name.casefold(), str(item.get("pak", "")).casefold()),
                )
                map_item.setToolTip(f"BSP: {item.get('map', '')}\nLocation: {item.get('location', 'External')}")
                table.setItem(row, 1, map_item)
                pak_item = QtWidgets.QTableWidgetItem(str(item.get("pak", "")))
                pak_item.setToolTip(str(item.get("pak_path", "")))
                table.setItem(row, 2, pak_item)
                size_item = QtWidgets.QTableWidgetItem(_human_file_size(item.get("pak_size")))
                size_item.setTextAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
                table.setItem(row, 3, size_item)
                gametype = str(item.get("gametype", "Unknown"))
                table.setItem(
                    row, 4,
                    MapTableSortItem(gametype, self._map_gametype_sort_key(item)),
                )
                _row_items_ms += (time.perf_counter() - _row_items_t0) * 1000.0

                _action_container_t0 = time.perf_counter()
                # V21: PLAY/DELETE are painted by LocalMapsActionsDelegate.
                # Store only the row payload; avoid creating and attaching a
                # QWidget + layout + two QPushButtons for every map.
                action_item = QtWidgets.QTableWidgetItem()
                action_item.setData(QtCore.Qt.ItemDataRole.UserRole, item)
                pak_path = str(item.get("pak_path", "") or "")
                protected = self._map_pak_is_protected(Path(pak_path))
                action_item.setToolTip(
                    "Protected Q3/Q3Elite content cannot be deleted."
                    if protected else
                    "PLAY launches this map; trash removes its PK3 from disk."
                )
                _action_container_ms += (time.perf_counter() - _action_container_t0) * 1000.0

                _attach_t0 = time.perf_counter()
                table.setItem(row, 5, action_item)
                _action_cell_attach_ms += (time.perf_counter() - _attach_t0) * 1000.0
        finally:
            table.setUpdatesEnabled(True)
        _widgets_ms = (time.perf_counter() - _widgets_t0) * 1000.0 - _pixmap_ms
        _batch_ms = (time.perf_counter() - _batch_t0) * 1000.0
        _map_profile_log(
            "table_batch",
            rows=f"{start_row}-{stop}",
            count=stop - start_row,
            levelshot_decode=_pixmap_ms,
            thumbnail_delegate_setup=_thumbnail_widget_ms,
            thumbnail_cache_hits=_MAP_THUMBNAIL_CACHE_HITS - _thumbnail_cache_hits_before,
            thumbnail_cache_misses=_MAP_THUMBNAIL_CACHE_MISSES - _thumbnail_cache_misses_before,
            row_items=_row_items_ms,
            thumbnail_cell=_thumbnail_cell_ms,
            action_container=_action_container_ms,
            action_widgets=_action_widget_ms,
            action_cell_attach=_action_cell_attach_ms,
            action_rendering="delegate_cached_prototypes",
            row_height_mode="default_92px",
            row_widgets=_widgets_ms,
            total=_batch_ms,
        )
        table.viewport().update()

        if stop < len(items):
            self.mapsStatus.setText(f"Loading local maps… {stop}/{len(items)}")
            QtCore.QTimer.singleShot(0, lambda s=serial, r=stop: self._populate_maps_table_batch(s, r))
            return

        self._filter_maps_table(self.mapsSearch.text())
        if table.rowCount() and table.currentRow() < 0:
            table.selectRow(0)
        self._map_population_complete = True
        self._map_table_built_for_catalog = True
        _finalize_t0 = time.perf_counter()
        self._sort_maps_table_fast()
        self._schedule_map_thumbnail_load()
        _map_profile_log(
            "table_complete",
            rows=len(items),
            finalize_sort_filter=(time.perf_counter() - _finalize_t0) * 1000.0,
            levelshot_cache_hits=_MAP_LEVELSHOT_CACHE_STATS["hits"],
            levelshot_cache_misses=_MAP_LEVELSHOT_CACHE_STATS["misses"],
            levelshot_cache_decode_ms=_MAP_LEVELSHOT_CACHE_STATS["decode_ms"],
            levelshot_cache_mb=round(_MAP_LEVELSHOT_DECODE_CACHE.bytes_used / (1024.0 * 1024.0), 2),
            elapsed_since_prepare=(
                time.perf_counter() - getattr(self, "_map_population_started_at", time.perf_counter())
            ) * 1000.0,
        )
        self.mapsStatus.setText(f"{len(self.localMaps)} local map(s) • ready")

    def _filter_maps_table(self, query):
        if not hasattr(self, "mapsTable"):
            return
        self._map_thumbnail_prefetch_cursor = 0
        _filter_t0 = time.perf_counter()
        q = str(query or "").strip().casefold()
        for row in range(self.mapsTable.rowCount()):
            data_item = self.mapsTable.item(row, 0)
            data = data_item.data(QtCore.Qt.ItemDataRole.UserRole) if data_item else {}
            haystack = " ".join(str(data.get(k, "")) for k in ("name", "map", "pak", "gametype", "location")).casefold()
            search_hidden = bool(q and q not in haystack)
            location_hidden = (
                self.mapsLocationFilter != "All"
                and data.get("location") != self.mapsLocationFilter
            )
            self.mapsTable.setRowHidden(row, search_hidden or location_hidden)
        _map_profile_log(
            "table_filter",
            rows=self.mapsTable.rowCount(),
            query_length=len(q),
            total=(time.perf_counter() - _filter_t0) * 1000.0,
        )
        self._schedule_map_thumbnail_load()

    def focus_maps_search(self):
        self.mapsSearch.setFocus()
        self.mapsSearch.selectAll()

    def cycle_maps_gametype_sort(self):
        self.mapsGametypeSort = (self.mapsGametypeSort + 1) % 4
        labels = {0: "NAME ↑", 1: "NAME ↓", 2: "GAMETYPE ↑", 3: "GAMETYPE ↓"}
        self.mapsSortButton.setText(labels[self.mapsGametypeSort])
        self.mapsSortButton.setProperty("active", self.mapsGametypeSort != 0)
        self.mapsSortButton.style().unpolish(self.mapsSortButton)
        self.mapsSortButton.style().polish(self.mapsSortButton)
        self._save_launcher_preference("maps_sort_mode", self.mapsGametypeSort)
        if getattr(self, "_map_population_complete", False):
            self._sort_maps_table_fast()

    def _sort_maps_table_fast(self):
        """Reorder existing local map rows without rescanning or rebuilding thumbnails."""
        table = getattr(self, "mapsTable", None)
        self._map_thumbnail_prefetch_cursor = 0
        if table is None or table.rowCount() < 2:
            return
        if self.mapsGametypeSort in (0, 1):
            column = 1
            order = (
                QtCore.Qt.SortOrder.DescendingOrder
                if self.mapsGametypeSort == 1
                else QtCore.Qt.SortOrder.AscendingOrder
            )
        else:
            column = 4
            order = (
                QtCore.Qt.SortOrder.DescendingOrder
                if self.mapsGametypeSort == 3
                else QtCore.Qt.SortOrder.AscendingOrder
            )
        _sort_t0 = time.perf_counter()
        table.setUpdatesEnabled(False)
        try:
            table.sortItems(column, order)
            self._filter_maps_table(self.mapsSearch.text())
        finally:
            table.setUpdatesEnabled(True)
        table.viewport().update()
        _map_profile_log(
            "table_sort",
            rows=table.rowCount(),
            mode=self.mapsGametypeSort,
            total=(time.perf_counter() - _sort_t0) * 1000.0,
        )
        self._schedule_map_thumbnail_load()

    def cycle_maps_location_filter(self):
        modes = ("All", "Preinstalled", "Downloaded")
        try:
            index = modes.index(self.mapsLocationFilter)
        except ValueError:
            index = 0
        self.mapsLocationFilter = modes[(index + 1) % len(modes)]
        self.mapsLocationButton.setText(self.mapsLocationFilter.upper())
        self.mapsLocationButton.setProperty("active", self.mapsLocationFilter != "All")
        self.mapsLocationButton.style().unpolish(self.mapsLocationButton)
        self.mapsLocationButton.style().polish(self.mapsLocationButton)
        self._save_launcher_preference("maps_location_filter", self.mapsLocationFilter)
        # Instant filter: do not rebuild rows or reload levelshots.
        self._filter_maps_table(self.mapsSearch.text())

    def _on_local_map_clicked(self, index):
        """Normalize mouse selection to a whole-row selection at column zero."""
        if not index.isValid():
            return
        row = index.row()
        try:
            self.mapsTable.selectRow(row)
            self.mapsTable.setCurrentCell(row, 0)
            delegate = self.mapsTable.itemDelegate()
            if isinstance(delegate, MapRowHoverDelegate):
                delegate.set_selected_row(row)
        except RuntimeError:
            pass

    def _selected_map_data(self):
        row = self.mapsTable.currentRow()
        if row < 0:
            return None
        item = self.mapsTable.item(row, 0)
        data = item.data(QtCore.Qt.ItemDataRole.UserRole) if item else None
        return data if isinstance(data, dict) else None

    def _step_map(self, direction):
        if not hasattr(self, "mapsTable") or self.mapsTable.rowCount() <= 0:
            return
        visible = [row for row in range(self.mapsTable.rowCount()) if not self.mapsTable.isRowHidden(row)]
        if not visible:
            return
        current = self.mapsTable.currentRow()
        try:
            pos = visible.index(current)
            pos = (pos + int(direction)) % len(visible)
        except ValueError:
            pos = 0 if direction >= 0 else len(visible) - 1
        row = visible[pos]
        self.mapsTable.selectRow(row)
        self.mapsTable.scrollToItem(
            self.mapsTable.item(row, 1),
            QtWidgets.QAbstractItemView.ScrollHint.PositionAtCenter,
        )

    @staticmethod
    def _map_pak_is_protected(pak_path):
        return Path(pak_path).name.casefold() in PROTECTED_MAP_PAKS

    def delete_selected_map_pak(self):
        data = self._selected_map_data()
        if data:
            self.delete_map_pak(Path(str(data.get("pak_path", "") or "")))

    def delete_map_pak(self, pak):
        pak = Path(pak)
        if not pak.is_file():
            return
        if self._map_pak_is_protected(pak):
            self.mapsStatus.setText(f"Protected: {pak.name}")
            return

        try:
            pak.unlink()
        except OSError as error:
            self.qerror(f"Could not delete map PAK:\n{error}")
            return

        # Del is intentionally immediate. Persistent AppData levelshots stay cached.
        self.mapsStatus.setText(f"Deleted {pak.name}")
        self.refresh_maps(force=False)

    def play_selected_map(self):
        data = self._selected_map_data()
        if data:
            self.play_local_map(data.get("map", ""))

    def open_selected_map_location(self):
        data = self._selected_map_data()
        if not data:
            return
        pak = Path(str(data.get("pak_path", "") or ""))
        if not pak.is_file():
            return
        try:
            if sys.platform.startswith("win"):
                subprocess.Popen(["explorer.exe", "/select,", str(pak)])
            else:
                QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(str(pak.parent)))
        except Exception:
            QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(str(pak.parent)))

    def play_local_map(self, bsp_name, *, play_action_sound=True):
        bsp_name = str(bsp_name or "").strip()
        if not bsp_name:
            return
        if not q3elite_is_installed():
            self.qerror("Install Quake 3 Elite before launching a map.")
            return
        launcher_bat = GAME_ROOT / "Q3Elite" / "Engines" / "Q3Elite (Vulkan) - Cinematic.bat"
        if not launcher_bat.is_file():
            self.qerror(f"Q3Elite Vulkan launcher was not found:\n{launcher_bat}")
            return
        if play_action_sound:
            self._play_launcher_sound("start_button")
        try:
            import subprocess
            ignored_pids = {pid for pid, _name in self._running_xq3e_processes()}
            subprocess.Popen(
                [str(launcher_bat), "+devmap", bsp_name],
                cwd=str(launcher_bat.parent),
                shell=True,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
            self.mapsStatus.setText(f"Launching {bsp_name}…")
            self._track_launched_game_and_apply_behavior("play_map", ignored_pids)
        except Exception as error:
            self.qerror(f"Could not launch map:\n{error}")

    def _detach_server_query_for_rebuild(self):
        worker = getattr(self, "serverQueryWorker", None)
        if worker is None or not worker.isRunning():
            return
        # The UDP worker has no cancellation primitive. Disconnect its old
        # index-based results before replacing the cards, then let it finish
        # harmlessly while a fresh query starts for the rebuilt list.
        for signal in (worker.serverReady, worker.batchFinished):
            try:
                signal.disconnect()
            except (TypeError, RuntimeError):
                pass
        self.serverQueryWorker = None
        if hasattr(self, "refreshServersButton"):
            self.refreshServersButton.setEnabled(True)

    def open_server_preset_dialog(self):
        if not SERVER_ROUTE_PRESETS:
            self.qerror(f"Server preset file could not be loaded:\n{SERVER_PRESETS_FILE}")
            return
        selected_ids = launcher_settings.get("server_preset_ids", SERVER_DEFAULT_PRESET_IDS)
        if not isinstance(selected_ids, list):
            selected_ids = list(SERVER_DEFAULT_PRESET_IDS)
        dialog = ServerPresetDialog(
            self,
            en_enabled=launcher_settings.get("server_region_en", True),
            ru_enabled=launcher_settings.get("server_region_ru", False),
            selected_ids=selected_ids,
        )
        if dialog.exec() != QtWidgets.QDialog.DialogCode.Accepted:
            return
        en_enabled, ru_enabled, selected_ids = dialog.values()
        self.apply_server_region_preset(en_enabled, ru_enabled, selected_ids)

    def apply_server_region_preset(self, en_enabled, ru_enabled, selected_ids):
        global launcher_settings
        en_enabled = bool(en_enabled)
        ru_enabled = bool(ru_enabled)
        selected_ids = [str(x or "").strip().lower() for x in (selected_ids or [])]
        if not (en_enabled or ru_enabled):
            self.qerror("Select EU / INTERNATIONAL, RU, or both.")
            return
        if not SERVER_ROUTE_PRESETS:
            self.qerror(f"Server preset file could not be loaded:\n{SERVER_PRESETS_FILE}")
            return

        self._detach_server_query_for_rebuild()
        current = server_monitor.load_servers(self.serverConfigPath)
        custom = [
            dict(item) for item in current
            if str(item.get("address") or "").strip().lower() not in SERVER_ROUTE_ADDRESSES
        ]
        managed = _server_route_entries(en_enabled, ru_enabled, selected_ids)
        server_monitor.save_custom_servers(self.serverConfigPath, managed + custom)

        launcher_settings["server_region_en"] = en_enabled
        launcher_settings["server_region_ru"] = ru_enabled
        launcher_settings["server_region_initialized"] = True
        launcher_settings["server_preset_ids"] = list(selected_ids)
        save_launcher_settings(launcher_settings)
        self._reload_server_cards()
        route_name = "EU + RU" if (en_enabled and ru_enabled) else ("EU" if en_enabled else "RU")
        self.serverRefreshLabel.setText(
            f"{route_name} preset • {len(managed)} official route(s) + {len(custom)} custom."
        )
        QtCore.QTimer.singleShot(0, self.refresh_servers)

