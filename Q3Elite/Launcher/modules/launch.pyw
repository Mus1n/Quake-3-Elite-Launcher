        self.dialog = dialog

    def eventFilter(self, obj, event):
        if event.type() == QtCore.QEvent.Type.Wheel and self.dialog.isVisible():
            delta = event.angleDelta().y() or event.angleDelta().x()
            if delta:
                self.dialog.step(1 if delta < 0 else -1)
                event.accept()
                return True
        return False



